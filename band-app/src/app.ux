<script>
/**
 * XEMS on the wrist. One link to the XEMS tablet app (system.interconnect), shared by the
 * page through the app object: live state in, commands out.
 *
 * Messages are JSON (both directions):
 *   band → XEMS  {t:'hello', v:APP_VERSION} on start (repeated until XEMS answers),
 *                {t:'cmd', a:'toggle'|'plus'|'minus'|'double'|'stop'}
 *   XEMS → band  {t:'state', v:2, mode:'ai'|'manual'|'music'|'idle', st:'run'|'pause'|'rest'|'ready'|'idle',
 *                 hr, z, lim, title, sub, kcal, run, can:{plus,minus,dbl}, dbl, vib:'short'|'long'|'',
 *                 ph, pi, pd, pl, rl, pds[], pns[], u, el, tot, pos, dur, hh[30], avg, max, zt[5]}
 *   Times are seconds; the band counts them down itself between messages (rx = arrival time).
 */
import interconnect from '@system.interconnect'
import vibrator from '@system.vibrator'
import brightness from '@system.brightness'
import router from '@system.router'

/** = versionCode in manifest.json; XEMS skips reinstalling when this is current. */
const APP_VERSION = 7

export default {
  state: null,
  rx: 0,
  listeners: [],
  conn: null,
  helloTimer: null,
  /** Shown on the connecting screen: what the band's link to the phone does. */
  diag: { link: '?', sent: 0, failed: 0, err: '', rxAny: 0 },

  onCreate() {
    this.open()
    // One clock for the whole app: 3-2-1 buzz before a phase / interval ends, screen kept on
    // while something runs.
    this.beat = setInterval(() => this.tick(), 1000)
    // Until XEMS answers, say hello every 4 s (the link may open after the app).
    this.helloTimer = setInterval(() => {
      if (this.silence() > 12) {
        this.probe()
        this.hello()
        this.notify()
      }
    }, 4000)
  },

  onDestroy() {
    this.listeners = []
    clearInterval(this.helloTimer)
    clearInterval(this.beat)
    this.keepOn(false)
  },

  open() {
    try {
      const conn = interconnect.instance()
      this.conn = conn
      conn.onmessage = (msg) => {
        this.diag.rxAny++
        this.receive(msg && msg.data)
      }
      conn.onopen = () => {
        this.diag.link = 'отворена'
        this.hello()
        this.notify()
      }
      conn.onclose = (d) => {
        this.diag.link = 'затворена' + (d && d.code != null ? ' ' + d.code : '')
        this.notify()
      }
      conn.onerror = (d) => {
        this.diag.err = 'onerror ' + (d && d.code != null ? d.code : '') + (d && d.data ? ' ' + d.data : '')
        this.notify()
      }
      this.probe()
      this.hello()
    } catch (e) {
      this.diag.err = 'instance: ' + e
      console.log('xems: interconnect ' + e)
    }
  },

  /** Ask the system whether the link to the phone app is open (1 open, 2 closed). */
  probe() {
    try {
      if (this.conn && this.conn.getReadyState) {
        this.conn.getReadyState({
          success: (d) => {
            const st = d && d.status
            this.diag.link = st === 1 ? 'отворена' : st === 2 ? 'затворена' : 'статус ' + st
          },
          fail: (d, code) => {
            this.diag.link = 'грешка ' + code
          }
        })
      }
    } catch (e) {
      this.diag.link = 'няма getReadyState'
    }
  },

  receive(data) {
    let m = data && data.data !== undefined && data.t === undefined ? data.data : data
    try {
      if (typeof m === 'string') {
        m = JSON.parse(m)
      }
    } catch (e) {
      return
    }
    if (!m || m.t !== 'state') {
      return
    }
    this.state = m
    this.rx = Date.now()
    this.checkSummary(m)
    if (m.vib) {
      this.buzz(m.vib)
    }
    this.notify()
  },

  lastLeft: {},
  screenOn: false,

  tick() {
    const s = this.state
    if (!s || this.silence() > 12) {
      this.keepOn(false)
      return
    }
    const age = this.silence()
    const m = s.mods || {}
    const tm = m.tm || {}
    const mu = m.mu || {}
    if (s.mode === 'ai' && s.st === 'run') {
      this.countdown('ai', (s.pl || 0) - age)
    }
    if (tm.run) {
      this.countdown('tm', (tm.left || 0) - age)
    }
    const running = !!(s.run || tm.run || mu.play || (m.tr || {}).run)
    this.keepOn(running)
    this.zoneBuzz(running ? s.z || 0 : 0)
  },

  lastZone: 0,

  /** Entering Z4: one buzz, Z5: two — the wearer feels the zone without looking. */
  zoneBuzz(z) {
    if (z > this.lastZone && z >= 4) {
      this.buzz('short')
      if (z >= 5) {
        setTimeout(() => this.buzz('short'), 350)
      }
    }
    this.lastZone = z
  },

  summary: null,
  lastSum: -1,

  /** XEMS reports a finished session (kept for 90 s): open its summary once. */
  checkSummary(m) {
    const sum = m.sum
    if (!sum || sum.n === this.lastSum) {
      return
    }
    this.lastSum = sum.n
    this.summary = sum
    this.buzz('long')
    try {
      router.push({ uri: '/pages/summary' })
    } catch (e) {}
  },

  /** Short buzz at 3, 2, 1 s left; long at the end. Once per second per source. */
  countdown(key, left) {
    const n = Math.ceil(left)
    if (n === this.lastLeft[key]) {
      return
    }
    this.lastLeft[key] = n
    if (n >= 1 && n <= 3) {
      this.buzz('short')
    } else if (n === 0) {
      this.buzz('long')
    }
  },

  keepOn(on) {
    if (on === this.screenOn) {
      return
    }
    this.screenOn = on
    try {
      brightness.setKeepScreenOn({ keepScreenOn: on })
    } catch (e) {}
  },

  hello() {
    this.send({ t: 'hello', v: APP_VERSION })
  },

  send(obj) {
    if (!this.conn) {
      this.diag.err = 'няма връзка (instance)'
      return
    }
    try {
      this.conn.send({
        data: obj,                              // the system wants an object (202 'invalid data' for a string)
        success: () => {
          this.diag.sent++
        },
        fail: (d, code) => {
          this.diag.failed++
          this.diag.err = 'send ' + code + (d ? ' ' + JSON.stringify(d).slice(0, 40) : '')
        }
      })
    } catch (e) {
      this.diag.failed++
      this.diag.err = 'send: ' + e
    }
  },

  command(a) {
    this.send({ t: 'cmd', a: a })
    this.buzz('short')
  },

  buzz(kind) {
    try {
      vibrator.vibrate({ mode: kind === 'long' ? 'long' : 'short' })
    } catch (e) {}
  },

  /** Seconds since XEMS last spoke (large when never). */
  silence() {
    return this.rx ? (Date.now() - this.rx) / 1000 : 9999
  },

  watch(fn) {
    this.listeners.push(fn)
  },

  unwatch(fn) {
    this.listeners = this.listeners.filter((f) => f !== fn)
  },

  notify() {
    this.listeners.forEach((f) => {
      try {
        f(this.state)
      } catch (e) {}
    })
  }
}
</script>
