<template>
  <stack class="root" onswipe="onSwipe">
    <div class="screen {{anim}}" if="{{cur === 'live'}}">
      <div class="ambient" style="background: linear-gradient(180deg, rgba(255,59,92,0.22) 0%, rgba(0,0,0,0) 100%)"></div>
      <div class="ambient-fade"></div>
      <text class="chip-outline" style="color: {{stateColor}}; border-color: {{stateColor}}">{{stateText}}</text>
      <stack class="ring-box ring-live">
        <div class="ring-glow breathe" style="width: 196px; height: 196px; background-color: {{zoneColor}}"></div>
        <progress class="ring-outer ring-track" type="arc" percent="{{ringPct}}" style="color: #FF3B5C"></progress>
        <progress class="ring-inner ring-track" type="arc" percent="{{hrPct}}" style="color: {{zoneColor}}"></progress>
        <div class="ring-center">
          <text class="hr">{{hrText}}</text>
          <text class="chip" style="background-color: {{zoneColor}}">{{zoneText}}</text>
        </div>
      </stack>
      <text class="big-time" style="color: {{timeColor}}">{{bigTime}}</text>
      <text class="sub">{{bigLabel}}</text>
      <stack class="play-wrap play-box">
        <div class="glow {{st === 'ready' ? 'breathe' : ''}}" style="width: 118px; height: 118px; background-color: {{playGlow}}"></div>
        <div class="btn play btn-primary {{pressed === 'play' ? 'down' : ''}}" style="width: 108px; height: 108px; border-radius: 54px; background: linear-gradient(180deg, {{playTop}} 0%, {{playBot}} 100%)"
             ontouchstart="press('play')" ontouchend="release" ontouchcancel="release" onclick="toggle">
          <div class="btn-shine"></div>
          <image class="play-img" src="{{playIcon}}"></image>
        </div>
      </stack>
    </div>

    <div class="screen {{anim}}" if="{{cur === 'power'}}">
      <text class="caps">СИЛА</text>
      <text class="lvl-num" style="color: {{lvlColor}}">{{lvlText}}<text class="lvl-pct">%</text></text>
      <text class="sub">от плана</text>
      <div class="btn btn-pill btn-pill-accent plus {{canPlus ? '' : 'off'}} {{pressed === 'plus' ? 'down' : ''}}"
           style="margin-top: 22px; background: linear-gradient(180deg, #4a1a26 0%, #2c1218 100%)"
           ontouchstart="press('plus')" ontouchend="release" ontouchcancel="release" onclick="plus">
        <image class="pill-img" src="/common/icons/plus.png"></image>
      </div>
      <div class="btn btn-pill {{canMinus ? '' : 'off'}} {{pressed === 'minus' ? 'down' : ''}}"
           ontouchstart="press('minus')" ontouchend="release" ontouchcancel="release" onclick="minus">
        <image class="pill-img" src="/common/icons/minus.png"></image>
      </div>
    </div>

    <div class="screen {{anim}}" if="{{cur === 'dbl'}}">
      <text class="caps">ДВОЕН ИМПУЛС</text>
      <div class="btn btn-toggle {{pressed === 'dbl' ? 'down' : ''}}"
           style="margin-top: 36px; background: linear-gradient(180deg, {{dbl ? '#30D158' : '#2C2C2E'}} 0%, {{dbl ? '#1F9A42' : '#1C1C1E'}} 100%)"
           ontouchstart="press('dbl')" ontouchend="release" ontouchcancel="release" onclick="double">
        <div class="btn-shine"></div>
        <text class="toggle-text">{{dbl ? 'ВКЛ' : 'ИЗКЛ'}}</text>
      </div>
      <text class="sub">активна пауза между импулсите</text>
    </div>

    <div class="screen {{anim}}" if="{{cur === 'stop'}}">
      <text class="caps">КРАЙ НА СЕСИЯТА</text>
      <stack class="stop-box stop-wrap" ontouchstart="holdStart" ontouchend="holdEnd" ontouchcancel="holdEnd">
        <progress class="stop-ring" type="arc" percent="{{holdPct}}" style="color: #FF453A; width: 188px; height: 188px; center-x: 94px; center-y: 94px; radius: 84px"></progress>
        <div class="stop-core" style="width: 136px; height: 136px; border-radius: 68px; background: linear-gradient(180deg, #ff453a 0%, #c62828 100%)">
          <image class="stop-img" src="/common/icons/stop.png"></image>
        </div>
      </stack>
      <text class="sub">{{holdPct > 0 ? 'дръж…' : 'задръж 1 секунда'}}</text>
    </div>

    <div class="screen {{anim}}" if="{{cur === 'stats'}}">
      <text class="caps">СЕСИЯ</text>
      <text class="elapsed">{{elapsedText}}</text>
      <div class="tiles">
        <div class="tile">
          <text class="tile-num kcal">{{kcal}}</text>
          <text class="tile-label">kcal</text>
        </div>
        <div class="tile">
          <text class="tile-num">{{phaseCount}}</text>
          <text class="tile-label">фаза</text>
        </div>
      </div>
      <div class="tiles">
        <div class="tile">
          <text class="tile-num">{{avgText}}</text>
          <text class="tile-label">средно</text>
        </div>
        <div class="tile">
          <text class="tile-num stat-max">{{maxText}}</text>
          <text class="tile-label">връх</text>
        </div>
      </div>
      <div class="zstack">
        <div for="{{zoneTime}}" class="zpart" style="flex: {{$item.w}}; background-color: {{$item.c}}"></div>
      </div>
    </div>

    <div class="dots">
      <div for="{{dots}}" class="pdot {{$item.on ? 'pdot-on' : ''}}" style="background-color: {{$item.on ? dotAccent : '#3A3A3C'}}"></div>
    </div>
  </stack>
</template>

<script>
import { ZONE, ACCENT, GREEN, AMBER, BLUE, mmss, hms, zoneOf, bind, setPages, swipe } from '../../common/ui.js'

const HOLD_MS = 1200

export default {
  private: {
    ids: [],
    idsKey: '',
    idx: 0,
    cur: 'live',
    dots: [],
    dotAccent: ACCENT,
    anim: '',
    st: 'idle',
    stateText: '',
    stateColor: '#8E8E93',
    ringPct: 0,
    hrPct: 0,
    hrText: '--',
    zoneText: '',
    zoneColor: ZONE[0],
    bigTime: '--:--',
    bigLabel: '',
    timeColor: '#FFFFFF',
    playIcon: '/common/icons/play.png',
    playTop: GREEN,
    playBot: '#1F9A42',
    playGlow: 'rgba(0,0,0,0)',
    pressed: '',
    lvlText: '100',
    lvlColor: '#FFFFFF',
    canPlus: false,
    canMinus: false,
    dbl: false,
    holdPct: 0,
    elapsedText: '0:00',
    kcal: '--',
    phaseCount: '--',
    avgText: '--',
    maxText: '--',
    zoneTime: []
  },

  onInit() {
    this.unbind = bind(this)
  },

  onDestroy() {
    this.unbind()
    this.holdEnd()
  },

  onSwipe(e) {
    swipe(this, e)
  },

  update() {
    const app = this.$app.$def
    const s = app.state
    if (!s) {
      setPages(this, ['live'], ACCENT)
      return
    }
    const quiet = app.silence()
    const ai = s.mode === 'ai'
    const can = s.can || {}
    const ids = ai ? ['live', 'power'] : ['live']
    if (ai && can.dbl) {
      ids.push('dbl')
    }
    if (ai) {
      ids.push('stop', 'stats')
    }
    setPages(this, ids, ACCENT)

    this.st = ai ? s.st : 'idle'
    const runAge = this.st === 'run' ? quiet : 0
    const lim = s.lim || 170
    const z = s.hr > 0 ? s.z || zoneOf(s.hr, lim) : 0
    this.hrText = s.hr > 0 ? String(s.hr) : '--'
    this.zoneText = s.hr > 0 ? 'Z' + z : 'bpm'
    this.zoneColor = ZONE[z]
    this.hrPct = s.hr > 0 ? Math.min(100, Math.round((s.hr / lim) * 100)) : 0

    const labels = { run: 'ТЕЧЕ', pause: 'ПАУЗА', rest: 'ПОЧИВКА', ready: 'ГОТОВО', idle: 'НЕ ТЕЧЕ' }
    const colors = { run: GREEN, pause: AMBER, rest: BLUE, ready: GREEN, idle: '#8E8E93' }
    this.stateText = 'AI · ' + (labels[this.st] || 'AI')
    this.stateColor = colors[this.st] || '#8E8E93'

    this.timeColor = '#FFFFFF'
    if (!ai) {
      this.bigTime = '--:--'
      this.bigLabel = 'стартирай на таблета'
      this.ringPct = 0
    } else if (this.st === 'ready') {
      this.bigTime = 'ГОТОВО'
      this.bigLabel = 'почивката стига'
      this.timeColor = GREEN
      this.ringPct = 100
    } else {
      if (this.st === 'rest') {
        this.bigTime = mmss((s.rl || 0) - quiet)
        this.bigLabel = 'почивка'
        this.timeColor = BLUE
      } else {
        this.bigTime = mmss((s.pl || 0) - runAge)
        this.bigLabel = s.ph || 'фаза'
      }
      const pd = s.pd || 1
      this.ringPct = Math.min(100, Math.max(0, Math.round((1 - ((s.pl || 0) - runAge) / pd) * 100)))
    }
    if (this.st === 'run') {
      this.playIcon = '/common/icons/pause.png'
      this.playTop = '#2C2C2E'
      this.playBot = '#1C1C1E'
      this.playGlow = 'rgba(0,0,0,0)'
    } else {
      this.playIcon = '/common/icons/play.png'
      this.playTop = GREEN
      this.playBot = '#1F9A42'
      this.playGlow = this.st === 'ready' ? 'rgba(48,209,88,0.45)' : 'rgba(48,209,88,0.2)'
    }

    this.canPlus = ai && !!can.plus
    this.canMinus = ai && !!can.minus
    this.dbl = !!s.dbl
    const u = s.u != null ? s.u : 100
    this.lvlText = String(u)
    this.lvlColor = u >= 100 ? '#FFFFFF' : AMBER

    this.elapsedText = hms((s.el || 0) + runAge)
    this.kcal = s.kcal > 0 ? String(Math.round(s.kcal)) : '--'
    this.phaseCount = ai && s.pds ? (s.pi + 1) + '/' + s.pds.length : '--'
    this.avgText = s.avg > 0 ? String(s.avg) : '--'
    this.maxText = s.max > 0 ? String(s.max) : '--'
    const zt = s.zt || [0, 0, 0, 0, 0]
    const total = zt.reduce((a, b) => a + b, 0)
    this.zoneTime = zt.map((v, i) => ({ w: total > 0 ? Math.max(v, 0.0001) : 1, c: ZONE[i + 1] }))
  },

  press(w) { this.pressed = w },
  release() { this.pressed = '' },
  toggle() { this.$app.$def.command('toggle') },
  plus() { if (this.canPlus) { this.$app.$def.command('plus') } },
  minus() { if (this.canMinus) { this.$app.$def.command('minus') } },
  double() { this.dbl = !this.dbl; this.$app.$def.command('double') },

  holdStart() {
    this.holdEnd()
    const t0 = Date.now()
    this.holdTimer = setInterval(() => {
      const p = Math.min(100, Math.round(((Date.now() - t0) / HOLD_MS) * 100))
      this.holdPct = p
      if (p >= 100) {
        clearInterval(this.holdTimer)
        this.holdTimer = null
        this.$app.$def.send({ t: 'cmd', a: 'stop' })
        this.$app.$def.buzz('long')
        setTimeout(() => { this.holdPct = 0 }, 400)
      }
    }, 40)
  },

  holdEnd() {
    if (this.holdTimer) {
      clearInterval(this.holdTimer)
      this.holdTimer = null
      this.holdPct = 0
    }
  }
}
</script>

<style>
/* ---- common (scripts/gen-pages.py stamps this into every page) ---- */
/* XEMS Band v4 — shared design system (212 × 520 AMOLED) */
.root {
  width: 212px;
  height: 520px;
  background-color: #000000;
}
.screen {
  width: 212px;
  height: 520px;
  flex-direction: column;
  align-items: center;
  padding-top: 32px;
  background-color: #000000;
}
.ambient {
  width: 212px;
  height: 260px;
  position: absolute;
  top: 0px;
  left: 0px;
  opacity: 0.55;
}
.ambient-fade {
  width: 212px;
  height: 520px;
  position: absolute;
  top: 0px;
  left: 0px;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0) 0%, #000000 72%);
}
.in-up {
  animation-name: inUp;
  animation-duration: 280ms;
  animation-timing-function: ease-out;
}
.in-down {
  animation-name: inDown;
  animation-duration: 280ms;
  animation-timing-function: ease-out;
}
.in-fade {
  animation-name: fadeIn;
  animation-duration: 220ms;
  animation-timing-function: ease-out;
}
.dots {
  width: 16px;
  height: 520px;
  margin-left: 196px;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}
.pdot {
  width: 6px;
  height: 6px;
  margin-top: 5px;
  margin-bottom: 5px;
  border-radius: 3px;
  background-color: #3a3a3c;
}
.pdot-on {
  width: 8px;
  height: 24px;
  border-radius: 4px;
  background-color: #ffffff;
}
.caps {
  font-size: 20px;
  font-weight: bold;
  color: #636366;
  letter-spacing: 1px;
}
.sub {
  width: 196px;
  text-align: center;
  font-size: 22px;
  color: #aeaeb2;
  lines: 2;
  text-overflow: ellipsis;
}
.chip {
  height: 28px;
  padding-left: 12px;
  padding-right: 12px;
  border-radius: 14px;
  font-size: 18px;
  font-weight: bold;
  color: #000000;
}
.chip-outline {
  height: 28px;
  padding-left: 10px;
  padding-right: 10px;
  border-radius: 14px;
  border-width: 2px;
  font-size: 18px;
  font-weight: bold;
}
.down {
  transform: scale(0.92);
}
.btn {
  justify-content: center;
  align-items: center;
  transition-property: transform;
  transition-duration: 120ms;
}
.off {
  opacity: 0.28;
}
.surface {
  background-color: #1c1c1e;
  border-radius: 24px;
  border-width: 1px;
  border-color: #2c2c2e;
}
.surface-elevated {
  background-color: #2c2c2e;
  border-radius: 24px;
  border-width: 1px;
  border-color: #3a3a3c;
}
.glow {
  position: absolute;
  border-radius: 999px;
  opacity: 0.38;
}
.breathe {
  animation-name: breathe;
  animation-duration: 1500ms;
  animation-iteration-count: infinite;
  animation-direction: alternate;
  animation-timing-function: ease-in-out;
}
.btn-ring {
  position: absolute;
  border-radius: 999px;
  border-width: 2px;
  border-color: rgba(255, 255, 255, 0.12);
}
.btn-shine {
  position: absolute;
  width: 60%;
  height: 28%;
  top: 8%;
  border-radius: 999px;
  background-color: rgba(255, 255, 255, 0.14);
}
.btn-primary {
  border-width: 2px;
  border-color: rgba(255, 255, 255, 0.1);
}
.btn-surface {
  background-color: #2c2c2e;
  border-width: 2px;
  border-color: #3a3a3c;
}
.btn-pill {
  width: 180px;
  height: 108px;
  border-radius: 54px;
  background-color: #2c2c2e;
  border-width: 2px;
  border-color: #3a3a3c;
}
.btn-pill-accent {
  border-color: rgba(255, 255, 255, 0.08);
}
.pill-img {
  width: 52px;
  height: 52px;
}
.btn-toggle {
  width: 168px;
  height: 168px;
  border-radius: 84px;
  border-width: 3px;
  border-color: rgba(255, 255, 255, 0.12);
}
.toggle-text {
  font-size: 38px;
  font-weight: bold;
  color: #ffffff;
  letter-spacing: 2px;
}
.play-wrap {
  justify-content: center;
  align-items: center;
}
.play {
  border-width: 2px;
  border-color: rgba(255, 255, 255, 0.1);
}
.play-img {
  width: 54px;
  height: 54px;
}
.ring-box {
  justify-content: center;
  align-items: center;
}
.ring-track {
  background-color: #141416;
  border-width: 1px;
  border-color: #1c1c1e;
}
.ring-glow {
  position: absolute;
  border-radius: 999px;
  opacity: 0.22;
}
.tile {
  width: 94px;
  height: 88px;
  margin-left: 4px;
  margin-right: 4px;
  border-radius: 22px;
  background-color: #1c1c1e;
  border-width: 1px;
  border-color: #2c2c2e;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}
.tile-num {
  font-size: 34px;
  font-weight: bold;
  color: #ffffff;
}
.tile-label {
  font-size: 20px;
  color: #8e8e93;
}
.tiles {
  flex-direction: row;
  margin-top: 10px;
}
.stat {
  width: 94px;
  height: 92px;
  margin-left: 4px;
  margin-right: 4px;
  border-radius: 22px;
  background-color: #1c1c1e;
  border-width: 1px;
  border-color: #2c2c2e;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}
.stat-num {
  font-size: 36px;
  font-weight: bold;
  color: #ffffff;
}
.stat-label {
  font-size: 20px;
  color: #8e8e93;
}
.stat-max {
  color: #ff453a;
}
.kcal {
  color: #ff9f0a;
}
.zstack {
  width: 192px;
  height: 16px;
  margin-top: 18px;
  border-radius: 8px;
  flex-direction: row;
  background-color: #141416;
  border-width: 1px;
  border-color: #1c1c1e;
}
.zpart {
  height: 16px;
}
.stop-box {
  justify-content: center;
  align-items: center;
}
.stop-ring {
  stroke-width: 12px;
  background-color: #1a0808;
  start-angle: 0deg;
  total-angle: 360deg;
}
.stop-core {
  border-width: 3px;
  border-color: rgba(255, 255, 255, 0.15);
  justify-content: center;
  align-items: center;
}
.stop-img {
  width: 58px;
  height: 58px;
}
.pair {
  flex-direction: row;
}
@keyframes inUp {
  from {
    transform: translateY(72px);
    opacity: 0;
  }
  to {
    transform: translateY(0px);
    opacity: 1;
  }
}
@keyframes inDown {
  from {
    transform: translateY(-72px);
    opacity: 0;
  }
  to {
    transform: translateY(0px);
    opacity: 1;
  }
}
@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}
@keyframes breathe {
  from {
    transform: scale(0.88);
    opacity: 0.55;
  }
  to {
    transform: scale(1.14);
    opacity: 0.12;
  }
}
@keyframes beat {
  from {
    transform: scale(1);
  }
  to {
    transform: scale(1.22);
  }
}
@keyframes wave {
  from {
    transform: scale(0.55);
    opacity: 0.85;
  }
  to {
    transform: scale(1.08);
    opacity: 0;
  }
}
@keyframes spin {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}
/* ---- page ---- */
