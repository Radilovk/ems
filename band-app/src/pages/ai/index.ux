<template>
  <stack class="root bg-ai" onswipe="onSwipe">
    <!-- 1 · live -->
    <div class="screen {{anim}}" if="{{cur === 'live'}}">
      <text class="caps" style="color: {{stateColor}}">{{stateText}}</text>
      <stack class="ring-box">
        <progress class="ring-outer" type="arc" percent="{{ringPct}}" style="color: #5E5CE6"></progress>
        <progress class="ring-inner" type="arc" percent="{{hrPct}}" style="color: {{zoneColor}}"></progress>
        <div class="ring-center">
          <text class="hr">{{hrText}}</text>
          <text class="zchip" style="background-color: {{zoneColor}}">{{zoneText}}</text>
        </div>
      </stack>
      <text class="big-time" style="color: {{timeColor}}">{{bigTime}}</text>
      <text class="sub">{{bigLabel}}</text>
      <stack class="play-box">
        <div class="glow {{st === 'ready' ? 'breathe' : ''}}" style="background-color: {{playGlow}}"></div>
        <div class="btn play {{pressed === 'play' ? 'down' : ''}}" style="background-color: {{playColor}}"
             ontouchstart="press('play')" ontouchend="release" ontouchcancel="release" onclick="toggle">
          <image class="play-img" src="{{playIcon}}"></image>
        </div>
      </stack>
    </div>

    <!-- 2 · strength -->
    <div class="screen {{anim}}" if="{{cur === 'power'}}">
      <text class="caps">СИЛА</text>
      <text class="lvl-num" style="color: {{lvlColor}}">{{lvlText}}%</text>
      <text class="sub">от плана</text>
      <div class="btn big-pill plus {{canPlus ? '' : 'off'}} {{pressed === 'plus' ? 'down' : ''}}"
           ontouchstart="press('plus')" ontouchend="release" ontouchcancel="release" onclick="plus">
        <image class="pill-img" src="/common/icons/plus.png"></image>
      </div>
      <div class="btn big-pill {{canMinus ? '' : 'off'}} {{pressed === 'minus' ? 'down' : ''}}"
           ontouchstart="press('minus')" ontouchend="release" ontouchcancel="release" onclick="minus">
        <image class="pill-img" src="/common/icons/minus.png"></image>
      </div>
    </div>

    <!-- 3 · double impulse (only when AI allows it) -->
    <div class="screen {{anim}}" if="{{cur === 'dbl'}}">
      <text class="caps">ДВОЕН ИМПУЛС</text>
      <div class="btn toggle {{pressed === 'dbl' ? 'down' : ''}}" style="background-color: {{dbl ? '#30D158' : '#2C2C2E'}}"
           ontouchstart="press('dbl')" ontouchend="release" ontouchcancel="release" onclick="double">
        <text class="toggle-text">{{dbl ? 'ВКЛ' : 'ИЗКЛ'}}</text>
      </div>
      <text class="sub">активна пауза между импулсите</text>
    </div>

    <!-- 4 · stop (hold) -->
    <div class="screen {{anim}}" if="{{cur === 'stop'}}">
      <text class="caps">КРАЙ НА СЕСИЯТА</text>
      <stack class="stop-box" ontouchstart="holdStart" ontouchend="holdEnd" ontouchcancel="holdEnd">
        <progress class="stop-ring" type="arc" percent="{{holdPct}}" style="color: #FF453A"></progress>
        <div class="stop-core">
          <image class="stop-img" src="/common/icons/stop.png"></image>
        </div>
      </stack>
      <text class="sub">{{holdPct > 0 ? 'дръж…' : 'задръж 1 секунда'}}</text>
    </div>

    <!-- 5 · session -->
    <div class="screen {{anim}}" if="{{cur === 'stats'}}">
      <text class="caps">СЕСИЯ</text>
      <text class="elapsed">{{elapsedText}}</text>
      <div class="tiles">
        <div class="tile">
          <text class="tile-num kcal">{{kcal}}</text>
          <text class="tile-label">kcal</text>
        </div>
        <div class="tile">
          <text class="tile-num">{{phaseCount}}</text>
          <text class="tile-label">фаза</text>
        </div>
      </div>
      <div class="tiles">
        <div class="tile">
          <text class="tile-num">{{avgText}}</text>
          <text class="tile-label">средно</text>
        </div>
        <div class="tile">
          <text class="tile-num max">{{maxText}}</text>
          <text class="tile-label">връх</text>
        </div>
      </div>
      <div class="zstack">
        <div for="{{zoneTime}}" class="zpart" style="flex: {{$item.w}}; background-color: {{$item.c}}"></div>
      </div>
    </div>

    <div class="dots">
      <div for="{{dots}}" class="pdot {{$item.on ? 'pdot-on' : ''}}"></div>
    </div>
  </stack>
</template>

<script>
import { ZONE, GREEN, AMBER, BLUE, mmss, hms, zoneOf, bind, setPages, swipe } from '../../common/ui.js'

const HOLD_MS = 1200

export default {
  private: {
    ids: [],
    idsKey: '',
    idx: 0,
    cur: 'live',
    dots: [],
    anim: '',
    st: 'idle',
    stateText: '',
    stateColor: '#8E8E93',
    ringPct: 0,
    hrPct: 0,
    hrText: '--',
    zoneText: '',
    zoneColor: ZONE[0],
    bigTime: '--:--',
    bigLabel: '',
    timeColor: '#FFFFFF',
    playIcon: '/common/icons/play.png',
    playColor: GREEN,
    playGlow: 'rgba(0,0,0,0)',
    pressed: '',
    lvlText: '100',
    lvlColor: '#FFFFFF',
    canPlus: false,
    canMinus: false,
    dbl: false,
    holdPct: 0,
    elapsedText: '0:00',
    kcal: '--',
    phaseCount: '--',
    avgText: '--',
    maxText: '--',
    zoneTime: []
  },

  onInit() {
    this.unbind = bind(this)
  },

  onDestroy() {
    this.unbind()
    this.holdEnd()
  },

  onSwipe(e) {
    swipe(this, e)
  },

  update() {
    const app = this.$app.$def
    const s = app.state
    if (!s) {
      setPages(this, ['live'])
      return
    }
    const quiet = app.silence()
    const ai = s.mode === 'ai'
    const can = s.can || {}
    const ids = ai ? ['live', 'power'] : ['live']
    if (ai && can.dbl) {
      ids.push('dbl')
    }
    if (ai) {
      ids.push('stop', 'stats')
    }
    setPages(this, ids)

    this.st = ai ? s.st : 'idle'
    const age = this.st === 'run' ? quiet : 0
    const lim = s.lim || 170
    const z = s.hr > 0 ? s.z || zoneOf(s.hr, lim) : 0
    this.hrText = s.hr > 0 ? String(s.hr) : '--'
    this.zoneText = s.hr > 0 ? 'Z' + z : 'bpm'
    this.zoneColor = ZONE[z]
    this.hrPct = s.hr > 0 ? Math.min(100, Math.round((s.hr / lim) * 100)) : 0

    const labels = { run: 'AI · ТЕЧЕ', pause: 'AI · ПАУЗА', rest: 'AI · ПОЧИВКА', ready: 'AI · ГОТОВО', idle: 'AI · НЕ ТЕЧЕ' }
    const colors = { run: GREEN, pause: AMBER, rest: BLUE, ready: GREEN, idle: '#8E8E93' }
    this.stateText = labels[this.st] || 'AI'
    this.stateColor = colors[this.st] || '#8E8E93'

    this.timeColor = '#FFFFFF'
    if (!ai) {
      this.bigTime = '--:--'
      this.bigLabel = 'стартирай на таблета'
      this.ringPct = 0
    } else if (this.st === 'ready') {
      this.bigTime = 'ГОТОВО'
      this.bigLabel = 'почивката стига'
      this.timeColor = GREEN
      this.ringPct = 100
    } else {
      if (this.st === 'rest') {
        this.bigTime = mmss((s.rl || 0) - quiet)
        this.bigLabel = 'почивка'
        this.timeColor = BLUE
      } else {
        this.bigTime = mmss((s.pl || 0) - age)
        this.bigLabel = s.ph || 'фаза'
      }
      const pd = s.pd || 1
      this.ringPct = Math.min(100, Math.max(0, Math.round((1 - ((s.pl || 0) - age) / pd) * 100)))
    }
    if (this.st === 'run') {
      this.playIcon = '/common/icons/pause.png'
      this.playColor = '#2C2C2E'
      this.playGlow = 'rgba(0,0,0,0)'
    } else {
      this.playIcon = '/common/icons/play.png'
      this.playColor = GREEN
      this.playGlow = this.st === 'ready' ? 'rgba(48,209,88,0.45)' : 'rgba(48,209,88,0.2)'
    }

    this.canPlus = ai && !!can.plus
    this.canMinus = ai && !!can.minus
    this.dbl = !!s.dbl
    const u = s.u != null ? s.u : 100
    this.lvlText = String(u)
    this.lvlColor = u >= 100 ? '#FFFFFF' : AMBER

    this.elapsedText = hms((s.el || 0) + age)
    this.kcal = s.kcal > 0 ? String(Math.round(s.kcal)) : '--'
    this.phaseCount = ai && s.pds ? (s.pi + 1) + '/' + s.pds.length : '--'
    this.avgText = s.avg > 0 ? String(s.avg) : '--'
    this.maxText = s.max > 0 ? String(s.max) : '--'
    const zt = s.zt || [0, 0, 0, 0, 0]
    const total = zt.reduce((a, b) => a + b, 0)
    this.zoneTime = zt.map((v, i) => ({ w: total > 0 ? Math.max(v, 0.0001) : 1, c: ZONE[i + 1] }))
  },

  press(w) {
    this.pressed = w
  },

  release() {
    this.pressed = ''
  },

  toggle() {
    this.$app.$def.command('toggle')
  },

  plus() {
    if (this.canPlus) {
      this.$app.$def.command('plus')
    }
  },

  minus() {
    if (this.canMinus) {
      this.$app.$def.command('minus')
    }
  },

  double() {
    this.dbl = !this.dbl
    this.$app.$def.command('double')
  },

  holdStart() {
    this.holdEnd()
    const t0 = Date.now()
    this.holdTimer = setInterval(() => {
      const p = Math.min(100, Math.round(((Date.now() - t0) / HOLD_MS) * 100))
      this.holdPct = p
      if (p >= 100) {
        clearInterval(this.holdTimer)
        this.holdTimer = null
        this.$app.$def.command('stop', null, 'long')
        setTimeout(() => {
          this.holdPct = 0
        }, 400)
      }
    }, 40)
  },

  holdEnd() {
    if (this.holdTimer) {
      clearInterval(this.holdTimer)
      this.holdTimer = null
      this.holdPct = 0
    }
  }
}
</script>

<style>
/* ---- common (scripts/gen-pages.py stamps this into every page) ---- */
.root {
  width: 212px;
  height: 520px;
  background-color: #000000;
}
.screen {
  width: 212px;
  height: 520px;
  flex-direction: column;
  align-items: center;
  padding-top: 34px;
}
.scr {
  width: 212px;
  height: 520px;
}
.col {
  width: 212px;
  flex-direction: column;
}
.in-up {
  animation-name: inUp;
  animation-duration: 260ms;
  animation-timing-function: ease-out;
}
.in-down {
  animation-name: inDown;
  animation-duration: 260ms;
  animation-timing-function: ease-out;
}
.dots {
  width: 16px;
  height: 520px;
  margin-left: 196px;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}
.pdot {
  width: 8px;
  height: 8px;
  margin-top: 4px;
  margin-bottom: 4px;
  border-radius: 4px;
  background-color: #3a3a3c;
}
.pdot-on {
  height: 22px;
  background-color: #ffffff;
}
.caps {
  font-size: 24px;
  font-weight: bold;
  color: #8e8e93;
}
.sub {
  width: 196px;
  text-align: center;
  font-size: 24px;
  color: #aeaeb2;
}
.down {
  transform: scale(0.92);
}
.btn {
  justify-content: center;
  align-items: center;
  transition-property: transform;
  transition-duration: 120ms;
}
.off {
  opacity: 0.3;
}
@keyframes inUp {
  from {
    transform: translateY(90px);
    opacity: 0;
  }
  to {
    transform: translateY(0px);
    opacity: 1;
  }
}
@keyframes inDown {
  from {
    transform: translateY(-90px);
    opacity: 0;
  }
  to {
    transform: translateY(0px);
    opacity: 1;
  }
}
@keyframes breathe {
  from {
    transform: scale(0.86);
    opacity: 0.9;
  }
  to {
    transform: scale(1.12);
    opacity: 0.2;
  }
}
@keyframes beat {
  from {
    transform: scale(1);
  }
  to {
    transform: scale(1.25);
  }
}
/* ---- page ---- */
.bg-ai {
  background-image: url(/common/bg/ai.png);
  background-size: cover;
}
.ring-box {
  width: 196px;
  height: 196px;
  margin-top: 10px;
}
.ring-outer {
  width: 196px;
  height: 196px;
  stroke-width: 16px;
  background-color: #1c1c1e;
  start-angle: 220deg;
  total-angle: 280deg;
  center-x: 98px;
  center-y: 98px;
  radius: 90px;
}
.ring-inner {
  width: 196px;
  height: 196px;
  stroke-width: 6px;
  background-color: #151517;
  start-angle: 220deg;
  total-angle: 280deg;
  center-x: 98px;
  center-y: 98px;
  radius: 72px;
}
.ring-center {
  width: 196px;
  height: 196px;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}
.hr {
  font-size: 76px;
  font-weight: bold;
  color: #ffffff;
}
.zchip {
  height: 30px;
  padding-left: 12px;
  padding-right: 12px;
  border-radius: 15px;
  font-size: 22px;
  font-weight: bold;
  color: #000000;
}
.big-time {
  margin-top: 4px;
  font-size: 58px;
  font-weight: bold;
}
.play-box {
  width: 130px;
  height: 124px;
  margin-top: 4px;
  justify-content: center;
  align-items: center;
}
.glow {
  width: 124px;
  height: 124px;
  border-radius: 62px;
}
.breathe {
  animation-name: breathe;
  animation-duration: 1400ms;
  animation-iteration-count: infinite;
  animation-direction: alternate;
}
.play {
  width: 108px;
  height: 108px;
  border-radius: 54px;
}
.play-img {
  width: 50px;
  height: 50px;
}
.lvl-num {
  margin-top: 6px;
  font-size: 80px;
  font-weight: bold;
}
.big-pill {
  width: 180px;
  height: 110px;
  margin-top: 14px;
  border-radius: 55px;
  background-color: #2c2c2e;
}
.plus {
  background-color: #4a1a26;
  margin-top: 22px;
}
.pill-img {
  width: 52px;
  height: 52px;
}
.toggle {
  width: 170px;
  height: 170px;
  margin-top: 40px;
  border-radius: 85px;
}
.toggle-text {
  font-size: 40px;
  font-weight: bold;
  color: #ffffff;
}
.stop-box {
  width: 190px;
  height: 190px;
  margin-top: 40px;
  justify-content: center;
  align-items: center;
}
.stop-ring {
  width: 190px;
  height: 190px;
  stroke-width: 14px;
  background-color: #3a0f0d;
  start-angle: 0deg;
  total-angle: 360deg;
  center-x: 95px;
  center-y: 95px;
  radius: 86px;
}
.stop-core {
  width: 140px;
  height: 140px;
  border-radius: 70px;
  background-color: #c62828;
  justify-content: center;
  align-items: center;
}
.stop-img {
  width: 60px;
  height: 60px;
}
.elapsed {
  font-size: 62px;
  font-weight: bold;
  color: #ffffff;
}
.tiles {
  flex-direction: row;
  margin-top: 10px;
}
.tile {
  width: 94px;
  height: 90px;
  margin-left: 4px;
  margin-right: 4px;
  border-radius: 24px;
  background-color: #1c1c1e;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}
.tile-num {
  font-size: 34px;
  font-weight: bold;
  color: #ffffff;
}
.kcal {
  color: #ff9f0a;
}
.max {
  color: #ff453a;
}
.tile-label {
  font-size: 20px;
  color: #8e8e93;
}
.zstack {
  width: 192px;
  height: 18px;
  margin-top: 20px;
  border-radius: 9px;
  flex-direction: row;
  background-color: #1c1c1e;
}
.zpart {
  height: 18px;
}
</style>
