<template>
  <!-- home: one vertical scroll — heart rate, then a big card per module (Start first).
       Tap a card to open it; hold the heart rate to pause everything; swipe right = exit. -->
  <stack class="root bg-home">
    <scroll class="scr" scroll-y="true" if="{{!offline}}">
      <div class="col" style="height: {{colH}}px">
        <div class="hdr">
          <div class="hr-row">
            <image class="hr-heart" src="/common/art/heart-34.png"></image>
            <text class="hr-big" style="color: {{hrColor}}">{{hrBig}}</text>
          </div>
          <text class="hr-sub">{{hrSub}}</text>
          <div class="zones">
            <div for="{{zoneBar}}" class="zseg" style="background-color: {{$item.c}}; opacity: {{$item.on ? 1 : 0.22}}"></div>
          </div>
        </div>
        <div for="{{cards}}" class="card" style="background-color: {{$item.bg}}; border-color: {{$item.border}}" onclick="open($item.id)">
          <div class="ic ic-{{$item.id}}" style="background-color: {{$item.color}}"></div>
          <text class="ct">{{$item.title}}</text>
          <text class="cs" style="color: {{$item.subColor}}">{{$item.sub}}</text>
        </div>
      </div>
    </scroll>

    <!-- not linked yet -->
    <div class="offline" if="{{offline}}">
      <stack class="radar">
        <div class="wave"></div>
        <div class="wave wave2"></div>
        <div class="core"><text class="core-x">X</text></div>
      </stack>
      <text class="off-title">XEMS</text>
      <text class="off-sub">{{offText}}</text>
      <text class="sub off-hint">Отвори XEMS на таблета</text>
    </div>
  </stack>
</template>

<script>
import router from '@system.router'
import { ZONE, ACCENT, RED, GREEN, AMBER, PURPLE, mmss, hms, zoneOf, mods, bind, shown, age, putList } from '../../common/ui.js'

/** Card tint when a module runs (solid colours: Vela draws them best). */
const TINT = { train: '#0E2A17', ai: '#2E2607', timer: '#2E1F07', music: '#24122E', pulse: '#2E0F0D' }
const IDLE = '#16171B'
/** Card fields that change while the app runs (id, title, icon, colour stay). */
const CARD_FIELDS = ['sub', 'active', 'bg', 'border', 'subColor']
const PAGES = { ai: '/pages/ai', train: '/pages/train', timer: '/pages/timer', music: '/pages/music', pulse: '/pages/pulse' }

export default {
  private: {
    offline: true,
    offText: 'Свързване…',
    hrBig: '--',
    hrSub: '',
    hrColor: '#FFFFFF',
    zoneBar: [],
    busy: false,
    cards: [],
    cardsKey: '',
    colH: 900
  },

  onInit() {
    this.unbind = bind(this)
  },

  onShow() {
    shown(this, true)
  },

  onHide() {
    shown(this, false)
  },

  onDestroy() {
    this.unbind()
  },

  update() {
    const app = this.$app.$def
    const s = app.state
    const quiet = app.quiet()
    if (!s || quiet > 12) {
      this.offline = true
      this.offText = quiet > 9000 ? 'Свързване…' : 'Връзката прекъсна'
      return
    }
    this.offline = false
    this.busy = app.busy()
    const lim = s.lim || 170
    const z = s.hr > 0 ? s.z || zoneOf(s.hr, lim) : 0
    this.hrBig = s.hr > 0 ? String(s.hr) : '--'
    this.hrSub = s.hr > 0 ? 'Z' + z + ' · лимит ' + lim : 'няма пулс'
    this.hrColor = s.hr > 0 ? ZONE[z] : '#8E8E93'
    const bar = []
    for (let k = 1; k <= 5; k++) {
      bar.push({ c: ZONE[k], on: z >= k })
    }
    putList(this, 'zoneBar', bar)

    const list = this.buildCards(s, app)
    // Same cards → change only the fields that moved (a running clock changes one text a second);
    // a new list only when the set of cards changes. Keeps the scroll still and the band idle.
    const ids = list.map((c) => c.id).join(',')
    if (ids !== this.cardsKey) {
      this.cardsKey = ids
      this.cards = list
      // the scroll needs the real content height (children never shrink)
      this.colH = 190 + list.length * 208 + 60
      return
    }
    list.forEach((n, k) => {
      const c = this.cards[k]
      CARD_FIELDS.forEach((f) => {
        if (c[f] !== n[f]) {
          c[f] = n[f]
        }
      })
    })
  },

  /** Start is always first; then the modules the licence opens (all when XEMS does not say). */
  buildCards(s, app) {
    const m = mods(s)
    const lic = s.lic || null
    const has = (id) => !lic || lic.indexOf(id) >= 0
    const ai = s.mode === 'ai'
    const out = []

    const trRun = !!m.tr.run && !ai
    out.push({
      id: 'train', title: 'Старт', color: GREEN, active: trRun,
      sub: trRun ? 'активен · ' + hms((s.el || 0) + age(app, true))
        : s.mode === 'manual' ? 'пауза · ' + hms(s.el || 0) : 'ръчен режим'
    })

    if (has('ai')) {
      let aiSub = 'умна сесия'
      if (ai) {
        aiSub = s.st === 'ready' ? 'почивката стига'
          : s.st === 'rest' ? 'почивка ' + mmss((s.rl || 0) - app.silence())
            : (s.ph || 'сесия') + ' · ' + mmss((s.pl || 0) - age(app, s.st === 'run'))
      }
      out.push({ id: 'ai', title: 'AI', color: ACCENT, active: ai, sub: aiSub })
    }

    if (has('timer')) {
      const tm = m.tm
      let tmSub = 'интервали'
      if (tm.arm) {
        tmSub = tm.run ? mmss((tm.left || 0) - age(app, true)) + (tm.lbl ? ' · ' + tm.lbl : tm.loops > 0 ? ' · кръг ' + tm.loop + '/' + tm.loops : '')
          : tm.pau ? 'пауза · ' + mmss(tm.left || 0) : 'чака старт'
      }
      out.push({ id: 'timer', title: 'Таймер', color: AMBER, active: !!tm.run, sub: tmSub })
    }

    if (has('music')) {
      const mu = m.mu
      out.push({
        id: 'music', title: 'Музика', color: PURPLE, active: !!mu.play,
        sub: mu.on ? (mu.title || 'музика') : 'импулси в такт'
      })
    }

    if (has('pulse')) {
      const hg = m.hg
      const hgSub = hg.ai ? 'AI управлява' : hg.en ? (hg.hold ? 'задържа силата' : 'сила ' + (hg.sf || 100) + '%') : 'сила по пулса'
      out.push({ id: 'pulse', title: 'Пулс', color: RED, active: !!hg.en && !hg.ai, sub: hgSub })
    }

    out.forEach((c) => {
      c.bg = c.active ? TINT[c.id] : IDLE
      c.border = c.active ? c.color : '#26272C'
      c.subColor = c.active ? c.color : '#AEAEB2'
    })
    return out
  },

  open(id) {
    this.$app.$def.buzz('short')
    router.push({ uri: PAGES[id] || PAGES.train })
  }
}
</script>

<style>
/* ---- common (scripts/gen-pages.py stamps this into every page) ---- */
.root {
  width: 212px;
  height: 520px;
  background-color: #000000;
}
.screen {
  width: 212px;
  height: 520px;
  flex-direction: column;
  align-items: center;
  padding-top: 46px;
}
.scr {
  width: 212px;
  height: 520px;
}
.col {
  flex-shrink: 0;
  width: 212px;
  flex-direction: column;
}
.in-up {
  animation-name: inUp;
  animation-duration: 260ms;
  animation-timing-function: ease-out;
}
.in-down {
  animation-name: inDown;
  animation-duration: 260ms;
  animation-timing-function: ease-out;
}
/* body under the title: fills the rest of the screen, content centred (no empty bottom half) */
.mid {
  flex-grow: 1;
  width: 212px;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-bottom: 34px;
}
.dots {
  width: 10px;
  height: 520px;
  margin-left: 202px;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}
.pdot {
  width: 6px;
  height: 6px;
  margin-top: 3px;
  margin-bottom: 3px;
  border-radius: 3px;
  background-color: #48484a;
}
.pdot-on {
  height: 18px;
  background-color: #ffffff;
}
.caps {
  flex-shrink: 0;
  height: 30px;
  font-size: 22px;
  font-weight: bold;
  color: #8e8e93;
}
.sub {
  flex-shrink: 0;
  width: 196px;
  text-align: center;
  font-size: 24px;
  color: #aeaeb2;
}
.down {
  transform: scale(0.92);
}
.btn {
  flex-shrink: 0;
  justify-content: center;
  align-items: center;
  transition-property: transform;
  transition-duration: 120ms;
}
.off {
  opacity: 0.3;
}
/* on / off switch: track + knob (one tap target, 150 × 84) */
.switch {
  flex-shrink: 0;
  width: 150px;
  height: 84px;
  padding-left: 8px;
  padding-right: 8px;
  border-radius: 42px;
  flex-direction: row;
  align-items: center;
  justify-content: flex-start;
  background-color: #3a3a3c;
  transition-property: transform;
  transition-duration: 120ms;
}
.switch-on {
  justify-content: flex-end;
}
.knob {
  flex-shrink: 0;
  width: 68px;
  height: 68px;
  border-radius: 34px;
  background-color: #ffffff;
}
.state {
  flex-shrink: 0;
  margin-bottom: 18px;
  font-size: 44px;
  font-weight: bold;
}
/* number tiles (2 per row) */
.tiles {
  flex-shrink: 0;
  flex-direction: row;
  margin-top: 8px;
}
.tile {
  flex-shrink: 0;
  width: 88px;
  height: 84px;
  margin-left: 4px;
  margin-right: 4px;
  border-radius: 22px;
  border-width: 1px;
  border-color: #2c2c2e;
  background-color: #1c1c1e;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}
.tile-num {
  flex-shrink: 0;
  font-size: 34px;
  font-weight: bold;
  color: #ffffff;
}
.tile-lbl {
  flex-shrink: 0;
  font-size: 18px;
  color: #8e8e93;
}
.t-max {
  color: #ff453a;
}
.t-kcal {
  color: #ff9f0a;
}
/* time in heart-rate zones: one bar, a segment per zone */
.zstack {
  flex-shrink: 0;
  width: 184px;
  height: 14px;
  margin-top: 16px;
  border-radius: 7px;
  flex-direction: row;
  background-color: #1c1c1e;
}
.zpart {
  height: 14px;
}
@keyframes inUp {
  from {
    transform: translateY(90px);
    opacity: 0;
  }
  to {
    transform: translateY(0px);
    opacity: 1;
  }
}
@keyframes inDown {
  from {
    transform: translateY(-90px);
    opacity: 0;
  }
  to {
    transform: translateY(0px);
    opacity: 1;
  }
}
/* ---- page ---- */
.bg-home {
  flex-shrink: 0;
  background-image: url(/common/bg/home.png);
  background-size: cover;
}
.hdr {
  flex-shrink: 0;
  height: 190px;
  width: 212px;
  flex-direction: column;
  align-items: center;
  padding-top: 42px;
  padding-bottom: 6px;
}
.hr-row {
  flex-shrink: 0;
  flex-direction: row;
  align-items: center;
}
.hr-heart {
  flex-shrink: 0;
  width: 34px;
  height: 34px;
  margin-right: 8px;
}
.hr-big {
  flex-shrink: 0;
  font-size: 62px;
  font-weight: bold;
}
.hr-sub {
  flex-shrink: 0;
  width: 196px;
  text-align: center;
  font-size: 22px;
  color: #c7c7cc;
}
.zones {
  flex-shrink: 0;
  flex-direction: row;
  margin-top: 12px;
}
.zseg {
  flex-shrink: 0;
  width: 32px;
  height: 10px;
  margin-left: 3px;
  margin-right: 3px;
  border-radius: 5px;
}
.sync {
  flex-shrink: 0;
  margin-top: 8px;
  font-size: 20px;
  color: #ff9f0a;
}
.card {
  flex-shrink: 0;
  height: 196px;
  width: 196px;
  margin-left: 8px;
  margin-top: 12px;
  padding-top: 14px;
  flex-direction: column;
  align-items: center;
  border-radius: 30px;
  border-width: 3px;
}
/* badge: the circle is CSS (colour + radius: always round, never clipped); the light and the glyph
   are a translucent layer on top (Vela centres a sized div reliably; an <image> child it may not) */
.ic {
  flex-shrink: 0;
  width: 72px;
  height: 72px;
  border-radius: 36px;
  background-size: contain;
}
.ic-train {
  background-image: url(/common/art/badge-train.png);
}
.ic-ai {
  background-image: url(/common/art/badge-ai.png);
}
.ic-timer {
  background-image: url(/common/art/badge-timer.png);
}
.ic-music {
  background-image: url(/common/art/badge-music.png);
}
.ic-pulse {
  background-image: url(/common/art/badge-pulse.png);
}
.ct {
  flex-shrink: 0;
  margin-top: 8px;
  width: 180px;
  text-align: center;
  font-size: 32px;
  font-weight: bold;
  color: #ffffff;
  lines: 1;
}
.cs {
  flex-shrink: 0;
  margin-top: 4px;
  width: 184px;
  height: 32px;
  text-align: center;
  font-size: 21px;
  lines: 1;
}
.offline {
  flex-shrink: 0;
  width: 212px;
  height: 520px;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.radar {
  flex-shrink: 0;
  width: 170px;
  height: 170px;
  justify-content: center;
  align-items: center;
}
.wave {
  flex-shrink: 0;
  width: 160px;
  height: 160px;
  border-radius: 80px;
  border-width: 3px;
  border-color: #ff3b5c;
  animation-name: wave;
  animation-duration: 2000ms;
  animation-iteration-count: infinite;
}
.wave2 {
  flex-shrink: 0;
  animation-delay: 1000ms;
}
.core {
  flex-shrink: 0;
  width: 86px;
  height: 86px;
  border-radius: 43px;
  background-color: #ff3b5c;
  justify-content: center;
  align-items: center;
}
.core-x {
  flex-shrink: 0;
  font-size: 46px;
  font-weight: bold;
  color: #ffffff;
}
.off-title {
  flex-shrink: 0;
  margin-top: 18px;
  font-size: 36px;
  font-weight: bold;
  color: #ffffff;
}
.off-sub {
  flex-shrink: 0;
  margin-top: 4px;
  width: 196px;
  text-align: center;
  font-size: 24px;
  color: #ff9f0a;
}
.off-hint {
  flex-shrink: 0;
  margin-top: 22px;
}
@keyframes wave {
  from {
    transform: scale(0.5);
    opacity: 1;
  }
  to {
    transform: scale(1.1);
    opacity: 0;
  }
}
</style>
