<template>
  <stack class="root" onswipe="onSwipe">
    <div class="screen {{anim}}" if="{{!offline}}" onclick="open" onlongpress="pauseAll">
      <div class="ambient" style="background: linear-gradient(180deg, {{card.glow}} 0%, rgba(0,0,0,0) 100%)"></div>
      <div class="ambient-fade"></div>

      <div class="hr-row">
        <image class="hr-heart" src="/common/icons/heart.png"></image>
        <text class="hr-line" style="color: {{hrColor}}">{{hrLine}}</text>
        <text class="chip" if="{{card.active}}" style="background-color: {{card.color}}">{{card.chip}}</text>
      </div>

      <stack class="module-box">
        <div class="glow {{card.active ? 'breathe' : ''}}" style="background-color: {{card.glow}}; width: {{card.active ? '178px' : '0px'}}; height: {{card.active ? '178px' : '0px'}}"></div>
        <div class="module-ring" style="border-color: {{card.ring}}"></div>
        <div class="module-icon btn-primary" style="background: linear-gradient(180deg, {{card.color}} 0%, {{card.dark}} 100%)">
          <div class="btn-shine"></div>
          <image class="module-img" src="{{card.icon}}"></image>
        </div>
      </stack>

      <text class="title">{{card.title}}</text>
      <text class="state" style="color: {{card.active ? card.color : '#AEAEB2'}}">{{card.sub}}</text>
      <text class="hint">{{card.active ? '● активен' : 'докосни · влез'}}</text>

      <text class="peek peek-up" if="{{peekUp}}">↑ {{peekUp}}</text>
      <text class="peek peek-down" if="{{peekDown}}">↓ {{peekDown}}</text>
    </div>

    <div class="dots" if="{{!offline}}">
      <div for="{{dots}}" class="pdot {{$item.on ? 'pdot-on' : ''}}" style="background-color: {{$item.on ? dotAccent : '#3A3A3C'}}"></div>
    </div>

    <div class="offline" if="{{offline}}">
      <stack class="radar">
        <div class="wave"></div>
        <div class="wave wave2"></div>
        <div class="core"><text class="core-x">X</text></div>
      </stack>
      <text class="off-title">XEMS</text>
      <text class="off-sub">{{offText}}</text>
      <text class="sub off-hint">Отвори XEMS на таблета</text>
      <text class="off-diag">{{diagText}}</text>
    </div>
  </stack>
</template>

<script>
import router from '@system.router'
import { MODULES, ROUTES, ZONE, ACCENT, mmss, hms, zoneOf, mods, bind, age, setPages, swipe, glow } from '../../common/ui.js'

export default {
  private: {
    offline: true,
    offText: 'Свързване…',
    diagText: '',
    hrLine: '',
    hrColor: '#FFFFFF',
    cards: {},
    card: { id: 'ai', title: 'AI', sub: '', icon: MODULES.ai.icon, color: ACCENT, dark: MODULES.ai.dark, glow: 'rgba(0,0,0,0)', ring: 'rgba(255,59,92,0.25)', active: false, chip: 'ТЕЧЕ' },
    ids: [],
    idsKey: '',
    idx: 0,
    cur: '',
    dots: [],
    dotAccent: ACCENT,
    anim: '',
    peekUp: '',
    peekDown: ''
  },

  onInit() {
    this.unbind = bind(this)
  },

  onDestroy() {
    this.unbind()
  },

  onSwipe(e) {
    swipe(this, e)
    this.card = this.cards[this.cur] || this.card
    this.peekHints()
  },

  update() {
    const app = this.$app.$def
    const s = app.state
    const quiet = app.silence()
    if (!s || quiet > 12) {
      this.offline = true
      this.offText = quiet > 9000 ? 'Свързване…' : 'Връзката прекъсна'
      const d = app.diag || {}
      this.diagText = d.failed > 0 || d.err ? 'връзка: ' + d.link + (d.err ? ' · ' + d.err : '') : ''
      return
    }
    this.offline = false
    const z = s.hr > 0 ? s.z || zoneOf(s.hr, s.lim || 170) : 0
    this.hrLine = s.hr > 0 ? s.hr + ' · Z' + z : '--'
    this.hrColor = s.hr > 0 ? ZONE[z] : '#8E8E93'

    const list = this.buildCards(s, app)
    const cards = {}
    list.forEach((c) => { cards[c.id] = c })
    this.cards = cards
    const ids = list.filter((c) => c.active).concat(list.filter((c) => !c.active)).map((c) => c.id)
    if (!this.idsKey || this.cur === '') {
      setPages(this, ids, (cards[ids[0]] || list[0]).color)
    } else {
      setPages(this, this.ids.length === ids.length ? this.ids : ids, (cards[this.cur] || list[0]).color)
    }
    this.card = cards[this.cur] || list[0]
    this.dotAccent = this.card.color
    this.peekHints()
  },

  peekHints() {
    const ids = this.ids || []
    const i = this.idx || 0
    this.peekUp = i < ids.length - 1 ? (this.cards[ids[i + 1]] || {}).title || '' : ''
    this.peekDown = i > 0 ? (this.cards[ids[i - 1]] || {}).title || '' : ''
  },

  buildCards(s, app) {
    const m = mods(s)
    const ai = s.mode === 'ai'
    const out = []

    let aiSub = 'стартира се от таблета'
    let aiChip = 'AI'
    if (ai) {
      aiChip = s.st === 'run' ? 'ТЕЧЕ' : s.st === 'pause' ? 'ПАУЗА' : s.st === 'rest' ? 'ПОЧИВКА' : 'AI'
      aiSub = s.st === 'ready' ? 'почивката стига'
        : s.st === 'rest' ? 'почивка ' + mmss((s.rl || 0) - app.silence())
          : (s.ph || 'сесия') + ' · ' + mmss((s.pl || 0) - age(app, s.st === 'run'))
    }
    out.push(this.mkCard('ai', MODULES.ai, aiSub, ai, aiChip))

    const trRun = !!m.tr.run && !ai
    out.push(this.mkCard('train', MODULES.train,
      trRun ? 'тече · ' + hms((s.el || 0) + age(app, true)) : s.mode === 'manual' ? 'пауза · ' + hms(s.el || 0) : 'ръчно управление',
      trRun, trRun ? 'ТЕЧЕ' : 'РЪЧНО'))

    const tm = m.tm
    let tmSub = 'не е включен'
    if (tm.arm) {
      tmSub = tm.run ? mmss((tm.left || 0) - age(app, true)) + (tm.lbl ? ' · ' + tm.lbl : tm.loops > 0 ? ' · кръг ' + tm.loop + '/' + tm.loops : '')
        : tm.pau ? 'пауза · ' + mmss(tm.left || 0) : 'чака старт'
    }
    out.push(this.mkCard('timer', MODULES.timer, tmSub, !!tm.run, tm.run ? 'ТЕЧЕ' : 'ТАЙМЕР'))

    const mu = m.mu
    out.push(this.mkCard('music', MODULES.music, mu.on ? (mu.title || 'музика') : 'изключена', !!mu.play, mu.play ? '♫' : 'МУЗИКА'))

    const hg = m.hg
    const hgSub = hg.ai ? 'AI управлява' : hg.en ? (hg.hold ? 'задържа силата' : 'сила ' + (hg.sf || 100) + '%') : 'автоконтрол изкл.'
    out.push(this.mkCard('pulse', MODULES.pulse, hgSub, !!hg.en && !hg.ai, hg.en ? 'ВКЛ' : 'ИЗКЛ'))

    return out
  },

  mkCard(id, mod, sub, active, chip) {
    return {
      id: id,
      title: mod.title,
      sub: sub,
      icon: mod.icon,
      color: mod.color,
      dark: mod.dark,
      glow: active ? glow(mod.color, 0.42) : 'rgba(0,0,0,0)',
      ring: active ? glow(mod.color, 0.55) : 'rgba(255,255,255,0.08)',
      active: active,
      chip: chip
    }
  },

  open() {
    this.$app.$def.buzz('short')
    router.push({ uri: ROUTES[this.cur] || ROUTES.ai })
  },

  pauseAll() {
    this.$app.$def.send({ t: 'cmd', a: 'pause_all' })
    this.$app.$def.buzz('long')
  }
}
</script>

<style>
/* ---- common (scripts/gen-pages.py stamps this into every page) ---- */
/* XEMS Band v4 — shared design system (212 × 520 AMOLED) */
.root {
  width: 212px;
  height: 520px;
  background-color: #000000;
}
.screen {
  width: 212px;
  height: 520px;
  flex-direction: column;
  align-items: center;
  padding-top: 32px;
  background-color: #000000;
}
.ambient {
  width: 212px;
  height: 260px;
  position: absolute;
  top: 0px;
  left: 0px;
  opacity: 0.55;
}
.ambient-fade {
  width: 212px;
  height: 520px;
  position: absolute;
  top: 0px;
  left: 0px;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0) 0%, #000000 72%);
}
.in-up {
  animation-name: inUp;
  animation-duration: 280ms;
  animation-timing-function: ease-out;
}
.in-down {
  animation-name: inDown;
  animation-duration: 280ms;
  animation-timing-function: ease-out;
}
.in-fade {
  animation-name: fadeIn;
  animation-duration: 220ms;
  animation-timing-function: ease-out;
}
.dots {
  width: 16px;
  height: 520px;
  margin-left: 196px;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}
.pdot {
  width: 6px;
  height: 6px;
  margin-top: 5px;
  margin-bottom: 5px;
  border-radius: 3px;
  background-color: #3a3a3c;
}
.pdot-on {
  width: 8px;
  height: 24px;
  border-radius: 4px;
  background-color: #ffffff;
}
.caps {
  font-size: 20px;
  font-weight: bold;
  color: #636366;
  letter-spacing: 1px;
}
.sub {
  width: 196px;
  text-align: center;
  font-size: 22px;
  color: #aeaeb2;
  lines: 2;
  text-overflow: ellipsis;
}
.chip {
  height: 28px;
  padding-left: 12px;
  padding-right: 12px;
  border-radius: 14px;
  font-size: 18px;
  font-weight: bold;
  color: #000000;
}
.chip-outline {
  height: 28px;
  padding-left: 10px;
  padding-right: 10px;
  border-radius: 14px;
  border-width: 2px;
  font-size: 18px;
  font-weight: bold;
}
.down {
  transform: scale(0.92);
}
.btn {
  justify-content: center;
  align-items: center;
  transition-property: transform;
  transition-duration: 120ms;
}
.off {
  opacity: 0.28;
}
.surface {
  background-color: #1c1c1e;
  border-radius: 24px;
  border-width: 1px;
  border-color: #2c2c2e;
}
.surface-elevated {
  background-color: #2c2c2e;
  border-radius: 24px;
  border-width: 1px;
  border-color: #3a3a3c;
}
.glow {
  position: absolute;
  border-radius: 999px;
  opacity: 0.38;
}
.breathe {
  animation-name: breathe;
  animation-duration: 1500ms;
  animation-iteration-count: infinite;
  animation-direction: alternate;
  animation-timing-function: ease-in-out;
}
.btn-ring {
  position: absolute;
  border-radius: 999px;
  border-width: 2px;
  border-color: rgba(255, 255, 255, 0.12);
}
.btn-shine {
  position: absolute;
  width: 60%;
  height: 28%;
  top: 8%;
  border-radius: 999px;
  background-color: rgba(255, 255, 255, 0.14);
}
.btn-primary {
  border-width: 2px;
  border-color: rgba(255, 255, 255, 0.1);
}
.btn-surface {
  background-color: #2c2c2e;
  border-width: 2px;
  border-color: #3a3a3c;
}
.btn-pill {
  width: 180px;
  height: 108px;
  border-radius: 54px;
  background-color: #2c2c2e;
  border-width: 2px;
  border-color: #3a3a3c;
}
.btn-pill-accent {
  border-color: rgba(255, 255, 255, 0.08);
}
.pill-img {
  width: 52px;
  height: 52px;
}
.btn-toggle {
  width: 168px;
  height: 168px;
  border-radius: 84px;
  border-width: 3px;
  border-color: rgba(255, 255, 255, 0.12);
}
.toggle-text {
  font-size: 38px;
  font-weight: bold;
  color: #ffffff;
  letter-spacing: 2px;
}
.play-wrap {
  justify-content: center;
  align-items: center;
}
.play {
  border-width: 2px;
  border-color: rgba(255, 255, 255, 0.1);
}
.play-img {
  width: 54px;
  height: 54px;
}
.ring-box {
  justify-content: center;
  align-items: center;
}
.ring-track {
  background-color: #141416;
  border-width: 1px;
  border-color: #1c1c1e;
}
.ring-glow {
  position: absolute;
  border-radius: 999px;
  opacity: 0.22;
}
.tile {
  width: 94px;
  height: 88px;
  margin-left: 4px;
  margin-right: 4px;
  border-radius: 22px;
  background-color: #1c1c1e;
  border-width: 1px;
  border-color: #2c2c2e;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}
.tile-num {
  font-size: 34px;
  font-weight: bold;
  color: #ffffff;
}
.tile-label {
  font-size: 20px;
  color: #8e8e93;
}
.tiles {
  flex-direction: row;
  margin-top: 10px;
}
.stat {
  width: 94px;
  height: 92px;
  margin-left: 4px;
  margin-right: 4px;
  border-radius: 22px;
  background-color: #1c1c1e;
  border-width: 1px;
  border-color: #2c2c2e;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}
.stat-num {
  font-size: 36px;
  font-weight: bold;
  color: #ffffff;
}
.stat-label {
  font-size: 20px;
  color: #8e8e93;
}
.stat-max {
  color: #ff453a;
}
.kcal {
  color: #ff9f0a;
}
.zstack {
  width: 192px;
  height: 16px;
  margin-top: 18px;
  border-radius: 8px;
  flex-direction: row;
  background-color: #141416;
  border-width: 1px;
  border-color: #1c1c1e;
}
.zpart {
  height: 16px;
}
.stop-box {
  justify-content: center;
  align-items: center;
}
.stop-ring {
  stroke-width: 12px;
  background-color: #1a0808;
  start-angle: 0deg;
  total-angle: 360deg;
}
.stop-core {
  border-width: 3px;
  border-color: rgba(255, 255, 255, 0.15);
  justify-content: center;
  align-items: center;
}
.stop-img {
  width: 58px;
  height: 58px;
}
.pair {
  flex-direction: row;
}
@keyframes inUp {
  from {
    transform: translateY(72px);
    opacity: 0;
  }
  to {
    transform: translateY(0px);
    opacity: 1;
  }
}
@keyframes inDown {
  from {
    transform: translateY(-72px);
    opacity: 0;
  }
  to {
    transform: translateY(0px);
    opacity: 1;
  }
}
@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}
@keyframes breathe {
  from {
    transform: scale(0.88);
    opacity: 0.55;
  }
  to {
    transform: scale(1.14);
    opacity: 0.12;
  }
}
@keyframes beat {
  from {
    transform: scale(1);
  }
  to {
    transform: scale(1.22);
  }
}
@keyframes wave {
  from {
    transform: scale(0.55);
    opacity: 0.85;
  }
  to {
    transform: scale(1.08);
    opacity: 0;
  }
}
@keyframes spin {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}
/* ---- page ---- */
.hr-row {
  flex-direction: row;
  align-items: center;
  margin-top: 2px;
}
.hr-heart {
  width: 24px;
  height: 24px;
