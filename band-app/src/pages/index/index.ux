<template>
  <div class="root">
    <!-- ============================================================ connected: modules -->
    <div class="home" if="{{!offline}}">
      <div class="head" onlongpress="pauseAll">
        <div class="hr-row">
          <image class="heart {{hr > 0 ? 'beat' : ''}}" src="/common/icons/heart.png"
                 style="animation-duration: {{beatMs}}ms"></image>
          <text class="hr" style="color: {{hrColor}}">{{hrText}}</text>
        </div>
        <div class="zones">
          <div for="{{zoneBars}}" class="zseg {{$item.on ? 'zseg-on' : ''}}" style="background-color: {{$item.c}}"></div>
        </div>
        <text class="head-sub">{{headSub}}</text>
      </div>

      <div for="{{tiles}}" class="tile {{$item.active ? 'tile-on' : ''}} {{pressed === $item.id ? 'down' : ''}}"
           style="border-color: {{$item.active ? $item.color : '#1C1C1E'}}"
           ontouchstart="press($item.id)" ontouchend="release" ontouchcancel="release"
           onclick="open($item.id)">
        <div class="icon" style="background-color: {{$item.color}}">
          <image class="icon-img" src="{{$item.icon}}"></image>
        </div>
        <div class="tile-texts">
          <text class="tile-title">{{$item.title}}</text>
          <text class="tile-sub" style="color: {{$item.active ? $item.color : '#8E8E93'}}">{{$item.sub}}</text>
        </div>
      </div>
    </div>

    <!-- ============================================================ not linked yet -->
    <div class="offline" if="{{offline}}">
      <stack class="radar">
        <div class="wave"></div>
        <div class="wave wave2"></div>
        <div class="core"><text class="core-x">X</text></div>
      </stack>
      <text class="off-title">XEMS</text>
      <text class="off-sub">{{offText}}</text>
      <text class="off-hint">Отвори XEMS на таблета</text>
      <text class="off-diag">{{diagText}}</text>
    </div>
  </div>
</template>

<script>
import router from '@system.router'
import { ZONE, ACCENT, GREEN, AMBER, BLUE, PURPLE, mmss, hms, zoneOf, mods, bind, age } from '../../common/ui.js'

const PAGES = { ai: '/pages/ai', train: '/pages/train', timer: '/pages/timer', music: '/pages/music', pulse: '/pages/pulse' }

export default {
  private: {
    offline: true,
    offText: 'Свързване…',
    diagText: '',
    hr: 0,
    hrText: '--',
    hrColor: '#FFFFFF',
    beatMs: 450,
    zoneBars: [],
    headSub: '',
    tiles: [],
    pressed: ''
  },

  onInit() {
    this.unbind = bind(this)
  },

  onDestroy() {
    this.unbind()
  },

  update() {
    const app = this.$app.$def
    const s = app.state
    const quiet = app.silence()
    if (!s || quiet > 12) {
      this.offline = true
      this.offText = quiet > 9000 ? 'Свързване…' : 'Връзката прекъсна'
      const d = app.diag || {}
      this.diagText = d.failed > 0 || d.err ? 'връзка: ' + d.link + ' · грешки ' + d.failed + (d.err ? '\n' + d.err : '') : ''
      return
    }
    this.offline = false

    const lim = s.lim || 170
    const z = s.hr > 0 ? s.z || zoneOf(s.hr, lim) : 0
    this.hr = s.hr || 0
    this.hrText = s.hr > 0 ? String(s.hr) : '--'
    this.hrColor = s.hr > 0 ? ZONE[z] : '#FFFFFF'
    this.beatMs = s.hr > 0 ? Math.round(30000 / s.hr) : 450
    const bars = []
    for (let i = 1; i <= 5; i++) {
      bars.push({ c: i <= z ? ZONE[i] : '#2C2C2E', on: i === z })
    }
    this.zoneBars = bars
    this.headSub = s.hr > 0 ? 'bpm · Z' + z + (s.kcal > 0 ? ' · ' + Math.round(s.kcal) + ' kcal' : '') : 'няма пулс'

    this.tiles = this.buildTiles(s, app)
  },

  buildTiles(s, app) {
    const m = mods(s)
    const ai = s.mode === 'ai'
    const tiles = []

    // AI
    let aiSub = 'готов'
    if (ai) {
      aiSub = s.st === 'ready' ? 'почивката стига ▶'
        : s.st === 'rest' ? 'почивка ' + mmss((s.rl || 0) - app.silence())
          : (s.ph || 'сесия') + ' · ' + mmss((s.pl || 0) - age(app, s.st === 'run'))
    }
    tiles.push({ id: 'ai', title: 'AI', sub: aiSub, icon: '/common/icons/ai.png', color: ACCENT, active: ai })

    // manual training
    const trRun = !!m.tr.run && !ai
    tiles.push({
      id: 'train', title: 'Тренировка',
      sub: trRun ? 'тече · ' + hms((s.el || 0) + age(app, true)) : s.mode === 'manual' ? 'пауза · ' + hms(s.el || 0) : 'старт от гривната',
      icon: '/common/icons/bolt.png', color: GREEN, active: trRun
    })

    // interval timer
    const tm = m.tm
    let tmSub = 'не е включен'
    if (tm.arm) {
      tmSub = tm.run ? mmss((tm.left || 0) - age(app, true)) + (tm.lbl ? ' · ' + tm.lbl : tm.loops > 0 ? ' · ' + tm.loop + '/' + tm.loops : ' · #' + (tm.loop || 1))
        : tm.pau ? 'пауза · ' + mmss(tm.left || 0) : 'чака старт'
    }
    tiles.push({ id: 'timer', title: 'Таймер', sub: tmSub, icon: '/common/icons/timer.png', color: AMBER, active: !!tm.run })

    // music
    const mu = m.mu
    const muSub = mu.on ? (mu.play ? '▶ ' : '❚❚ ') + (mu.title || 'музика') : 'изключена'
    tiles.push({ id: 'music', title: 'Музика', sub: muSub, icon: '/common/icons/music.png', color: PURPLE, active: !!mu.play })

    // HR module
    const hg = m.hg
    const hgSub = hg.ai ? 'AI управлява' : hg.en ? (hg.hold ? 'задържа силата' : 'сила ' + (hg.sf || 100) + '%') : 'изключен'
    tiles.push({ id: 'pulse', title: 'Пулс', sub: hgSub, icon: '/common/icons/heart.png', color: BLUE, active: !!hg.en && !hg.ai })

    // what runs goes first
    return tiles.filter((t) => t.active).concat(tiles.filter((t) => !t.active))
  },

  pauseAll() {
    this.$app.$def.send({ t: 'cmd', a: 'pause_all' })
    this.$app.$def.buzz('long')
  },

  press(id) {
    this.pressed = id
  },

  release() {
    this.pressed = ''
  },

  open(id) {
    this.pressed = ''
    this.$app.$def.buzz('short')
    router.push({ uri: PAGES[id] })
  }
}
</script>

<style>
.root {
  width: 212px;
  height: 520px;
  background-color: #000000;
}
.home {
  width: 212px;
  height: 520px;
  flex-direction: column;
  align-items: center;
}
.head {
  width: 212px;
  height: 142px;
  flex-direction: column;
  align-items: center;
  padding-top: 18px;
}
.hr-row {
  flex-direction: row;
  align-items: center;
  height: 80px;
}
.heart {
  width: 30px;
  height: 30px;
  margin-right: 8px;
}
.beat {
  animation-name: beat;
  animation-iteration-count: infinite;
  animation-direction: alternate;
}
.hr {
  font-size: 74px;
  font-weight: bold;
}
.zones {
  flex-direction: row;
  align-items: center;
  height: 14px;
}
.zseg {
  width: 32px;
  height: 6px;
  margin-left: 2px;
  margin-right: 2px;
  border-radius: 3px;
}
.zseg-on {
  height: 12px;
  border-radius: 6px;
}
.head-sub {
  margin-top: 2px;
  font-size: 19px;
  color: #8e8e93;
}
.tile {
  width: 200px;
  height: 68px;
  margin-top: 6px;
  border-radius: 34px;
  border-width: 3px;
  background-color: #1c1c1e;
  flex-direction: row;
  align-items: center;
  padding-left: 8px;
  padding-right: 10px;
  transition-property: transform;
  transition-duration: 120ms;
}
.tile-on {
  background-color: #242426;
}
.down {
  transform: scale(0.94);
}
.icon {
  width: 48px;
  height: 48px;
  border-radius: 24px;
  justify-content: center;
  align-items: center;
}
.icon-img {
  width: 28px;
  height: 28px;
}
.tile-texts {
  flex: 1;
  flex-direction: column;
  margin-left: 10px;
}
.tile-title {
  font-size: 21px;
  font-weight: bold;
  color: #ffffff;
  lines: 1;
  text-overflow: ellipsis;
}
.tile-sub {
  font-size: 18px;
  lines: 1;
  text-overflow: ellipsis;
}

/* ---------------------------------------------------------------- offline */
.offline {
  width: 212px;
  height: 520px;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.radar {
  width: 170px;
  height: 170px;
  justify-content: center;
  align-items: center;
}
.wave {
  width: 160px;
  height: 160px;
  border-radius: 80px;
  border-width: 3px;
  border-color: #ff3b5c;
  animation-name: wave;
  animation-duration: 2000ms;
  animation-iteration-count: infinite;
}
.wave2 {
  animation-delay: 1000ms;
}
.core {
  width: 86px;
  height: 86px;
  border-radius: 43px;
  background-color: #ff3b5c;
  justify-content: center;
  align-items: center;
}
.core-x {
  font-size: 46px;
  font-weight: bold;
  color: #ffffff;
}
.off-title {
  margin-top: 18px;
  font-size: 36px;
  font-weight: bold;
  color: #ffffff;
}
.off-sub {
  margin-top: 4px;
  font-size: 22px;
  color: #ff9f0a;
}
.off-hint {
  margin-top: 22px;
  width: 190px;
  text-align: center;
  font-size: 20px;
  color: #8e8e93;
}
.off-diag {
  margin-top: 14px;
  width: 196px;
  text-align: center;
  font-size: 16px;
  color: #48484a;
}

@keyframes beat {
  from {
    transform: scale(1);
  }
  to {
    transform: scale(1.25);
  }
}
@keyframes wave {
  from {
    transform: scale(0.5);
    opacity: 1;
  }
  to {
    transform: scale(1.1);
    opacity: 0;
  }
}
</style>
