<template>
  <!-- home: one module per screen (Start first); flick up / down between them, tap to open,
       hold to pause everything, swipe right = exit. Only proven Vela primitives (no list). -->
  <stack class="root bg-home" onswipe="onSwipe">
    <div class="screen {{anim}}" if="{{!offline}}" onclick="open" onlongpress="pauseAll">
      <div class="hr-row">
        <image class="hr-heart" src="/common/icons/heart.png"></image>
        <text class="hr-line" style="color: {{hrColor}}">{{hrLine}}</text>
      </div>
      <div class="zones">
        <div for="{{zoneBar}}" class="zseg" style="background-color: {{$item.c}}; opacity: {{$item.on ? 1 : 0.22}}"></div>
      </div>
      <stack class="icon-box">
        <div class="glow {{card.active ? 'breathe' : ''}}" style="background-color: {{card.glow}}"></div>
        <div class="icon" style="background-color: {{card.color}}">
          <image class="icon-img" src="{{card.icon}}"></image>
        </div>
      </stack>
      <text class="title">{{card.title}}</text>
      <text class="state" style="color: {{card.active ? card.color : '#C7C7CC'}}">{{card.sub}}</text>
      <text class="sync" if="{{busy}}">синхронизиране…</text>
      <text class="tap" if="{{!busy}}">докосни · влез</text>
    </div>

    <div class="dots" if="{{!offline}}">
      <div for="{{dots}}" class="pdot {{$item.on ? 'pdot-on' : ''}}"></div>
    </div>

    <!-- not linked yet -->
    <div class="offline" if="{{offline}}">
      <stack class="radar">
        <div class="wave"></div>
        <div class="wave wave2"></div>
        <div class="core"><text class="core-x">X</text></div>
      </stack>
      <text class="off-title">XEMS</text>
      <text class="off-sub">{{offText}}</text>
      <text class="sub off-hint">Отвори XEMS на таблета</text>
      <text class="off-diag">{{diagText}}</text>
    </div>
  </stack>
</template>

<script>
import router from '@system.router'
import { ZONE, ACCENT, GREEN, AMBER, BLUE, PURPLE, mmss, hms, zoneOf, mods, bind, age, setPages, swipe } from '../../common/ui.js'

const PAGES = { ai: '/pages/ai', train: '/pages/train', timer: '/pages/timer', music: '/pages/music', pulse: '/pages/pulse' }

export default {
  private: {
    offline: true,
    offText: 'Свързване…',
    diagText: '',
    hrLine: '--',
    hrColor: '#FFFFFF',
    zoneBar: [],
    busy: false,
    cards: {},
    card: { id: 'train', title: 'Старт', sub: '', icon: '/common/icons/bolt.png', color: GREEN, glow: 'rgba(0,0,0,0)', active: false },
    ids: [],
    idsKey: '',
    idx: 0,
    cur: '',
    dots: [],
    anim: ''
  },

  onInit() {
    this.unbind = bind(this)
  },

  onDestroy() {
    this.unbind()
  },

  onSwipe(e) {
    swipe(this, e)
    this.card = this.cards[this.cur] || this.card
  },

  update() {
    const app = this.$app.$def
    const s = app.state
    const quiet = app.silence()
    if (!s || quiet > 12) {
      this.offline = true
      this.offText = quiet > 9000 ? 'Свързване…' : 'Връзката прекъсна'
      const d = app.diag || {}
      this.diagText = d.failed > 0 || d.err ? 'връзка: ' + d.link + (d.err ? ' · ' + d.err : '') : ''
      return
    }
    this.offline = false
    this.busy = app.busy()
    const lim = s.lim || 170
    const z = s.hr > 0 ? s.z || zoneOf(s.hr, lim) : 0
    this.hrLine = s.hr > 0 ? s.hr + ' · Z' + z : '--'
    this.hrColor = s.hr > 0 ? ZONE[z] : '#8E8E93'
    const bar = []
    for (let k = 1; k <= 5; k++) {
      bar.push({ c: ZONE[k], on: z >= k })
    }
    this.zoneBar = bar

    const list = this.buildCards(s, app)
    const cards = {}
    list.forEach((c) => {
      cards[c.id] = c
    })
    this.cards = cards
    // fixed order (Start first); the current screen stays when the licence list changes
    setPages(this, list.map((c) => c.id))
    this.card = cards[this.cur] || list[0]
  },

  /** Start is always first; then the modules the licence opens (all when XEMS does not say). */
  buildCards(s, app) {
    const m = mods(s)
    const lic = s.lic || null
    const has = (id) => !lic || lic.indexOf(id) >= 0
    const ai = s.mode === 'ai'
    const out = []

    const trRun = !!m.tr.run && !ai
    out.push({
      id: 'train', title: 'Старт', icon: '/common/icons/bolt.png', color: GREEN, active: trRun,
      sub: trRun ? 'тече · ' + hms((s.el || 0) + age(app, true))
        : s.mode === 'manual' ? 'пауза · ' + hms(s.el || 0) : 'тренировка и канали'
    })

    if (has('ai')) {
      let aiSub = 'стартира се от таблета'
      if (ai) {
        aiSub = s.st === 'ready' ? 'почивката стига'
          : s.st === 'rest' ? 'почивка ' + mmss((s.rl || 0) - app.silence())
            : (s.ph || 'сесия') + ' · ' + mmss((s.pl || 0) - age(app, s.st === 'run'))
      }
      out.push({ id: 'ai', title: 'AI', icon: '/common/icons/ai.png', color: ACCENT, active: ai, sub: aiSub })
    }

    if (has('timer')) {
      const tm = m.tm
      let tmSub = 'не е включен'
      if (tm.arm) {
        tmSub = tm.run ? mmss((tm.left || 0) - age(app, true)) + (tm.lbl ? ' · ' + tm.lbl : tm.loops > 0 ? ' · кръг ' + tm.loop + '/' + tm.loops : '')
          : tm.pau ? 'пауза · ' + mmss(tm.left || 0) : 'чака старт'
      }
      out.push({ id: 'timer', title: 'Таймер', icon: '/common/icons/timer.png', color: AMBER, active: !!tm.run, sub: tmSub })
    }

    if (has('music')) {
      const mu = m.mu
      out.push({
        id: 'music', title: 'Музика', icon: '/common/icons/music.png', color: PURPLE, active: !!mu.play,
        sub: mu.on ? (mu.title || 'музика') : 'изключена'
      })
    }

    if (has('pulse')) {
      const hg = m.hg
      const hgSub = hg.ai ? 'AI управлява' : hg.en ? (hg.hold ? 'задържа силата' : 'сила ' + (hg.sf || 100) + '%') : 'автоконтрол изкл.'
      out.push({ id: 'pulse', title: 'Пулс', icon: '/common/icons/heart.png', color: BLUE, active: !!hg.en && !hg.ai, sub: hgSub })
    }

    out.forEach((c) => {
      c.glow = c.active ? c.color : 'rgba(0,0,0,0)'
    })
    return out
  },

  open() {
    this.$app.$def.buzz('short')
    router.push({ uri: PAGES[this.cur] || PAGES.train })
  },

  pauseAll() {
    this.$app.$def.command('pause_all', null, 'long')
  }
}
</script>

<style>
/* ---- common (scripts/gen-pages.py stamps this into every page) ---- */
.root {
  width: 212px;
  height: 520px;
  background-color: #000000;
}
.screen {
  width: 212px;
  height: 520px;
  flex-direction: column;
  align-items: center;
  padding-top: 34px;
}
.in-up {
  animation-name: inUp;
  animation-duration: 260ms;
  animation-timing-function: ease-out;
}
.in-down {
  animation-name: inDown;
  animation-duration: 260ms;
  animation-timing-function: ease-out;
}
.dots {
  width: 16px;
  height: 520px;
  margin-left: 196px;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}
.pdot {
  width: 8px;
  height: 8px;
  margin-top: 4px;
  margin-bottom: 4px;
  border-radius: 4px;
  background-color: #3a3a3c;
}
.pdot-on {
  height: 22px;
  background-color: #ffffff;
}
.caps {
  font-size: 24px;
  font-weight: bold;
  color: #8e8e93;
}
.sub {
  width: 196px;
  text-align: center;
  font-size: 24px;
  color: #aeaeb2;
}
.down {
  transform: scale(0.92);
}
.btn {
  justify-content: center;
  align-items: center;
  transition-property: transform;
  transition-duration: 120ms;
}
.off {
  opacity: 0.3;
}
@keyframes inUp {
  from {
    transform: translateY(90px);
    opacity: 0;
  }
  to {
    transform: translateY(0px);
    opacity: 1;
  }
}
@keyframes inDown {
  from {
    transform: translateY(-90px);
    opacity: 0;
  }
  to {
    transform: translateY(0px);
    opacity: 1;
  }
}
@keyframes breathe {
  from {
    transform: scale(0.86);
    opacity: 0.9;
  }
  to {
    transform: scale(1.12);
    opacity: 0.2;
  }
}
@keyframes beat {
  from {
    transform: scale(1);
  }
  to {
    transform: scale(1.25);
  }
}
/* ---- page ---- */
.bg-home {
  background-image: url(/common/bg/home.png);
  background-size: cover;
}
.hr-row {
  flex-direction: row;
  align-items: center;
}
.hr-heart {
  width: 30px;
  height: 30px;
  margin-right: 8px;
}
.hr-line {
  font-size: 34px;
  font-weight: bold;
}
.zones {
  flex-direction: row;
  margin-top: 8px;
}
.zseg {
  width: 28px;
  height: 8px;
  margin-left: 3px;
  margin-right: 3px;
  border-radius: 4px;
}
.icon-box {
  width: 176px;
  height: 176px;
  margin-top: 30px;
  justify-content: center;
  align-items: center;
}
.glow {
  width: 170px;
  height: 170px;
  border-radius: 85px;
  opacity: 0.35;
}
.breathe {
  animation-name: breathe;
  animation-duration: 1500ms;
  animation-iteration-count: infinite;
  animation-direction: alternate;
}
.icon {
  width: 132px;
  height: 132px;
  border-radius: 66px;
  justify-content: center;
  align-items: center;
}
.icon-img {
  width: 72px;
  height: 72px;
}
.title {
  margin-top: 20px;
  font-size: 44px;
  font-weight: bold;
  color: #ffffff;
}
.state {
  margin-top: 6px;
  width: 196px;
  text-align: center;
  font-size: 26px;
  lines: 2;
  text-overflow: ellipsis;
}
.sync {
  margin-top: 14px;
  font-size: 22px;
  color: #ff9f0a;
}
.tap {
  margin-top: 14px;
  font-size: 22px;
  color: #636366;
}
.offline {
  width: 212px;
  height: 520px;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.radar {
  width: 170px;
  height: 170px;
  justify-content: center;
  align-items: center;
}
.wave {
  width: 160px;
  height: 160px;
  border-radius: 80px;
  border-width: 3px;
  border-color: #0a84ff;
  animation-name: wave;
  animation-duration: 2000ms;
  animation-iteration-count: infinite;
}
.wave2 {
  animation-delay: 1000ms;
}
.core {
  width: 86px;
  height: 86px;
  border-radius: 43px;
  background-color: #0a84ff;
  justify-content: center;
  align-items: center;
}
.core-x {
  font-size: 46px;
  font-weight: bold;
  color: #ffffff;
}
.off-title {
  margin-top: 18px;
  font-size: 36px;
  font-weight: bold;
  color: #ffffff;
}
.off-sub {
  margin-top: 4px;
  font-size: 24px;
  color: #ff9f0a;
}
.off-hint {
  margin-top: 22px;
}
.off-diag {
  margin-top: 14px;
  width: 196px;
  text-align: center;
  font-size: 20px;
  color: #48484a;
}
@keyframes wave {
  from {
    transform: scale(0.5);
    opacity: 1;
  }
  to {
    transform: scale(1.1);
    opacity: 0;
  }
}
</style>
