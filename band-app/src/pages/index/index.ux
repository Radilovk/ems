  font-size: 24px;
  font-weight: bold;
}
.chip {
  margin-left: 8px;
}
.module-box {
  width: 180px;
  height: 180px;
  margin-top: 28px;
  justify-content: center;
  align-items: center;
}
.module-ring {
  width: 152px;
  height: 152px;
  border-radius: 76px;
  border-width: 3px;
  position: absolute;
}
.module-icon {
  width: 140px;
  height: 140px;
  border-radius: 70px;
  justify-content: center;
  align-items: center;
}
.module-img {
  width: 72px;
