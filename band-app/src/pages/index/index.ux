<template>
  <!-- Dial-home: watch-face layout. Tap play = train toggle; chips open modules.
       Hold HR = pause everything. Swipe right = exit. -->
  <stack class="root bg-home" onswipe="onSwipe">
    <div class="dial" if="{{!cold}}">
      <text class="dial-clock">{{clock}}</text>
      <text class="dial-hr" style="color: {{hrColor}}"
            ontouchstart="hrDown" ontouchend="hrUp" ontouchcancel="hrUp">{{hrBig}}</text>
      <text class="dial-sub">{{hrSub}}</text>
      <div class="zones">
        <div for="{{zoneBar}}" class="zseg" style="background-color: {{$item.c}}; opacity: {{$item.on ? 1 : 0.22}}"></div>
      </div>
      <div class="home-play {{run ? 'home-play-run' : 'home-play-idle'}} {{pressed === 'play' ? 'home-play-press' : ''}}"
           ontouchstart="press('play')" ontouchend="release" ontouchcancel="release" onclick="toggle">
        <image class="home-play-img" src="{{run ? '/common/icons/pause.png' : '/common/icons/play.png'}}"></image>
      </div>
      <text class="dial-hint">{{hint}}</text>
      <div class="chip-row">
        <div class="chip {{trainOn ? 'chip-on' : ''}}" if="{{hasTrain}}" onclick="open('train')">
          <text class="chip-t">Старт</text>
        </div>
        <div class="chip {{aiOn ? 'chip-on' : ''}}" if="{{hasAi}}" onclick="open('ai')">
          <text class="chip-t">AI</text>
        </div>
      </div>
      <div class="chip-row">
        <div class="chip {{tmOn ? 'chip-on' : ''}}" if="{{hasTimer}}" onclick="open('timer')">
          <text class="chip-t">Таймер</text>
        </div>
        <div class="chip {{hgOn ? 'chip-on' : ''}}" if="{{hasPulse}}" onclick="open('pulse')">
          <text class="chip-t">Пулс</text>
        </div>
      </div>
    </div>

    <div class="offline" if="{{cold}}">
      <stack class="radar">
        <div class="wave"></div>
        <div class="wave wave2"></div>
        <div class="core"><text class="core-x">X</text></div>
      </stack>
      <text class="off-title">XEMS</text>
      <text class="off-sub">{{offText}}</text>
      <text class="sub off-hint">Отвори XEMS на таблета</text>
    </div>
  </stack>
</template>

<script>
import router from '@system.router'
import { ZONE, hms, zoneOf, mods, bind, shown, age } from '../../common/ui.js'

const PAGES = { ai: '/pages/ai', train: '/pages/train', timer: '/pages/timer', music: '/pages/music', pulse: '/pages/pulse' }

export default {
  private: {
    cold: true,
    offText: 'Свързване…',
    clock: '--:--',
    hrBig: '--',
    hrSub: '',
    hrColor: '#FFFFFF',
    hint: '',
    zoneBar: [],
    run: false,
    pressed: '',
    hasTrain: true,
    hasAi: true,
    hasTimer: true,
    hasPulse: true,
    trainOn: false,
    aiOn: false,
    tmOn: false,
    hgOn: false
  },

  onInit() {
    this.unbind = bind(this, 'index')
    this.hrT0 = 0
  },

  onShow() {
    shown(this, true)
  },

  onHide() {
    shown(this, false)
  },

  onDestroy() {
    this.unbind()
  },

  onSwipe(e) {
    if (e && e.direction === 'right') {
      router.back()
    }
  },

  update() {
    const app = this.$app.$def
    const s = app.state
    const quiet = app.silence()
    if (!app.rx) {
      this.cold = true
      this.offText = 'Свързване…'
      return
    }
    this.cold = false
    const stale = !s || quiet > 12
    const lim = (s && s.lim) || 170
    const hr = s && s.hr > 0 ? s.hr : 0
    const z = hr > 0 ? (s.z || zoneOf(hr, lim)) : 0
    this.hrBig = hr > 0 ? String(hr) : '--'
    this.hrColor = hr > 0 ? ZONE[z] : '#8E8E93'
    const m = mods(s)
    const ai = !!(s && s.mode === 'ai')
    const trRun = !!(m.tr.run && !ai)
    this.run = !!(s && (s.run || trRun || ai && s.st === 'run'))
    if (stale) {
      this.hrSub = 'връзката прекъсна'
      this.clock = this.clock || '--:--'
      this.hint = 'Отвори XEMS на таблета'
      return
    }
    this.hrSub = hr > 0 ? 'Z' + z + ' · лимит ' + lim : 'няма пулс'
    const el = (s.el || 0) + age(app, this.run)
    this.clock = this.run || s.mode === 'manual' || ai ? hms(el) : '--:--'
    this.hint = this.run ? 'музика · ▶' : '▶ старт'
    const bar = []
    for (let k = 1; k <= 5; k++) {
      bar.push({ c: ZONE[k], on: z >= k })
    }
    this.zoneBar = bar
    const lic = s.lic || null
    const has = (id) => !lic || lic.indexOf(id) >= 0
    this.hasTrain = true
    this.hasAi = has('ai')
    this.hasTimer = has('timer')
    this.hasPulse = has('pulse')
    this.trainOn = trRun
    this.aiOn = ai
    this.tmOn = !!m.tm.run
    this.hgOn = !!(m.hg.en && !m.hg.ai)
  },

  press(id) {
    this.pressed = id
  },

  release() {
    this.pressed = ''
  },

  toggle() {
    this.pressed = ''
    this.$app.$def.command('train_toggle')
  },

  hrDown() {
    this.hrT0 = Date.now()
  },

  hrUp() {
    if (this.hrT0 && Date.now() - this.hrT0 >= 600) {
      this.$app.$def.command('pause_all')
    }
    this.hrT0 = 0
  },

  open(id) {
    this.$app.$def.buzz('short')
    router.push({ uri: PAGES[id] || PAGES.train })
  }
}
</script>

<style>
/* ---- common (scripts/gen-pages.py stamps this into every page) ---- */
.root {
  width: 212px;
  height: 520px;
  background-color: #000000;
}
.screen {
  width: 212px;
  height: 520px;
  flex-direction: column;
  align-items: center;
  padding-top: 46px;
}
.scr {
  width: 212px;
  height: 520px;
}
.col {
  flex-shrink: 0;
  width: 212px;
  flex-direction: column;
}
.in-up {
  animation-name: inUp;
  animation-duration: 260ms;
  animation-timing-function: ease-out;
}
.in-down {
  animation-name: inDown;
  animation-duration: 260ms;
  animation-timing-function: ease-out;
}
.dots {
  width: 16px;
  height: 520px;
  margin-left: 196px;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}
.pdot {
  width: 8px;
  height: 8px;
  margin-top: 4px;
  margin-bottom: 4px;
  border-radius: 4px;
  background-color: #3a3a3c;
}
.pdot-on {
  height: 22px;
  background-color: #ffffff;
}
.caps {
  flex-shrink: 0;
  font-size: 24px;
  font-weight: bold;
  color: #8e8e93;
}
.sub {
  flex-shrink: 0;
  width: 196px;
  text-align: center;
  font-size: 24px;
  color: #aeaeb2;
}
.down {
  transform: scale(0.92);
}
.btn {
  flex-shrink: 0;
  justify-content: center;
  align-items: center;
  transition-property: transform;
  transition-duration: 120ms;
}
.off {
  opacity: 0.3;
}
@keyframes inUp {
  from {
    transform: translateY(90px);
    opacity: 0;
  }
  to {
    transform: translateY(0px);
    opacity: 1;
  }
}
@keyframes inDown {
  from {
    transform: translateY(-90px);
    opacity: 0;
  }
  to {
    transform: translateY(0px);
    opacity: 1;
  }
}
@keyframes breathe {
  from {
    transform: scale(0.86);
    opacity: 0.9;
  }
  to {
    transform: scale(1.12);
    opacity: 0.2;
  }
}
@keyframes beat {
  from {
    transform: scale(1);
  }
  to {
    transform: scale(1.25);
  }
}
/* ---- page ---- */
.bg-home {
  flex-shrink: 0;
  background-image: url(/common/bg/home.png);
  background-size: cover;
}
.dial {
  flex-shrink: 0;
  width: 212px;
  height: 520px;
  flex-direction: column;
  align-items: center;
  padding-top: 36px;
}
.dial-clock {
  flex-shrink: 0;
  font-size: 28px;
  font-weight: bold;
  color: #aeaeb2;
}
.dial-hr {
  flex-shrink: 0;
  margin-top: 2px;
  font-size: 56px;
  font-weight: bold;
  color: #ffffff;
}
.dial-sub {
  flex-shrink: 0;
  width: 196px;
  text-align: center;
  font-size: 20px;
  color: #c7c7cc;
}
.zones {
  flex-shrink: 0;
  flex-direction: row;
  margin-top: 8px;
}
.zseg {
  flex-shrink: 0;
  width: 32px;
  height: 8px;
  margin-left: 3px;
  margin-right: 3px;
  border-radius: 4px;
}
.home-play {
  flex-shrink: 0;
  width: 140px;
  height: 140px;
  margin-top: 14px;
  border-radius: 70px;
  justify-content: center;
  align-items: center;
}
.home-play-idle {
  background-color: #30d158;
}
.home-play-run {
  background-color: #ff9f0a;
}
.home-play-press {
  opacity: 0.9;
}
.home-play-img {
  flex-shrink: 0;
  width: 64px;
  height: 64px;
}
.dial-hint {
  flex-shrink: 0;
  margin-top: 8px;
  width: 196px;
  text-align: center;
  font-size: 18px;
  color: #8e8e93;
}
.chip-row {
  flex-shrink: 0;
  width: 212px;
  flex-direction: row;
  justify-content: center;
  margin-top: 8px;
}
.chip {
  flex-shrink: 0;
  width: 92px;
  height: 56px;
  margin-left: 4px;
  margin-right: 4px;
  border-radius: 18px;
  background-color: #1c1c1e;
  border-width: 2px;
  border-color: #2c2c2e;
  justify-content: center;
  align-items: center;
}
.chip-on {
  border-color: #30d158;
}
.chip-t {
  flex-shrink: 0;
  font-size: 22px;
  font-weight: bold;
  color: #ffffff;
}
.offline {
  flex-shrink: 0;
  width: 212px;
  height: 520px;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.radar {
  flex-shrink: 0;
  width: 170px;
  height: 170px;
  justify-content: center;
  align-items: center;
}
.wave {
  flex-shrink: 0;
  width: 160px;
  height: 160px;
  border-radius: 80px;
  border-width: 3px;
  border-color: #ff3b5c;
  animation-name: wave;
  animation-duration: 2000ms;
  animation-iteration-count: infinite;
}
.wave2 {
  flex-shrink: 0;
  animation-delay: 1000ms;
}
.core {
  flex-shrink: 0;
  width: 86px;
  height: 86px;
  border-radius: 43px;
  background-color: #ff3b5c;
  justify-content: center;
  align-items: center;
}
.core-x {
  flex-shrink: 0;
  font-size: 46px;
  font-weight: bold;
  color: #ffffff;
}
.off-title {
  flex-shrink: 0;
  margin-top: 18px;
  font-size: 36px;
  font-weight: bold;
  color: #ffffff;
}
.off-sub {
  flex-shrink: 0;
  margin-top: 4px;
  width: 196px;
  text-align: center;
  font-size: 24px;
  color: #ff9f0a;
}
.off-hint {
  flex-shrink: 0;
  margin-top: 22px;
}
@keyframes wave {
  from {
    transform: scale(0.5);
    opacity: 1;
  }
  to {
    transform: scale(1.1);
    opacity: 0;
  }
}
</style>
