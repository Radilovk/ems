<template>
  <!-- home: one vertical scroll — heart rate, then a big card per module (Start first).
       Tap a card to open it; hold the heart rate to pause everything; swipe right = exit. -->
  <stack class="root bg-home">
    <scroll class="scr" scroll-y="true" if="{{!offline}}">
      <div class="col" style="height: {{colH}}px">
        <div class="hdr">
          <div class="hr-row">
            <image class="hr-heart" src="/common/icons/heart.png"></image>
            <text class="hr-big" style="color: {{hrColor}}">{{hrBig}}</text>
          </div>
          <text class="hr-sub">{{hrSub}}</text>
          <div class="zones">
            <div for="{{zoneBar}}" class="zseg" style="background-color: {{$item.c}}; opacity: {{$item.on ? 1 : 0.22}}"></div>
          </div>
        </div>
        <div for="{{cards}}" class="card" style="background-color: {{$item.bg}}; border-color: {{$item.border}}" onclick="open($item.id)">
          <div class="ic" style="background-color: {{$item.color}}">
            <image class="ic-img" src="{{$item.icon}}"></image>
          </div>
          <text class="ct">{{$item.title}}</text>
          <marquee class="cs" if="{{$item.long}}" scrollamount="30" loop="-1" style="color: {{$item.subColor}}">{{$item.sub}}</marquee>
          <text class="cs" if="{{!$item.long}}" style="color: {{$item.subColor}}">{{$item.sub}}</text>
        </div>
      </div>
    </scroll>

    <!-- not linked yet -->
    <div class="offline" if="{{offline}}">
      <stack class="radar">
        <div class="wave"></div>
        <div class="wave wave2"></div>
        <div class="core"><text class="core-x">X</text></div>
      </stack>
      <text class="off-title">XEMS</text>
      <text class="off-sub">{{offText}}</text>
      <text class="sub off-hint">Отвори XEMS на таблета</text>
      <text class="off-diag">{{diagText}}</text>
    </div>
  </stack>
</template>

<script>
import router from '@system.router'
import { ZONE, ACCENT, RED, GREEN, AMBER, PURPLE, mmss, hms, zoneOf, mods, bind, age } from '../../common/ui.js'

/** Card tint when a module runs (solid colours: Vela draws them best). */
const TINT = { train: '#0E2A17', ai: '#2E2607', timer: '#2E1F07', music: '#24122E', pulse: '#2E0F0D' }
const IDLE = '#16171B'
const PAGES = { ai: '/pages/ai', train: '/pages/train', timer: '/pages/timer', music: '/pages/music', pulse: '/pages/pulse' }

export default {
  private: {
    offline: true,
    offText: 'Свързване…',
    diagText: '',
    hrBig: '--',
    hrSub: '',
    hrColor: '#FFFFFF',
    zoneBar: [],
    busy: false,
    cards: [],
    cardsKey: '',
    colH: 900
  },

  onInit() {
    this.unbind = bind(this)
  },

  onDestroy() {
    this.unbind()
  },

  update() {
    const app = this.$app.$def
    const s = app.state
    const quiet = app.silence()
    if (!s || quiet > 12) {
      this.offline = true
      this.offText = quiet > 9000 ? 'Свързване…' : 'Връзката прекъсна'
      const d = app.diag || {}
      this.diagText = d.failed > 0 || d.err ? 'връзка: ' + d.link + (d.err ? ' · ' + d.err : '') : ''
      return
    }
    this.offline = false
    this.busy = app.busy()
    const lim = s.lim || 170
    const z = s.hr > 0 ? s.z || zoneOf(s.hr, lim) : 0
    this.hrBig = s.hr > 0 ? String(s.hr) : '--'
    this.hrSub = s.hr > 0 ? 'Z' + z + ' · лимит ' + lim : 'няма пулс'
    this.hrColor = s.hr > 0 ? ZONE[z] : '#8E8E93'
    const bar = []
    for (let k = 1; k <= 5; k++) {
      bar.push({ c: ZONE[k], on: z >= k })
    }
    this.zoneBar = bar

    const list = this.buildCards(s, app)
    // Redraw the cards only when something on them changed (keeps the scroll position still).
    const key = JSON.stringify(list)
    if (key !== this.cardsKey) {
      this.cardsKey = key
      this.cards = list
      // the scroll needs the real content height (children never shrink)
      this.colH = 190 + list.length * 208 + 60
    }
  },

  /** Start is always first; then the modules the licence opens (all when XEMS does not say). */
  buildCards(s, app) {
    const m = mods(s)
    const lic = s.lic || null
    const has = (id) => !lic || lic.indexOf(id) >= 0
    const ai = s.mode === 'ai'
    const out = []

    const trRun = !!m.tr.run && !ai
    out.push({
      id: 'train', title: 'Старт', icon: '/common/icons/bolt.png', color: GREEN, active: trRun,
      sub: trRun ? 'активен · ' + hms((s.el || 0) + age(app, true))
        : s.mode === 'manual' ? 'пауза · ' + hms(s.el || 0) : 'ръчна тренировка'
    })

    if (has('ai')) {
      let aiSub = 'умна сесия'
      if (ai) {
        aiSub = s.st === 'ready' ? 'почивката стига'
          : s.st === 'rest' ? 'почивка ' + mmss((s.rl || 0) - app.silence())
            : (s.ph || 'сесия') + ' · ' + mmss((s.pl || 0) - age(app, s.st === 'run'))
      }
      out.push({ id: 'ai', title: 'AI', icon: '/common/icons/ai.png', color: ACCENT, active: ai, sub: aiSub })
    }

    if (has('timer')) {
      const tm = m.tm
      let tmSub = 'интервали'
      if (tm.arm) {
        tmSub = tm.run ? mmss((tm.left || 0) - age(app, true)) + (tm.lbl ? ' · ' + tm.lbl : tm.loops > 0 ? ' · кръг ' + tm.loop + '/' + tm.loops : '')
          : tm.pau ? 'пауза · ' + mmss(tm.left || 0) : 'чака старт'
      }
      out.push({ id: 'timer', title: 'Таймер', icon: '/common/icons/timer.png', color: AMBER, active: !!tm.run, sub: tmSub })
    }

    if (has('music')) {
      const mu = m.mu
      out.push({
        id: 'music', title: 'Музика', icon: '/common/icons/music.png', color: PURPLE, active: !!mu.play,
        sub: mu.on ? (mu.title || 'музика') : 'импулси в такт'
      })
    }

    if (has('pulse')) {
      const hg = m.hg
      const hgSub = hg.ai ? 'AI управлява' : hg.en ? (hg.hold ? 'задържа силата' : 'сила ' + (hg.sf || 100) + '%') : 'сила по пулса'
      out.push({ id: 'pulse', title: 'Пулс', icon: '/common/icons/heart.png', color: RED, active: !!hg.en && !hg.ai, sub: hgSub })
    }

    out.forEach((c) => {
      c.bg = c.active ? TINT[c.id] : IDLE
      c.border = c.active ? c.color : '#26272C'
      c.subColor = c.active ? c.color : '#AEAEB2'
      c.long = c.sub.length > 14
    })
    return out
  },

  open(id) {
    this.$app.$def.buzz('short')
    router.push({ uri: PAGES[id] || PAGES.train })
  }
}
</script>

<style>
/* ---- common (scripts/gen-pages.py stamps this into every page) ---- */
.root {
  width: 212px;
  height: 520px;
  background-color: #000000;
}
.screen {
  width: 212px;
  height: 520px;
  flex-direction: column;
  align-items: center;
  padding-top: 46px;
}
.scr {
  width: 212px;
  height: 520px;
}
.col {
  flex-shrink: 0;
  width: 212px;
  flex-direction: column;
}
.in-up {
  animation-name: inUp;
  animation-duration: 260ms;
  animation-timing-function: ease-out;
}
.in-down {
  animation-name: inDown;
  animation-duration: 260ms;
  animation-timing-function: ease-out;
}
.dots {
  width: 16px;
  height: 520px;
  margin-left: 196px;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}
.pdot {
  width: 8px;
  height: 8px;
  margin-top: 4px;
  margin-bottom: 4px;
  border-radius: 4px;
  background-color: #3a3a3c;
}
.pdot-on {
  height: 22px;
  background-color: #ffffff;
}
.caps {
  flex-shrink: 0;
  font-size: 24px;
  font-weight: bold;
  color: #8e8e93;
}
.sub {
  flex-shrink: 0;
  width: 196px;
  text-align: center;
  font-size: 24px;
  color: #aeaeb2;
}
.down {
  transform: scale(0.92);
}
.btn {
  flex-shrink: 0;
  justify-content: center;
  align-items: center;
  transition-property: transform;
  transition-duration: 120ms;
}
.off {
  opacity: 0.3;
}
@keyframes inUp {
  from {
    transform: translateY(90px);
    opacity: 0;
  }
  to {
    transform: translateY(0px);
    opacity: 1;
  }
}
@keyframes inDown {
  from {
    transform: translateY(-90px);
    opacity: 0;
  }
  to {
    transform: translateY(0px);
    opacity: 1;
  }
}
@keyframes breathe {
  from {
    transform: scale(0.86);
    opacity: 0.9;
  }
  to {
    transform: scale(1.12);
    opacity: 0.2;
  }
}
@keyframes beat {
  from {
    transform: scale(1);
  }
  to {
    transform: scale(1.25);
  }
}
/* ---- page ---- */
.bg-home {
  flex-shrink: 0;
  background-image: url(/common/bg/home.png);
  background-size: cover;
}
.hdr {
  flex-shrink: 0;
  height: 190px;
  width: 212px;
  flex-direction: column;
  align-items: center;
  padding-top: 42px;
  padding-bottom: 6px;
}
.hr-row {
  flex-shrink: 0;
  flex-direction: row;
  align-items: center;
}
.hr-heart {
  flex-shrink: 0;
  width: 34px;
  height: 34px;
  margin-right: 8px;
}
.hr-big {
  flex-shrink: 0;
  font-size: 62px;
  font-weight: bold;
}
.hr-sub {
  flex-shrink: 0;
  width: 196px;
  text-align: center;
  font-size: 22px;
  color: #c7c7cc;
}
.zones {
  flex-shrink: 0;
  flex-direction: row;
  margin-top: 12px;
}
.zseg {
  flex-shrink: 0;
  width: 32px;
  height: 10px;
  margin-left: 3px;
  margin-right: 3px;
  border-radius: 5px;
}
.sync {
  flex-shrink: 0;
  margin-top: 8px;
  font-size: 20px;
  color: #ff9f0a;
}
.card {
  flex-shrink: 0;
  height: 196px;
  width: 196px;
  margin-left: 8px;
  margin-top: 12px;
  padding-top: 14px;
  flex-direction: column;
  align-items: center;
  border-radius: 30px;
  border-width: 3px;
}
.ic {
  flex-shrink: 0;
  width: 72px;
  height: 72px;
  border-radius: 36px;
  justify-content: center;
  align-items: center;
}
.ic-img {
  flex-shrink: 0;
  width: 42px;
  height: 42px;
}
.ct {
  flex-shrink: 0;
  margin-top: 8px;
  width: 180px;
  text-align: center;
  font-size: 32px;
  font-weight: bold;
  color: #ffffff;
  lines: 1;
}
.cs {
  flex-shrink: 0;
  margin-top: 4px;
  width: 170px;
  height: 34px;
  text-align: center;
  font-size: 24px;
  lines: 1;
}
.offline {
  flex-shrink: 0;
  width: 212px;
  height: 520px;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.radar {
  flex-shrink: 0;
  width: 170px;
  height: 170px;
  justify-content: center;
  align-items: center;
}
.wave {
  flex-shrink: 0;
  width: 160px;
  height: 160px;
  border-radius: 80px;
  border-width: 3px;
  border-color: #ff3b5c;
  animation-name: wave;
  animation-duration: 2000ms;
  animation-iteration-count: infinite;
}
.wave2 {
  flex-shrink: 0;
  animation-delay: 1000ms;
}
.core {
  flex-shrink: 0;
  width: 86px;
  height: 86px;
  border-radius: 43px;
  background-color: #ff3b5c;
  justify-content: center;
  align-items: center;
}
.core-x {
  flex-shrink: 0;
  font-size: 46px;
  font-weight: bold;
  color: #ffffff;
}
.off-title {
  flex-shrink: 0;
  margin-top: 18px;
  font-size: 36px;
  font-weight: bold;
  color: #ffffff;
}
.off-sub {
  flex-shrink: 0;
  margin-top: 4px;
  width: 196px;
  text-align: center;
  font-size: 24px;
  color: #ff9f0a;
}
.off-hint {
  flex-shrink: 0;
  margin-top: 22px;
}
.off-diag {
  flex-shrink: 0;
  margin-top: 14px;
  width: 196px;
  text-align: center;
  font-size: 20px;
  color: #48484a;
}
@keyframes wave {
  from {
    transform: scale(0.5);
    opacity: 1;
  }
  to {
    transform: scale(1.1);
    opacity: 0;
  }
}
</style>
