<template>
  <!-- one mode per screen; flick up / down between modes, tap anywhere to open, right = exit -->
  <stack class="root" onswipe="onSwipe">
    <div class="screen {{anim}}" if="{{!offline}}" onclick="open" onlongpress="pauseAll">
      <div class="hr-row">
        <image class="hr-heart" src="/common/icons/heart.png"></image>
        <text class="hr-line" style="color: {{hrColor}}">{{hrLine}}</text>
      </div>
      <stack class="icon-box">
        <div class="glow {{card.active ? 'breathe' : ''}}" style="background-color: {{card.glow}}"></div>
        <div class="icon" style="background-color: {{card.color}}">
          <image class="icon-img" src="{{card.icon}}"></image>
        </div>
      </stack>
      <text class="title">{{card.title}}</text>
      <text class="state" style="color: {{card.active ? card.color : '#AEAEB2'}}">{{card.sub}}</text>
      <text class="tap">докосни · влез</text>
    </div>

    <div class="dots" if="{{!offline}}">
      <div for="{{dots}}" class="pdot {{$item.on ? 'pdot-on' : ''}}"></div>
    </div>

    <!-- not linked yet -->
    <div class="offline" if="{{offline}}">
      <stack class="radar">
        <div class="wave"></div>
        <div class="wave wave2"></div>
        <div class="core"><text class="core-x">X</text></div>
      </stack>
      <text class="off-title">XEMS</text>
      <text class="off-sub">{{offText}}</text>
      <text class="sub off-hint">Отвори XEMS на таблета</text>
      <text class="off-diag">{{diagText}}</text>
    </div>
  </stack>
</template>

<script>
import router from '@system.router'
import { ZONE, ACCENT, GREEN, AMBER, BLUE, PURPLE, mmss, hms, zoneOf, mods, bind, age, setPages, swipe } from '../../common/ui.js'

const PAGES = { ai: '/pages/ai', train: '/pages/train', timer: '/pages/timer', music: '/pages/music', pulse: '/pages/pulse' }

export default {
  private: {
    offline: true,
    offText: 'Свързване…',
    diagText: '',
    hrLine: '',
    hrColor: '#FFFFFF',
    cards: {},
    card: { id: 'ai', title: 'AI', sub: '', icon: '/common/icons/ai.png', color: ACCENT, glow: 'rgba(0,0,0,0)', active: false },
    ids: [],
    idsKey: '',
    idx: 0,
    cur: '',
    dots: [],
    anim: ''
  },

  onInit() {
    this.unbind = bind(this)
  },

  onDestroy() {
    this.unbind()
  },

  onSwipe(e) {
    swipe(this, e)
    this.card = this.cards[this.cur] || this.card
  },

  update() {
    const app = this.$app.$def
    const s = app.state
    const quiet = app.silence()
    if (!s || quiet > 12) {
      this.offline = true
      this.offText = quiet > 9000 ? 'Свързване…' : 'Връзката прекъсна'
      const d = app.diag || {}
      this.diagText = d.failed > 0 || d.err ? 'връзка: ' + d.link + (d.err ? ' · ' + d.err : '') : ''
      return
    }
    this.offline = false
    const z = s.hr > 0 ? s.z || zoneOf(s.hr, s.lim || 170) : 0
    this.hrLine = s.hr > 0 ? s.hr + ' · Z' + z : '--'
    this.hrColor = s.hr > 0 ? ZONE[z] : '#8E8E93'

    const list = this.buildCards(s, app)
    const cards = {}
    list.forEach((c) => {
      cards[c.id] = c
    })
    this.cards = cards
    // running modes first; the order is kept while you look at one (no jumping under the finger)
    const ids = list.filter((c) => c.active).concat(list.filter((c) => !c.active)).map((c) => c.id)
    if (!this.idsKey || this.cur === '') {
      setPages(this, ids)
    } else {
      setPages(this, this.ids.length === ids.length ? this.ids : ids)
    }
    this.card = cards[this.cur] || list[0]
  },

  buildCards(s, app) {
    const m = mods(s)
    const ai = s.mode === 'ai'
    const out = []

    let aiSub = 'стартира се от таблета'
    if (ai) {
      aiSub = s.st === 'ready' ? 'почивката стига'
        : s.st === 'rest' ? 'почивка ' + mmss((s.rl || 0) - app.silence())
          : (s.ph || 'сесия') + ' · ' + mmss((s.pl || 0) - age(app, s.st === 'run'))
    }
    out.push({ id: 'ai', title: 'AI сесия', sub: aiSub, icon: '/common/icons/ai.png', color: ACCENT, active: ai })

    const trRun = !!m.tr.run && !ai
    out.push({
      id: 'train', title: 'Тренировка',
      sub: trRun ? 'тече · ' + hms((s.el || 0) + age(app, true)) : s.mode === 'manual' ? 'пауза · ' + hms(s.el || 0) : 'ръчно управление',
      icon: '/common/icons/bolt.png', color: GREEN, active: trRun
    })

    const tm = m.tm
    let tmSub = 'не е включен'
    if (tm.arm) {
      tmSub = tm.run ? mmss((tm.left || 0) - age(app, true)) + (tm.lbl ? ' · ' + tm.lbl : tm.loops > 0 ? ' · кръг ' + tm.loop + '/' + tm.loops : '')
        : tm.pau ? 'пауза · ' + mmss(tm.left || 0) : 'чака старт'
    }
    out.push({ id: 'timer', title: 'Таймер', sub: tmSub, icon: '/common/icons/timer.png', color: AMBER, active: !!tm.run })

    const mu = m.mu
    out.push({
      id: 'music', title: 'Музика', sub: mu.on ? (mu.title || 'музика') : 'изключена',
      icon: '/common/icons/music.png', color: PURPLE, active: !!mu.play
    })

    const hg = m.hg
    const hgSub = hg.ai ? 'AI управлява' : hg.en ? (hg.hold ? 'задържа силата' : 'сила ' + (hg.sf || 100) + '%') : 'автоконтрол изкл.'
    out.push({ id: 'pulse', title: 'Пулс', sub: hgSub, icon: '/common/icons/heart.png', color: BLUE, active: !!hg.en && !hg.ai })

    out.forEach((c) => {
      c.glow = c.active ? c.color : 'rgba(0,0,0,0)'
    })
    return out
  },

  open() {
    this.$app.$def.buzz('short')
    router.push({ uri: PAGES[this.cur] || PAGES.ai })
  },

  pauseAll() {
    this.$app.$def.send({ t: 'cmd', a: 'pause_all' })
    this.$app.$def.buzz('long')
  }
}
</script>

<style>
/* ---- common (tools/gen-pages.py stamps this into every page) ---- */
.root {
  width: 212px;
  height: 520px;
  background-color: #000000;
}
.screen {
  width: 212px;
  height: 520px;
  flex-direction: column;
  align-items: center;
  padding-top: 34px;
  background-color: #000000;
}
.in-up {
  animation-name: inUp;
  animation-duration: 260ms;
  animation-timing-function: ease-out;
}
.in-down {
  animation-name: inDown;
  animation-duration: 260ms;
  animation-timing-function: ease-out;
}
.dots {
  width: 16px;
  height: 520px;
  margin-left: 196px;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}
.pdot {
  width: 8px;
  height: 8px;
  margin-top: 4px;
  margin-bottom: 4px;
  border-radius: 4px;
  background-color: #3a3a3c;
}
.pdot-on {
  height: 22px;
  background-color: #ffffff;
}
.caps {
  font-size: 22px;
  font-weight: bold;
  color: #8e8e93;
}
.sub {
  width: 196px;
  text-align: center;
  font-size: 22px;
  color: #aeaeb2;
}
.down {
  transform: scale(0.92);
}
.btn {
  justify-content: center;
  align-items: center;
  transition-property: transform;
  transition-duration: 120ms;
}
.off {
  opacity: 0.3;
}
@keyframes inUp {
  from {
    transform: translateY(90px);
    opacity: 0;
  }
  to {
    transform: translateY(0px);
    opacity: 1;
  }
}
@keyframes inDown {
  from {
    transform: translateY(-90px);
    opacity: 0;
  }
  to {
    transform: translateY(0px);
    opacity: 1;
  }
}
@keyframes breathe {
  from {
    transform: scale(0.86);
    opacity: 0.9;
  }
  to {
    transform: scale(1.12);
    opacity: 0.2;
  }
}
@keyframes beat {
  from {
    transform: scale(1);
  }
  to {
    transform: scale(1.25);
  }
}

/* ---- page ---- */
.hr-row {
  flex-direction: row;
  align-items: center;
}
.hr-heart {
  width: 26px;
  height: 26px;
  margin-right: 8px;
}
.hr-line {
  font-size: 26px;
  font-weight: bold;
}
.icon-box {
  width: 176px;
  height: 176px;
  margin-top: 26px;
  justify-content: center;
  align-items: center;
}
.glow {
  width: 170px;
  height: 170px;
  border-radius: 85px;
  opacity: 0.35;
}
.icon {
  width: 136px;
  height: 136px;
  border-radius: 68px;
  justify-content: center;
  align-items: center;
}
.icon-img {
  width: 76px;
  height: 76px;
}
.title {
  margin-top: 22px;
  font-size: 36px;
  font-weight: bold;
  color: #ffffff;
}
.state {
  margin-top: 6px;
  width: 196px;
  text-align: center;
  font-size: 24px;
  lines: 2;
  text-overflow: ellipsis;
}
.tap {
  margin-top: 24px;
  font-size: 20px;
  color: #48484a;
}
.offline {
  width: 212px;
  height: 520px;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background-color: #000000;
}
.radar {
  width: 170px;
  height: 170px;
  justify-content: center;
  align-items: center;
}
.wave {
  width: 160px;
  height: 160px;
  border-radius: 80px;
  border-width: 3px;
  border-color: #ff3b5c;
  animation-name: wave;
  animation-duration: 2000ms;
  animation-iteration-count: infinite;
}
.wave2 {
  animation-delay: 1000ms;
}
.core {
  width: 86px;
  height: 86px;
  border-radius: 43px;
  background-color: #ff3b5c;
  justify-content: center;
  align-items: center;
}
.core-x {
  font-size: 46px;
  font-weight: bold;
  color: #ffffff;
}
.off-title {
  margin-top: 18px;
  font-size: 36px;
  font-weight: bold;
  color: #ffffff;
}
.off-sub {
  margin-top: 4px;
  font-size: 22px;
  color: #ff9f0a;
}
.off-hint {
  margin-top: 22px;
}
.off-diag {
  margin-top: 14px;
  width: 196px;
  text-align: center;
  font-size: 18px;
  color: #48484a;
}
@keyframes wave {
  from {
    transform: scale(0.5);
    opacity: 1;
  }
  to {
    transform: scale(1.1);
    opacity: 0;
  }
}
</style>
