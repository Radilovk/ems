}
.peek {
  position: absolute;
  width: 196px;
  text-align: center;
  font-size: 18px;
  color: #3a3a3c;
  lines: 1;
  text-overflow: ellipsis;
}
.peek-up {
  top: 8px;
}
.peek-down {
  bottom: 12px;
}
.offline {
  width: 212px;
  height: 520px;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background-color: #000000;
}
.radar {
