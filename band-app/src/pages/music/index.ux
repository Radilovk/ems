<template>
  <stack class="root bg-music" onswipe="onSwipe">
    <!-- 1 · play / pause -->
    <div class="screen {{anim}}" if="{{cur === 'main'}}">
      <text class="caps" style="color: {{capsColor}}">{{caps}}</text>
      <marquee class="title" scrollamount="40" loop="-1">{{title}}</marquee>
      <stack class="ring-box">
        <progress class="ring" type="arc" percent="{{pct}}" style="color: #BF5AF2"></progress>
        <div class="center">
          <div class="btn play {{pressed === 'play' ? 'down' : ''}}" style="background-color: {{play ? '#2C2C2E' : '#BF5AF2'}}"
               ontouchstart="press('play')" ontouchend="release" ontouchcancel="release" onclick="toggle">
            <image class="play-img" src="{{play ? '/common/icons/pause.png' : '/common/icons/play.png'}}"></image>
          </div>
        </div>
      </stack>
      <text class="sub">{{timeText}}</text>
    </div>

    <!-- 2 · previous / next -->
    <div class="screen {{anim}}" if="{{cur === 'skip'}}">
      <text class="caps">ПЕСЕН</text>
      <div class="btn big-pill {{pressed === 'next' ? 'down' : ''}}"
           ontouchstart="press('next')" ontouchend="release" ontouchcancel="release" onclick="next">
        <image class="pill-img" src="/common/icons/next.png"></image>
      </div>
      <div class="btn big-pill {{pressed === 'prev' ? 'down' : ''}}"
           ontouchstart="press('prev')" ontouchend="release" ontouchcancel="release" onclick="prev">
        <image class="pill-img" src="/common/icons/prev.png"></image>
      </div>
      <text class="sub">следваща · предишна</text>
    </div>

    <!-- 3 · impulses follow the music: ceiling -->
    <div class="screen {{anim}}" if="{{cur === 'ceil'}}">
      <text class="caps">ТАВАН</text>
      <text class="ceil-num">{{ceil}}</text>
      <div class="lvl-track">
        <div class="lvl-fill" style="width: {{lvl * 1.8}}px"></div>
      </div>
      <div class="pair">
        <div class="btn round {{pressed === 'down' ? 'down' : ''}}"
             ontouchstart="press('down')" ontouchend="release" ontouchcancel="release" onclick="ceilDown">
          <image class="round-img" src="/common/icons/minus.png"></image>
        </div>
        <div class="btn round round-plus {{pressed === 'up' ? 'down' : ''}}"
             ontouchstart="press('up')" ontouchend="release" ontouchcancel="release" onclick="ceilUp">
          <image class="round-img" src="/common/icons/plus.png"></image>
        </div>
      </div>
    </div>

    <div class="dots">
      <div for="{{dots}}" class="pdot {{$item.on ? 'pdot-on' : ''}}"></div>
    </div>
  </stack>
</template>

<script>
import { PURPLE, mmss, mods, bind, shown, setPages, swipe } from '../../common/ui.js'

export default {
  private: {
    ids: [],
    idsKey: '',
    idx: 0,
    cur: 'main',
    dots: [],
    anim: '',
    caps: 'МУЗИКА',
    capsColor: '#8E8E93',
    title: '—',
    pct: 0,
    play: false,
    timeText: '',
    lvl: 0,
    ceil: 0,
    pressed: ''
  },

  onInit() {
    this.unbind = bind(this, 'music')
  },

  onShow() {
    shown(this, true)
  },

  onHide() {
    shown(this, false)
  },

  onDestroy() {
    this.unbind()
  },

  onSwipe(e) {
    swipe(this, e)
  },

  update() {
    const app = this.$app.$def
    const s = app.state
    if (!s) {
      setPages(this, ['main'])
      return
    }
    const mu = mods(s).mu
    setPages(this, mu.on ? ['main', 'skip', 'ceil'] : ['main', 'skip'])
    this.play = !!mu.play
    this.caps = mu.on && !mu.play ? 'ПАУЗА' : 'МУЗИКА'
    this.capsColor = mu.play ? PURPLE : '#8E8E93'
    this.title = mu.title || (mu.on ? 'музика' : 'пусни от таблета')
    const pos = (mu.pos || 0) + (mu.play ? app.silence() : 0)
    this.pct = mu.dur > 0 ? Math.min(100, Math.round((pos / mu.dur) * 100)) : 0
    this.timeText = mu.dur > 0 ? mmss(pos) + ' / ' + mmss(mu.dur) : ''
    this.lvl = Math.max(0, Math.min(100, mu.lvl || 0))
    this.ceil = mu.ceil || 0
  },

  press(w) {
    this.pressed = w
  },

  release() {
    this.pressed = ''
  },

  toggle() {
    this.play = !this.play
    this.$app.$def.command('mu_toggle')
  },

  prev() {
    this.$app.$def.command('mu_prev')
  },

  next() {
    this.$app.$def.command('mu_next')
  },

  ceilUp() {
    this.$app.$def.command('mu_up')
  },

  ceilDown() {
    this.$app.$def.command('mu_down')
  }
}
</script>

<style>
/* ---- common (scripts/gen-pages.py stamps this into every page) ---- */
.root {
  width: 212px;
  height: 520px;
  background-color: #000000;
}
.screen {
  width: 212px;
  height: 520px;
  flex-direction: column;
  align-items: center;
  padding-top: 46px;
}
.scr {
  width: 212px;
  height: 520px;
}
.col {
  flex-shrink: 0;
  width: 212px;
  flex-direction: column;
}
.in-up {
  animation-name: inUp;
  animation-duration: 260ms;
  animation-timing-function: ease-out;
}
.in-down {
  animation-name: inDown;
  animation-duration: 260ms;
  animation-timing-function: ease-out;
}
.dots {
  width: 16px;
  height: 520px;
  margin-left: 196px;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}
.pdot {
  width: 8px;
  height: 8px;
  margin-top: 4px;
  margin-bottom: 4px;
  border-radius: 4px;
  background-color: #3a3a3c;
}
.pdot-on {
  height: 22px;
  background-color: #ffffff;
}
.caps {
  flex-shrink: 0;
  font-size: 24px;
  font-weight: bold;
  color: #8e8e93;
}
.sub {
  flex-shrink: 0;
  width: 196px;
  text-align: center;
  font-size: 24px;
  color: #aeaeb2;
}
.down {
  transform: scale(0.92);
}
.btn {
  flex-shrink: 0;
  justify-content: center;
  align-items: center;
  transition-property: transform;
  transition-duration: 120ms;
}
.off {
  opacity: 0.3;
}
@keyframes inUp {
  from {
    transform: translateY(90px);
    opacity: 0;
  }
  to {
    transform: translateY(0px);
    opacity: 1;
  }
}
@keyframes inDown {
  from {
    transform: translateY(-90px);
    opacity: 0;
  }
  to {
    transform: translateY(0px);
    opacity: 1;
  }
}
@keyframes breathe {
  from {
    transform: scale(0.86);
    opacity: 0.9;
  }
  to {
    transform: scale(1.12);
    opacity: 0.2;
  }
}
@keyframes beat {
  from {
    transform: scale(1);
  }
  to {
    transform: scale(1.25);
  }
}
/* ---- page ---- */
.bg-music {
  background-image: url(/common/bg/music.png);
  background-size: cover;
}
.title {
  width: 190px;
  height: 40px;
  margin-top: 10px;
  font-size: 28px;
  font-weight: bold;
  color: #ffffff;
}
.ring-box {
  width: 196px;
  height: 196px;
  margin-top: 14px;
}
.ring {
  width: 196px;
  height: 196px;
  stroke-width: 12px;
  background-color: #1c1c1e;
  start-angle: 0deg;
  total-angle: 360deg;
  center-x: 98px;
  center-y: 98px;
  radius: 90px;
}
.center {
  width: 196px;
  height: 196px;
  justify-content: center;
  align-items: center;
}
.play {
  width: 140px;
  height: 140px;
  border-radius: 70px;
}
.play-img {
  width: 64px;
  height: 64px;
}
.sub {
  margin-top: 14px;
}
.big-pill {
  width: 180px;
  height: 130px;
  margin-top: 16px;
  border-radius: 65px;
  background-color: #2c2c2e;
}
.pill-img {
  width: 56px;
  height: 56px;
}
.ceil-num {
  margin-top: 16px;
  font-size: 90px;
  font-weight: bold;
  color: #ffffff;
}
.lvl-track {
  width: 180px;
  height: 12px;
  border-radius: 6px;
  background-color: #2c2c2e;
}
.lvl-fill {
  height: 12px;
  border-radius: 6px;
  background-color: #bf5af2;
  transition-property: width;
  transition-duration: 300ms;
}
.pair {
  flex-direction: row;
  margin-top: 40px;
}
.round {
  width: 98px;
  height: 98px;
  margin-left: 4px;
  margin-right: 4px;
  border-radius: 49px;
  background-color: #2c2c2e;
}
.round-plus {
  background-color: #3a1f4a;
}
.round-img {
  width: 44px;
  height: 44px;
}
</style>
