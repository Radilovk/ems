<template>
  <stack class="root" onswipe="onSwipe">
    <div class="screen {{anim}}" if="{{cur === 'main'}}">
      <div class="ambient" style="background: linear-gradient(180deg, rgba(191,90,242,0.22) 0%, rgba(0,0,0,0) 100%)"></div>
      <div class="ambient-fade"></div>
      <text class="chip-outline" style="color: {{capsColor}}; border-color: {{capsColor}}">{{caps}}</text>
      <marquee class="title" scrollamount="40" loop="-1">{{title}}</marquee>
      <stack class="ring-box music-ring">
        <div class="ring-glow {{play ? 'breathe' : ''}}" style="width: 196px; height: 196px; background-color: rgba(191,90,242,0.28)"></div>
        <progress class="ring ring-track" type="arc" percent="{{pct}}" style="color: #BF5AF2"></progress>
        <div class="center">
          <div class="btn play btn-primary {{pressed === 'play' ? 'down' : ''}}"
               style="width: 132px; height: 132px; border-radius: 66px; background: linear-gradient(180deg, {{play ? '#2C2C2E' : '#BF5AF2'}} 0%, {{play ? '#1C1C1E' : '#8E44C9'}} 100%)"
               ontouchstart="press('play')" ontouchend="release" ontouchcancel="release" onclick="toggle">
            <div class="btn-shine"></div>
            <image class="play-img" src="{{play ? '/common/icons/pause.png' : '/common/icons/play.png'}}" style="width: 60px; height: 60px"></image>
          </div>
        </div>
      </stack>
      <text class="sub">{{timeText}}</text>
    </div>

    <div class="screen {{anim}}" if="{{cur === 'skip'}}">
      <text class="caps">ПЕСЕН</text>
      <div class="btn btn-pill {{pressed === 'next' ? 'down' : ''}}"
           style="margin-top: 28px; height: 118px; background: linear-gradient(180deg, #3a1f4a 0%, #2c1838 100%)"
           ontouchstart="press('next')" ontouchend="release" ontouchcancel="release" onclick="next">
        <image class="pill-img" src="/common/icons/next.png"></image>
      </div>
      <div class="btn btn-pill {{pressed === 'prev' ? 'down' : ''}}"
           style="height: 118px"
           ontouchstart="press('prev')" ontouchend="release" ontouchcancel="release" onclick="prev">
        <image class="pill-img" src="/common/icons/prev.png"></image>
      </div>
      <text class="sub">следваща · предишна</text>
    </div>

    <div class="screen {{anim}}" if="{{cur === 'ceil'}}">
      <text class="caps">ТАВАН НА ИМПУЛСИТЕ</text>
      <text class="ceil-num">{{ceil}}</text>
      <div class="lvl-track">
        <div class="lvl-fill" style="width: {{lvl * 1.8}}px"></div>
      </div>
      <div class="pair ceil-pair">
        <div class="btn round {{pressed === 'down' ? 'down' : ''}}"
             ontouchstart="press('down')" ontouchend="release" ontouchcancel="release" onclick="ceilDown">
          <image class="round-img" src="/common/icons/minus.png"></image>
        </div>
        <div class="btn round round-plus {{pressed === 'up' ? 'down' : ''}}"
             ontouchstart="press('up')" ontouchend="release" ontouchcancel="release" onclick="ceilUp">
          <image class="round-img" src="/common/icons/plus.png"></image>
        </div>
      </div>
    </div>

    <div class="dots">
      <div for="{{dots}}" class="pdot {{$item.on ? 'pdot-on' : ''}}" style="background-color: {{$item.on ? dotAccent : '#3A3A3C'}}"></div>
    </div>
  </stack>
</template>

<script>
import { PURPLE, mmss, mods, bind, setPages, swipe } from '../../common/ui.js'

export default {
  private: {
    ids: [],
    idsKey: '',
    idx: 0,
    cur: 'main',
    dots: [],
    dotAccent: PURPLE,
    anim: '',
    caps: 'МУЗИКА',
    capsColor: '#8E8E93',
    title: '—',
    pct: 0,
    play: false,
    timeText: '',
    lvl: 0,
    ceil: 0,
    pressed: ''
  },

  onInit() {
    this.unbind = bind(this)
  },

  onDestroy() {
    this.unbind()
  },

  onSwipe(e) {
    swipe(this, e)
  },

  update() {
    const app = this.$app.$def
    const s = app.state
    if (!s) {
      setPages(this, ['main'], PURPLE)
      return
    }
    const mu = mods(s).mu
    setPages(this, mu.on ? ['main', 'skip', 'ceil'] : ['main', 'skip'], PURPLE)
    this.play = !!mu.play
    this.caps = mu.on && !mu.play ? 'МУЗИКА · ПАУЗА' : 'МУЗИКА'
    this.capsColor = mu.play ? PURPLE : '#8E8E93'
    this.title = mu.title || (mu.on ? 'музика' : 'пусни от таблета')
    const pos = (mu.pos || 0) + (mu.play ? app.silence() : 0)
    this.pct = mu.dur > 0 ? Math.min(100, Math.round((pos / mu.dur) * 100)) : 0
    this.timeText = mu.dur > 0 ? mmss(pos) + ' / ' + mmss(mu.dur) : ''
    this.lvl = Math.max(0, Math.min(100, mu.lvl || 0))
    this.ceil = mu.ceil || 0
  },

  press(w) { this.pressed = w },
  release() { this.pressed = '' },
  toggle() { this.play = !this.play; this.$app.$def.command('mu_toggle') },
  prev() { this.$app.$def.command('mu_prev') },
  next() { this.$app.$def.command('mu_next') },
  ceilUp() { this.$app.$def.command('mu_up') },
  ceilDown() { this.$app.$def.command('mu_down') }
}
</script>

<style>
/* ---- common (scripts/gen-pages.py stamps this into every page) ---- */
/* XEMS Band v4 — shared design system (212 × 520 AMOLED) */
