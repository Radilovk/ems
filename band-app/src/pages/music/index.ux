<template>
  <stack class="root bg-music" onswipe="onSwipe">
    <!-- 1 · play / pause -->
    <div class="screen {{anim}}" if="{{cur === 'main'}}">
      <text class="caps" style="color: {{capsColor}}">{{caps}}</text>
      <div class="mid">
        <marquee class="title" scrollamount="40" loop="-1">{{title}}</marquee>
        <stack class="ring-box">
          <image class="halo" if="{{play}}" src="/common/art/glow-music.png"></image>
          <progress class="ring" type="arc" percent="{{pct}}" style="color: #B44DFF"></progress>
          <div class="center">
            <div class="btn play {{pressed === 'play' ? 'down' : ''}}" style="background-color: {{play ? '#222532' : '#B44DFF'}}"
                 ontouchstart="press('play')" ontouchend="release" ontouchcancel="release" onclick="toggle">
              <image class="play-img" src="{{play ? '/common/icons/pause.png' : '/common/icons/play.png'}}"></image>
            </div>
          </div>
        </stack>
        <text class="sub">{{timeText}}</text>
      </div>
    </div>

    <!-- 2 · previous / next -->
    <div class="screen {{anim}}" if="{{cur === 'skip'}}">
      <text class="caps">ПЕСЕН</text>
      <div class="mid">
        <div class="btn big-pill {{pressed === 'next' ? 'down' : ''}}"
             ontouchstart="press('next')" ontouchend="release" ontouchcancel="release" onclick="next">
          <image class="pill-img" src="/common/icons/next.png"></image>
        </div>
        <div class="btn big-pill {{pressed === 'prev' ? 'down' : ''}}"
             ontouchstart="press('prev')" ontouchend="release" ontouchcancel="release" onclick="prev">
          <image class="pill-img" src="/common/icons/prev.png"></image>
        </div>
        <text class="sub">следваща · предишна</text>
      </div>
    </div>

    <!-- 3 · impulses follow the music: ceiling -->
    <div class="screen {{anim}}" if="{{cur === 'ceil'}}">
      <text class="caps">ТАВАН</text>
      <div class="mid">
        <text class="ceil-num">{{ceil}}</text>
        <div class="lvl-track">
          <div class="lvl-fill" style="width: {{lvlW}}px"></div>
        </div>
        <div class="pair">
          <div class="btn round {{pressed === 'down' ? 'down' : ''}}"
               ontouchstart="press('down')" ontouchend="release" ontouchcancel="release" onclick="ceilDown">
            <image class="round-img" src="/common/icons/minus.png"></image>
          </div>
          <div class="btn round round-plus {{pressed === 'up' ? 'down' : ''}}"
               ontouchstart="press('up')" ontouchend="release" ontouchcancel="release" onclick="ceilUp">
            <image class="round-img" src="/common/icons/plus.png"></image>
          </div>
        </div>
      </div>
    </div>

    <div class="dots">
      <div for="{{dots}}" class="pdot {{$item.on ? 'pdot-on' : ''}}"></div>
    </div>
  </stack>
</template>

<script>
import { PURPLE, mmss, mods, bind, shown, setPages, swipe } from '../../common/ui.js'

export default {
  private: {
    ids: [],
    idsKey: '',
    idx: 0,
    cur: 'main',
    dots: [],
    anim: '',
    caps: 'МУЗИКА',
    capsColor: '#8C93AB',
    title: '—',
    pct: 0,
    play: false,
    timeText: '',
    lvlW: 0,
    ceil: 0,
    pressed: ''
  },

  onInit() {
    this.unbind = bind(this, 'music')
  },

  onShow() {
    shown(this, true)
  },

  onHide() {
    shown(this, false)
  },

  onDestroy() {
    this.unbind()
  },

  onSwipe(e) {
    swipe(this, e)
  },

  update() {
    const app = this.$app.$def
    const s = app.state
    if (!s) {
      setPages(this, ['main'])
      return
    }
    const mu = mods(s).mu
    setPages(this, mu.on ? ['main', 'skip', 'ceil'] : ['main', 'skip'])
    this.play = !!mu.play
    this.caps = mu.on && !mu.play ? 'ПАУЗА' : 'МУЗИКА'
    this.capsColor = mu.play ? PURPLE : '#8C93AB'
    this.title = mu.title || (mu.on ? 'музика' : 'пусни от таблета')
    const pos = (mu.pos || 0) + (mu.play ? app.silence() : 0)
    this.pct = mu.dur > 0 ? Math.min(100, Math.round((pos / mu.dur) * 100)) : 0
    this.timeText = mu.dur > 0 ? mmss(pos) + ' / ' + mmss(mu.dur) : ''
    // whole pixels: the music level moves every message; sub-pixel widths only cost redraws
    this.lvlW = Math.round(Math.max(0, Math.min(100, mu.lvl || 0)) * 1.8)
    this.ceil = mu.ceil || 0
  },

  press(w) {
    this.pressed = w
  },

  release() {
    this.pressed = ''
  },

  toggle() {
    this.play = !this.play
    this.$app.$def.command('mu_toggle')
  },

  prev() {
    this.$app.$def.command('mu_prev')
  },

  next() {
    this.$app.$def.command('mu_next')
  },

  ceilUp() {
    this.$app.$def.command('mu_up')
  },

  ceilDown() {
    this.$app.$def.command('mu_down')
  }
}
</script>

<style>
/* ---- common (scripts/gen-pages.py stamps this into every page) ---- */
.root {
  width: 212px;
  height: 520px;
  background-color: #000000;
}
.screen {
  width: 212px;
  height: 520px;
  flex-direction: column;
  align-items: center;
  padding-top: 46px;
}
.scr {
  width: 212px;
  height: 520px;
}
.col {
  flex-shrink: 0;
  width: 212px;
  flex-direction: column;
}
.in-up {
  animation-name: inUp;
  animation-duration: 260ms;
  animation-timing-function: ease-out;
}
.in-down {
  animation-name: inDown;
  animation-duration: 260ms;
  animation-timing-function: ease-out;
}
/* body under the title: fills the rest of the screen, content centred (no empty bottom half) */
.mid {
  flex-grow: 1;
  width: 212px;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-bottom: 34px;
}
.dots {
  width: 10px;
  height: 520px;
  margin-left: 202px;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}
.pdot {
  width: 6px;
  height: 6px;
  margin-top: 3px;
  margin-bottom: 3px;
  border-radius: 3px;
  background-color: #3A3F55;
}
.pdot-on {
  height: 18px;
  background-color: #ffffff;
}
.caps {
  flex-shrink: 0;
  height: 30px;
  font-size: 22px;
  font-weight: bold;
  color: #8C93AB;
}
.sub {
  flex-shrink: 0;
  width: 196px;
  text-align: center;
  font-size: 24px;
  color: #ADB3C7;
}
.down {
  transform: scale(0.92);
}
.btn {
  flex-shrink: 0;
  justify-content: center;
  align-items: center;
  transition-property: transform;
  transition-duration: 120ms;
}
.off {
  opacity: 0.3;
}
/* on / off switch: track + knob (one tap target, 150 × 84) */
.switch {
  flex-shrink: 0;
  width: 150px;
  height: 84px;
  padding-left: 8px;
  padding-right: 8px;
  border-radius: 42px;
  flex-direction: row;
  align-items: center;
  justify-content: flex-start;
  background-color: #2D3142;
  transition-property: transform;
  transition-duration: 120ms;
}
.switch-on {
  justify-content: flex-end;
}
.knob {
  flex-shrink: 0;
  width: 68px;
  height: 68px;
  border-radius: 34px;
  background-color: #ffffff;
}
.state {
  flex-shrink: 0;
  margin-bottom: 18px;
  font-size: 44px;
  font-weight: bold;
}
/* number tiles (2 per row) */
.tiles {
  flex-shrink: 0;
  flex-direction: row;
  margin-top: 8px;
}
.tile {
  flex-shrink: 0;
  width: 88px;
  height: 84px;
  margin-left: 4px;
  margin-right: 4px;
  border-radius: 22px;
  border-width: 1px;
  border-color: #222532;
  background-color: #15171F;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}
.tile-num {
  flex-shrink: 0;
  font-size: 34px;
  font-weight: bold;
  color: #ffffff;
}
.tile-lbl {
  flex-shrink: 0;
  font-size: 18px;
  color: #8C93AB;
}
.t-max {
  color: #FF2E63;
}
.t-kcal {
  color: #FF8A1F;
}
/* time in heart-rate zones: one bar, a segment per zone */
.zstack {
  flex-shrink: 0;
  width: 184px;
  height: 14px;
  margin-top: 16px;
  border-radius: 7px;
  flex-direction: row;
  background-color: #15171F;
}
.zpart {
  height: 14px;
}
@keyframes inUp {
  from {
    transform: translateY(90px);
    opacity: 0;
  }
  to {
    transform: translateY(0px);
    opacity: 1;
  }
}
@keyframes inDown {
  from {
    transform: translateY(-90px);
    opacity: 0;
  }
  to {
    transform: translateY(0px);
    opacity: 1;
  }
}
/* ---- page ---- */
.bg-music {
  background-image: url(/common/bg/music.png);
  background-size: cover;
}
.title {
  width: 184px;
  height: 40px;
  font-size: 28px;
  font-weight: bold;
  color: #ffffff;
}
.ring-box {
  width: 196px;
  height: 196px;
  margin-top: 10px;
}
.ring {
  width: 196px;
  height: 196px;
  stroke-width: 12px;
  background-color: #15171F;
  start-angle: 0deg;
  total-angle: 360deg;
  center-x: 98px;
  center-y: 98px;
  radius: 90px;
}
.center {
  width: 196px;
  height: 196px;
  justify-content: center;
  align-items: center;
}
.halo {
  width: 196px;
  height: 196px;
}
/* colour from CSS (play / pause changes only that), light layer on top */
.play {
  background-image: url(/common/art/shine-140.png);
  background-size: contain;
  width: 140px;
  height: 140px;
  border-radius: 70px;
}
.play-img {
  width: 64px;
  height: 64px;
}
.sub {
  margin-top: 14px;
}
.big-pill {
  width: 180px;
  height: 120px;
  margin-bottom: 14px;
  border-radius: 65px;
  background-color: #222532;
}
.pill-img {
  width: 56px;
  height: 56px;
}
.ceil-num {
  font-size: 90px;
  font-weight: bold;
  color: #ffffff;
}
.lvl-track {
  width: 180px;
  height: 12px;
  border-radius: 6px;
  background-color: #222532;
}
.lvl-fill {
  height: 12px;
  border-radius: 6px;
  background-color: #B44DFF;
  transition-property: width;
  transition-duration: 300ms;
}
.pair {
  flex-direction: row;
  margin-top: 30px;
}
.round {
  width: 98px;
  height: 98px;
  margin-left: 4px;
  margin-right: 4px;
  border-radius: 49px;
  background-color: #222532;
}
.round-plus {
  background-color: #361457;
}
.round-img {
  width: 44px;
  height: 44px;
}
</style>
