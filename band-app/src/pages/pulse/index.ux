<template>
  <stack class="root bg-pulse" onswipe="onSwipe">
    <!-- 1 · heart rate -->
    <div class="screen {{anim}}" if="{{cur === 'hr'}}">
      <text class="caps pulse-caps">ПУЛС</text>
      <div class="mid">
        <image class="heart" src="/common/art/heart-40.png"></image>
        <text class="hr" style="color: {{zoneColor}}">{{hrText}}</text>
        <div class="zones">
          <div for="{{zoneBars}}" class="zseg {{$item.on ? 'zseg-on' : ''}}" style="background-color: {{$item.c}}"></div>
        </div>
        <text class="sub">лимит {{limit}}{{pctText}}</text>
      </div>
    </div>

    <!-- 2 · auto control on / off -->
    <div class="screen {{anim}}" if="{{cur === 'auto'}}">
      <text class="caps">КОНТРОЛ</text>
      <div class="mid">
        <text class="state" style="color: {{en ? '#FF453A' : '#8E8E93'}}">{{en ? 'ВКЛ' : 'ИЗКЛ'}}</text>
        <div class="switch {{en ? 'switch-on' : ''}} {{ai ? 'off' : ''}} {{pressed ? 'down' : ''}}" style="background-color: {{en ? '#FF453A' : '#3A3A3C'}}"
             ontouchstart="press" ontouchend="release" ontouchcancel="release" onclick="toggle">
          <div class="knob"></div>
        </div>
        <text class="sub note" style="color: {{stateColor}}">{{stateText}}</text>
        <text class="factor" if="{{en && !ai}}" style="color: {{factorColor}}">сила {{sf}}%</text>
      </div>
    </div>

    <!-- 3 · last 3 minutes -->
    <div class="screen {{anim}}" if="{{cur === 'chart'}}">
      <text class="caps">3 МИНУТИ</text>
      <div class="mid">
        <div class="chart">
          <div for="{{bars}}" class="bar" style="height: {{$item.h}}px; background-color: {{$item.c}}"></div>
        </div>
        <div class="tiles">
          <div class="tile">
            <text class="tile-num">{{avgText}}</text>
            <text class="tile-lbl">средно</text>
          </div>
          <div class="tile">
            <text class="tile-num t-max">{{maxText}}</text>
            <text class="tile-lbl">връх</text>
          </div>
        </div>
      </div>
    </div>

    <div class="dots">
      <div for="{{dots}}" class="pdot {{$item.on ? 'pdot-on' : ''}}"></div>
    </div>
  </stack>
</template>

<script>
import { ZONE, GREEN, AMBER, zoneOf, mods, bind, shown, setPages, swipe, putList } from '../../common/ui.js'

export default {
  private: {
    ids: [],
    idsKey: '',
    idx: 0,
    cur: 'hr',
    dots: [],
    anim: '',
    hr: 0,
    hrText: '--',
    zoneColor: '#FFFFFF',
    zoneBars: [],
    limit: '--',
    pctText: '',
    en: false,
    ai: false,
    stateText: '',
    stateColor: '#8E8E93',
    sf: 100,
    factorColor: GREEN,
    bars: [],
    avgText: '--',
    maxText: '--',
    pressed: false
  },

  onInit() {
    setPages(this, ['hr', 'auto', 'chart'])
    this.unbind = bind(this, 'pulse')
  },

  onShow() {
    shown(this, true)
  },

  onHide() {
    shown(this, false)
  },

  onDestroy() {
    this.unbind()
  },

  onSwipe(e) {
    swipe(this, e)
  },

  update() {
    const s = this.$app.$def.state
    if (!s) {
      return
    }
    const hg = mods(s).hg
    const lim = hg.up || s.lim || 170
    const z = s.hr > 0 ? s.z || zoneOf(s.hr, lim) : 0
    this.hr = s.hr || 0
    this.hrText = s.hr > 0 ? String(s.hr) : '--'
    this.zoneColor = s.hr > 0 ? ZONE[z] : '#FFFFFF'
    const zb = []
    for (let i = 1; i <= 5; i++) {
      zb.push({ c: i <= z ? ZONE[i] : '#2C2C2E', on: i === z })
    }
    putList(this, 'zoneBars', zb)
    this.limit = String(lim)
    this.pctText = s.hr > 0 ? ' · ' + Math.round((s.hr / lim) * 100) + '%' : ''

    this.en = !!hg.en
    this.ai = !!hg.ai
    if (hg.ai) {
      this.stateText = 'AI сесията управлява'
      this.stateColor = '#FFD60A'
    } else if (!hg.en) {
      this.stateText = 'пулсът не пипа силата'
      this.stateColor = '#8E8E93'
    } else if (hg.hold) {
      this.stateText = 'задържа силата'
      this.stateColor = AMBER
    } else {
      this.stateText = 'следи пулса'
      this.stateColor = GREEN
    }
    this.sf = hg.sf || 100
    this.factorColor = this.sf >= 100 ? GREEN : this.sf >= 85 ? AMBER : '#FF453A'

    const hh = s.hh || []
    let lo = 999
    let hi = 0
    hh.forEach((v) => {
      if (v > 0) {
        lo = Math.min(lo, v)
        hi = Math.max(hi, v)
      }
    })
    lo = Math.max(40, lo - 8)
    hi = Math.max(hi, lo + 20)
    putList(this, 'bars', hh.map((v) => ({
      h: v > 0 ? Math.round(8 + ((v - lo) / (hi - lo)) * 150) : 4,
      c: v > 0 ? ZONE[zoneOf(v, lim)] : '#2C2C2E'
    })))
    this.avgText = s.avg > 0 ? String(s.avg) : '--'
    this.maxText = s.max > 0 ? String(s.max) : '--'
  },

  press() {
    this.pressed = true
  },

  release() {
    this.pressed = false
  },

  toggle() {
    if (this.ai) {
      return
    }
    this.en = !this.en
    this.$app.$def.command('hg_toggle')
  }
}
</script>

<style>
/* ---- common (scripts/gen-pages.py stamps this into every page) ---- */
.root {
  width: 212px;
  height: 520px;
  background-color: #000000;
}
.screen {
  width: 212px;
  height: 520px;
  flex-direction: column;
  align-items: center;
  padding-top: 46px;
}
.scr {
  width: 212px;
  height: 520px;
}
.col {
  flex-shrink: 0;
  width: 212px;
  flex-direction: column;
}
.in-up {
  animation-name: inUp;
  animation-duration: 260ms;
  animation-timing-function: ease-out;
}
.in-down {
  animation-name: inDown;
  animation-duration: 260ms;
  animation-timing-function: ease-out;
}
/* body under the title: fills the rest of the screen, content centred (no empty bottom half) */
.mid {
  flex-grow: 1;
  width: 212px;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-bottom: 34px;
}
.dots {
  width: 10px;
  height: 520px;
  margin-left: 202px;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}
.pdot {
  width: 6px;
  height: 6px;
  margin-top: 3px;
  margin-bottom: 3px;
  border-radius: 3px;
  background-color: #48484a;
}
.pdot-on {
  height: 18px;
  background-color: #ffffff;
}
.caps {
  flex-shrink: 0;
  height: 30px;
  font-size: 22px;
  font-weight: bold;
  color: #8e8e93;
}
.sub {
  flex-shrink: 0;
  width: 196px;
  text-align: center;
  font-size: 24px;
  color: #aeaeb2;
}
.down {
  transform: scale(0.92);
}
.btn {
  flex-shrink: 0;
  justify-content: center;
  align-items: center;
  transition-property: transform;
  transition-duration: 120ms;
}
.off {
  opacity: 0.3;
}
/* on / off switch: track + knob (one tap target, 150 × 84) */
.switch {
  flex-shrink: 0;
  width: 150px;
  height: 84px;
  padding-left: 8px;
  padding-right: 8px;
  border-radius: 42px;
  flex-direction: row;
  align-items: center;
  justify-content: flex-start;
  background-color: #3a3a3c;
  transition-property: transform;
  transition-duration: 120ms;
}
.switch-on {
  justify-content: flex-end;
}
.knob {
  flex-shrink: 0;
  width: 68px;
  height: 68px;
  border-radius: 34px;
  background-color: #ffffff;
}
.state {
  flex-shrink: 0;
  margin-bottom: 18px;
  font-size: 44px;
  font-weight: bold;
}
/* number tiles (2 per row) */
.tiles {
  flex-shrink: 0;
  flex-direction: row;
  margin-top: 8px;
}
.tile {
  flex-shrink: 0;
  width: 88px;
  height: 84px;
  margin-left: 4px;
  margin-right: 4px;
  border-radius: 22px;
  border-width: 1px;
  border-color: #2c2c2e;
  background-color: #1c1c1e;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}
.tile-num {
  flex-shrink: 0;
  font-size: 34px;
  font-weight: bold;
  color: #ffffff;
}
.tile-lbl {
  flex-shrink: 0;
  font-size: 18px;
  color: #8e8e93;
}
.t-max {
  color: #ff453a;
}
.t-kcal {
  color: #ff9f0a;
}
/* time in heart-rate zones: one bar, a segment per zone */
.zstack {
  flex-shrink: 0;
  width: 184px;
  height: 14px;
  margin-top: 16px;
  border-radius: 7px;
  flex-direction: row;
  background-color: #1c1c1e;
}
.zpart {
  height: 14px;
}
@keyframes inUp {
  from {
    transform: translateY(90px);
    opacity: 0;
  }
  to {
    transform: translateY(0px);
    opacity: 1;
  }
}
@keyframes inDown {
  from {
    transform: translateY(-90px);
    opacity: 0;
  }
  to {
    transform: translateY(0px);
    opacity: 1;
  }
}
/* ---- page ---- */
.bg-pulse {
  background-image: url(/common/bg/pulse.png);
  background-size: cover;
}
.pulse-caps {
  color: #ff453a;
}
.heart {
  width: 40px;
  height: 40px;
}
.note {
  width: 184px;
  margin-top: 18px;
  font-size: 22px;
}
.hr {
  font-size: 92px;
  font-weight: bold;
}
.zones {
  flex-direction: row;
  align-items: center;
  height: 18px;
  margin-top: 6px;
}
.zseg {
  width: 32px;
  height: 8px;
  margin-left: 2px;
  margin-right: 2px;
  border-radius: 4px;
}
.zseg-on {
  height: 16px;
  border-radius: 8px;
}
.sub {
  margin-top: 16px;
}
.factor {
  margin-top: 16px;
  font-size: 32px;
  font-weight: bold;
}
.chart {
  width: 184px;
  height: 170px;
  margin-bottom: 14px;
  flex-direction: row;
  align-items: flex-end;
}
.bar {
  width: 4px;
  margin-left: 1px;
  margin-right: 1px;
  border-radius: 2px;
}
</style>
