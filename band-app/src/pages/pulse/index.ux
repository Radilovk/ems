<template>
  <stack class="root" onswipe="onSwipe">
    <!-- 1 · heart rate -->
    <div class="screen {{anim}}" if="{{cur === 'hr'}}">
      <text class="caps pulse-caps">ПУЛС</text>
      <image class="heart {{hr > 0 ? 'beat' : ''}}" src="/common/icons/heart.png" style="animation-duration: {{beatMs}}ms"></image>
      <text class="hr" style="color: {{zoneColor}}">{{hrText}}</text>
      <div class="zones">
        <div for="{{zoneBars}}" class="zseg {{$item.on ? 'zseg-on' : ''}}" style="background-color: {{$item.c}}"></div>
      </div>
      <text class="sub">лимит {{limit}}{{pctText}}</text>
    </div>

    <!-- 2 · auto control on / off -->
    <div class="screen {{anim}}" if="{{cur === 'auto'}}">
      <text class="caps">АВТОКОНТРОЛ</text>
      <div class="btn toggle {{ai ? 'off' : ''}} {{pressed ? 'down' : ''}}" style="background-color: {{en ? '#0A84FF' : '#2C2C2E'}}"
           ontouchstart="press" ontouchend="release" ontouchcancel="release" onclick="toggle">
        <text class="toggle-text">{{en ? 'ВКЛ' : 'ИЗКЛ'}}</text>
      </div>
      <text class="sub" style="color: {{stateColor}}">{{stateText}}</text>
      <text class="factor" if="{{en && !ai}}" style="color: {{factorColor}}">сила {{sf}}%</text>
    </div>

    <!-- 3 · last 3 minutes -->
    <div class="screen {{anim}}" if="{{cur === 'chart'}}">
      <text class="caps">ПОСЛЕДНИ 3 МИН</text>
      <div class="chart">
        <div for="{{bars}}" class="bar" style="height: {{$item.h}}px; background-color: {{$item.c}}"></div>
      </div>
      <div class="pair">
        <div class="stat">
          <text class="stat-num">{{avgText}}</text>
          <text class="stat-label">средно</text>
        </div>
        <div class="stat">
          <text class="stat-num stat-max">{{maxText}}</text>
          <text class="stat-label">връх</text>
        </div>
      </div>
    </div>

    <div class="dots">
      <div for="{{dots}}" class="pdot {{$item.on ? 'pdot-on' : ''}}"></div>
    </div>
  </stack>
</template>

<script>
import { ZONE, GREEN, AMBER, BLUE, zoneOf, mods, bind, setPages, swipe } from '../../common/ui.js'

export default {
  private: {
    ids: [],
    idsKey: '',
    idx: 0,
    cur: 'hr',
    dots: [],
    anim: '',
    hr: 0,
    hrText: '--',
    zoneColor: '#FFFFFF',
    beatMs: 450,
    zoneBars: [],
    limit: '--',
    pctText: '',
    en: false,
    ai: false,
    stateText: '',
    stateColor: '#8E8E93',
    sf: 100,
    factorColor: GREEN,
    bars: [],
    avgText: '--',
    maxText: '--',
    pressed: false
  },

  onInit() {
    setPages(this, ['hr', 'auto', 'chart'])
    this.unbind = bind(this)
  },

  onDestroy() {
    this.unbind()
  },

  onSwipe(e) {
    swipe(this, e)
  },

  update() {
    const s = this.$app.$def.state
    if (!s) {
      return
    }
    const hg = mods(s).hg
    const lim = hg.up || s.lim || 170
    const z = s.hr > 0 ? s.z || zoneOf(s.hr, lim) : 0
    this.hr = s.hr || 0
    this.hrText = s.hr > 0 ? String(s.hr) : '--'
    this.zoneColor = s.hr > 0 ? ZONE[z] : '#FFFFFF'
    this.beatMs = s.hr > 0 ? Math.round(30000 / s.hr) : 450
    const zb = []
    for (let i = 1; i <= 5; i++) {
      zb.push({ c: i <= z ? ZONE[i] : '#2C2C2E', on: i === z })
    }
    this.zoneBars = zb
    this.limit = String(lim)
    this.pctText = s.hr > 0 ? ' · ' + Math.round((s.hr / lim) * 100) + '%' : ''

    this.en = !!hg.en
    this.ai = !!hg.ai
    if (hg.ai) {
      this.stateText = 'AI сесията управлява'
      this.stateColor = BLUE
    } else if (!hg.en) {
      this.stateText = 'пулсът не пипа силата'
      this.stateColor = '#8E8E93'
    } else if (hg.hold) {
      this.stateText = 'задържа силата'
      this.stateColor = AMBER
    } else {
      this.stateText = 'следи пулса'
      this.stateColor = GREEN
    }
    this.sf = hg.sf || 100
    this.factorColor = this.sf >= 100 ? GREEN : this.sf >= 85 ? AMBER : '#FF453A'

    const hh = s.hh || []
    let lo = 999
    let hi = 0
    hh.forEach((v) => {
      if (v > 0) {
        lo = Math.min(lo, v)
        hi = Math.max(hi, v)
      }
    })
    lo = Math.max(40, lo - 8)
    hi = Math.max(hi, lo + 20)
    this.bars = hh.map((v) => ({
      h: v > 0 ? Math.round(8 + ((v - lo) / (hi - lo)) * 150) : 4,
      c: v > 0 ? ZONE[zoneOf(v, lim)] : '#2C2C2E'
    }))
    this.avgText = s.avg > 0 ? String(s.avg) : '--'
    this.maxText = s.max > 0 ? String(s.max) : '--'
  },

  press() {
    this.pressed = true
  },

  release() {
    this.pressed = false
  },

  toggle() {
    if (this.ai) {
      return
    }
    this.en = !this.en
    this.$app.$def.command('hg_toggle')
  }
}
</script>

<style>
/* ---- common (tools/gen-pages.py stamps this into every page) ---- */
.root {
  width: 212px;
  height: 520px;
  background-color: #000000;
}
.screen {
  width: 212px;
  height: 520px;
  flex-direction: column;
  align-items: center;
  padding-top: 34px;
  background-color: #000000;
}
.in-up {
  animation-name: inUp;
  animation-duration: 260ms;
  animation-timing-function: ease-out;
}
.in-down {
  animation-name: inDown;
  animation-duration: 260ms;
  animation-timing-function: ease-out;
}
.dots {
  width: 16px;
  height: 520px;
  margin-left: 196px;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}
.pdot {
  width: 8px;
  height: 8px;
  margin-top: 4px;
  margin-bottom: 4px;
  border-radius: 4px;
  background-color: #3a3a3c;
}
.pdot-on {
  height: 22px;
  background-color: #ffffff;
}
.caps {
  font-size: 22px;
  font-weight: bold;
  color: #8e8e93;
}
.sub {
  width: 196px;
  text-align: center;
  font-size: 22px;
  color: #aeaeb2;
}
.down {
  transform: scale(0.92);
}
.btn {
  justify-content: center;
  align-items: center;
  transition-property: transform;
  transition-duration: 120ms;
}
.off {
  opacity: 0.3;
}
@keyframes inUp {
  from {
    transform: translateY(90px);
    opacity: 0;
  }
  to {
    transform: translateY(0px);
    opacity: 1;
  }
}
@keyframes inDown {
  from {
    transform: translateY(-90px);
    opacity: 0;
  }
  to {
    transform: translateY(0px);
    opacity: 1;
  }
}
@keyframes breathe {
  from {
    transform: scale(0.86);
    opacity: 0.9;
  }
  to {
    transform: scale(1.12);
    opacity: 0.2;
  }
}
@keyframes beat {
  from {
    transform: scale(1);
  }
  to {
    transform: scale(1.25);
  }
}

/* ---- page ---- */
.pulse-caps {
  color: #5ac8fa;
}
.heart {
  width: 48px;
  height: 48px;
  margin-top: 30px;
}
.beat {
  animation-name: beat;
  animation-iteration-count: infinite;
  animation-direction: alternate;
}
.hr {
  font-size: 110px;
  font-weight: bold;
}
.zones {
  flex-direction: row;
  align-items: center;
  height: 18px;
  margin-top: 6px;
}
.zseg {
  width: 32px;
  height: 8px;
  margin-left: 2px;
  margin-right: 2px;
  border-radius: 4px;
}
.zseg-on {
  height: 16px;
  border-radius: 8px;
}
.sub {
  margin-top: 16px;
}
.toggle {
  width: 170px;
  height: 170px;
  margin-top: 40px;
  border-radius: 85px;
}
.toggle-text {
  font-size: 40px;
  font-weight: bold;
  color: #ffffff;
}
.factor {
  margin-top: 16px;
  font-size: 32px;
  font-weight: bold;
}
.chart {
  width: 190px;
  height: 170px;
  margin-top: 26px;
  flex-direction: row;
  align-items: flex-end;
}
.bar {
  width: 4px;
  margin-left: 1px;
  margin-right: 1px;
  border-radius: 2px;
}
.pair {
  flex-direction: row;
  margin-top: 26px;
}
.stat {
  width: 94px;
  height: 96px;
  margin-left: 4px;
  margin-right: 4px;
  border-radius: 24px;
  background-color: #1c1c1e;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}
.stat-num {
  font-size: 36px;
  font-weight: bold;
  color: #ffffff;
}
.stat-max {
  color: #ff453a;
}
.stat-label {
  font-size: 20px;
  color: #8e8e93;
}
</style>
