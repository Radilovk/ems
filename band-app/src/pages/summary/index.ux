  font-size: 44px;
  font-weight: bold;
}
/* number tiles (2 per row) */
.tiles {
  flex-shrink: 0;
  flex-direction: row;
  margin-top: 8px;
}
.tile {
  flex-shrink: 0;
  width: 88px;
  height: 84px;
  margin-left: 4px;
  margin-right: 4px;
  border-radius: 22px;
  border-width: 1px;
  border-color: #2c2c2e;
  background-color: #1c1c1e;
  flex-direction: column;
  justify-content: center;
