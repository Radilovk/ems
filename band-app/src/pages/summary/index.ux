  width: 16px;
  height: 520px;
  margin-left: 196px;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}
.pdot {
  width: 8px;
  height: 8px;
  margin-top: 4px;
  margin-bottom: 4px;
  border-radius: 4px;
  background-color: #3a3a3c;
}
