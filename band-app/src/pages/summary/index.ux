<template>
  <stack class="root bg-summary" onswipe="onSwipe">
    <div class="screen">
      <div class="check"><image class="check-img" src="/common/icons/check.png"></image></div>
      <text class="caps">{{kindText}}</text>
      <text class="dur">{{durText}}</text>
      <text class="kcal">{{kcal}} kcal</text>
      <div class="pair">
        <div class="stat">
          <text class="stat-num">{{avg}}</text>
          <text class="stat-label">средно</text>
        </div>
        <div class="stat">
          <text class="stat-num stat-max">{{max}}</text>
          <text class="stat-label">връх</text>
        </div>
      </div>
      <div class="zstack">
        <div for="{{zones}}" class="zpart" style="flex: {{$item.w}}; background-color: {{$item.c}}"></div>
      </div>
      <div class="btn done {{pressed ? 'down' : ''}}" ontouchstart="press" ontouchend="release" ontouchcancel="release" onclick="close">
        <text class="done-text">Готово</text>
      </div>
    </div>
  </stack>
</template>

<script>
import router from '@system.router'
import { ZONE, hms, swipe } from '../../common/ui.js'

export default {
  private: {
    ids: ['main'],
    idsKey: 'main',
    idx: 0,
    cur: 'main',
    dots: [],
    anim: '',
    kindText: 'КРАЙ',
    durText: '0:00',
    kcal: '--',
    avg: '--',
    max: '--',
    zones: [],
    pressed: false
  },

  onInit() {
    const s = this.$app.$def.summary || {}
    this.kindText = s.kind === 'ai' ? 'AI СЕСИЯТА ПРИКЛЮЧИ' : 'ТРЕНИРОВКАТА ПРИКЛЮЧИ'
    this.durText = hms(s.dur || 0)
    this.kcal = s.kcal > 0 ? String(s.kcal) : '--'
    this.avg = s.avg > 0 ? String(s.avg) : '--'
    this.max = s.max > 0 ? String(s.max) : '--'
    const zt = s.zt || [0, 0, 0, 0, 0]
    const total = zt.reduce((a, b) => a + b, 0)
    this.zones = zt.map((v, i) => ({ w: total > 0 ? Math.max(v, 0.0001) : 1, c: ZONE[i + 1] }))
  },

  onSwipe(e) {
    swipe(this, e)
  },

  press() {
    this.pressed = true
  },

  release() {
    this.pressed = false
  },

  close() {
    router.back()
  }
}
</script>

