  flex-shrink: 0;
  margin-bottom: 18px;
  font-size: 44px;
  font-weight: bold;
}
/* number tiles (2 per row) */
.tiles {
  flex-shrink: 0;
  flex-direction: row;
  margin-top: 8px;
}
.tile {
  flex-shrink: 0;
  width: 88px;
  height: 84px;
  margin-left: 4px;
  margin-right: 4px;
  border-radius: 22px;
  border-width: 1px;
  border-color: #2C2C2E;
  background-color: #1C1C1E;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}
.tile-num {
  flex-shrink: 0;
  font-size: 34px;
  font-weight: bold;
  color: #ffffff;
}
.tile-lbl {
  flex-shrink: 0;
  font-size: 18px;
  color: #8E8E93;
}
.t-max {
  color: #FF453A;
}
.t-kcal {
  color: #FF8A1F;
}
/* time in heart-rate zones: one bar, a segment per zone */
.zstack {
  flex-shrink: 0;
  width: 184px;
  height: 14px;
  margin-top: 16px;
  border-radius: 7px;
  flex-direction: row;
  background-color: #1C1C1E;
}
.zpart {
  height: 14px;
}
@keyframes inUp {
  from {
    transform: translateY(90px);
    opacity: 0;
  }
  to {
    transform: translateY(0px);
    opacity: 1;
  }
}
@keyframes inDown {
  from {
    transform: translateY(-90px);
    opacity: 0;
  }
  to {
    transform: translateY(0px);
    opacity: 1;
  }
}
/* ---- page ---- */
.bg-summary {
  background-image: url(/common/bg/summary.png);
  background-size: cover;
}
.screen {
  padding-top: 40px;
  justify-content: center;
  padding-bottom: 30px;
}
.check {
  width: 60px;
  height: 60px;
  border-radius: 30px;
  background-color: #00F59B;
  background-image: url(/common/art/badge-done.png);
  background-size: contain;
}
.caps {
  margin-top: 12px;
  width: 200px;
  text-align: center;
  font-size: 20px;
}
.dur {
  font-size: 56px;
  font-weight: bold;
  color: #ffffff;
}
.kcal {
  font-size: 30px;
  font-weight: bold;
  color: #FF8A1F;
}
.done {
  width: 160px;
  height: 70px;
  margin-top: 18px;
  border-radius: 35px;
  background-color: #2C2C2E;
}
.body-screen {
  justify-content: flex-start;
  padding-top: 40px;
}
.figs {
  width: 200px;
  flex-direction: row;
  justify-content: space-between;
  margin-top: 10px;
  margin-right: 8px;
}
.fig {
  width: 96px;
}
.boxes {
  width: 96px;
  height: 236px;
}
.bx {
  position: absolute;
}
.stencil {
  width: 96px;
  background-size: contain;
}
.f-front {
  background-image: url(/common/body/f-front.png);
}
.f-back {
  background-image: url(/common/body/f-back.png);
}
.m-front {
  background-image: url(/common/body/m-front.png);
}
.m-back {
  background-image: url(/common/body/m-back.png);
}
.tops {
  width: 196px;
  flex-direction: column;
  margin-top: 16px;
}
.top {
  height: 30px;
  flex-direction: row;
  align-items: center;
}
.tdot {
  width: 12px;
  height: 12px;
  border-radius: 6px;
  margin-right: 10px;
}
.tname {
  flex-grow: 1;
  lines: 1;
  font-size: 19px;
  color: #ffffff;
}
.tpct {
  margin-left: 8px;
  font-size: 19px;
  font-weight: bold;
  color: #AEAEB2;
}
.grow {
  flex-grow: 1;
}
/* "още" + a chevron at the bottom of the figure screen: bobs a few times, then rests */
.hint {
  flex-shrink: 0;
  margin-top: 6px;
  margin-bottom: 4px;
  flex-direction: column;
  align-items: center;
  animation-name: bob;
  animation-duration: 900ms;
  animation-iteration-count: 5;
  animation-timing-function: ease-in-out;
}
.hint-t {
  font-size: 16px;
  color: #8E8E93;
}
.chev {
  width: 14px;
  height: 14px;
  margin-top: 2px;
  border-style: solid;
  border-top-width: 0px;
  border-left-width: 0px;
  border-right-width: 3px;
  border-bottom-width: 3px;
  border-color: #AEAEB2;
  transform: rotate(45deg);
}
@keyframes bob {
  0% {
    transform: translateY(0px);
    opacity: 1;
  }
  50% {
    transform: translateY(8px);
    opacity: 0.55;
  }
  100% {
    transform: translateY(0px);
    opacity: 1;
  }
}
.done-text {
  font-size: 28px;
  font-weight: bold;
  color: #ffffff;
}
</style>
