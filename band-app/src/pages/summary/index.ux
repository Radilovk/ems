  width: 6px;
  height: 6px;
  margin-top: 3px;
  margin-bottom: 3px;
  border-radius: 3px;
  background-color: #48484a;
}
.pdot-on {
  height: 18px;
  background-color: #ffffff;
}
.caps {
  flex-shrink: 0;
  height: 30px;
  font-size: 22px;
  font-weight: bold;
  color: #8e8e93;
}
.sub {
  flex-shrink: 0;
  width: 196px;
  text-align: center;
  font-size: 24px;
  color: #aeaeb2;
}
.down {
  transform: scale(0.92);
}
.btn {
  flex-shrink: 0;
  justify-content: center;
  align-items: center;
  transition-property: transform;
  transition-duration: 120ms;
}
.off {
  opacity: 0.3;
}
/* on / off switch: track + knob (one tap target, 150 × 84) */
.switch {
  flex-shrink: 0;
  width: 150px;
  height: 84px;
  padding-left: 8px;
  padding-right: 8px;
  border-radius: 42px;
  flex-direction: row;
  align-items: center;
  justify-content: flex-start;
  background-color: #3a3a3c;
  transition-property: transform;
  transition-duration: 120ms;
}
