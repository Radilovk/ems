  flex-shrink: 0;
  width: 212px;
  flex-direction: column;
}
.in-up {
  animation-name: inUp;
  animation-duration: 260ms;
  animation-timing-function: ease-out;
}
.in-down {
  animation-name: inDown;
  animation-duration: 260ms;
  animation-timing-function: ease-out;
}
/* body under the title: fills the rest of the screen, content centred (no empty bottom half) */
.mid {
  flex-grow: 1;
  width: 212px;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-bottom: 34px;
}
.dots {
  width: 10px;
  height: 520px;
  margin-left: 202px;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}
