<template>
  <stack class="root bg-summary">
    <scroll class="scr" scroll-y="true">
      <div class="col">
        <!-- 1 · the muscles this training worked (first when the map is there), a hint to scroll -->
        <div class="screen body-screen" if="{{hasBody}}">
          <text class="caps">МУСКУЛИ</text>
          <div class="figs">
            <stack class="fig" style="height: {{figH}}px">
              <div class="boxes">
                <div for="{{front}}" class="bx" style="left: {{$item.x}}px; top: {{$item.y}}px; width: {{$item.w}}px; height: {{$item.h}}px; background-color: {{$item.c}}"></div>
              </div>
              <div class="stencil {{sexK}}-front" style="height: {{figH}}px"></div>
            </stack>
            <stack class="fig fig-b" style="height: {{figH}}px">
              <div class="boxes">
                <div for="{{back}}" class="bx" style="left: {{$item.x}}px; top: {{$item.y}}px; width: {{$item.w}}px; height: {{$item.h}}px; background-color: {{$item.c}}"></div>
              </div>
              <div class="stencil {{sexK}}-back" style="height: {{figH}}px"></div>
            </stack>
          </div>
          <div class="tops">
            <div for="{{tops}}" class="top">
              <div class="tdot" style="background-color: {{$item.c}}"></div>
              <text class="tname">{{$item.n}}</text>
              <text class="tpct">{{$item.p}}%</text>
            </div>
          </div>
          <div class="grow"></div>
          <div class="hint">
            <text class="hint-t">още</text>
            <div class="chev"></div>
          </div>
        </div>

        <!-- 2 · time, kcal, heart rate, zones, done -->
        <div class="screen">
          <div class="check"></div>
          <text class="caps">{{kindText}}</text>
          <text class="dur">{{durText}}</text>
          <text class="kcal">{{kcal}} kcal</text>
          <div class="tiles">
            <div class="tile">
              <text class="tile-num">{{avg}}</text>
              <text class="tile-lbl">средно</text>
            </div>
            <div class="tile">
              <text class="tile-num t-max">{{max}}</text>
              <text class="tile-lbl">връх</text>
            </div>
          </div>
          <div class="zstack">
            <div for="{{zones}}" class="zpart" style="flex: {{$item.w}}; background-color: {{$item.c}}"></div>
          </div>
          <div class="btn done {{pressed ? 'down' : ''}}" ontouchstart="press" ontouchend="release" ontouchcancel="release" onclick="close">
            <text class="done-text">Готово</text>
          </div>
        </div>
      </div>
    </scroll>
  </stack>
</template>

<script>
import router from '@system.router'
import { ZONE, hms } from '../../common/ui.js'
import { BODY } from '../../common/body-map.js'

// Muscle load colour: the same scale as the tablet report and the client card.
// One gamut per figure (warm magenta for a woman, cool cyan for a man), as the tablet report.
const STOPS_F = [[0, [196, 120, 255]], [0.5, [226, 64, 251]], [1, [255, 45, 149]]]
const STOPS_M = [[0, [125, 150, 255]], [0.5, [61, 165, 255]], [1, [0, 229, 255]]]
const BODY_GREY = [66, 66, 70]      // the figure's graphite: a lightly loaded muscle leans toward it
const MUSCLE = ['Гърди', 'Корем', 'Предно бедро', 'Прасци', 'Ръце', 'Трапец', 'Гръб', 'Кръст', 'Седалище', 'Задно бедро', 'Рамо']
// zone 10 = the deltoid: no suit channel, the exercises' shoulder work (s.delt 0–100, −1 / missing = none)
const DELT = 10
// both sexes listed so the image budget check sees them
const STENCILS = ['/common/body/f-front.png', '/common/body/f-back.png', '/common/body/m-front.png', '/common/body/m-back.png']

function heat(v, STOPS) {
  v = Math.max(0, Math.min(1, (v - 0.45) / 0.55))   // loads sit between ~45 and 100 %
  const op = 0.4 + 0.6 * v                          // less load → closer to the body
  for (let i = 1; i < STOPS.length; i++) {
    if (v <= STOPS[i][0]) {
      const a = STOPS[i - 1]
      const b = STOPS[i]
      const k = (v - a[0]) / (b[0] - a[0])
      return '#' + a[1].map((x, j) => ('0' + Math.round((x + (b[1][j] - x) * k) * op + BODY_GREY[j] * (1 - op)).toString(16)).slice(-2)).join('')
    }
  }
  return '#' + STOPS[STOPS.length - 1][1].map((x) => ('0' + x.toString(16)).slice(-2)).join('')
}

function boxes(key, col) {
  return BODY.views[key].boxes.map((b) => ({ x: b[0], y: b[1], w: b[2], h: b[3], c: col[b[4]] }))
}

export default {
  private: {
    hasBody: false,
    kindText: 'КРАЙ',
    durText: '0:00',
    kcal: '--',
    avg: '--',
    max: '--',
    zones: [],
    sexK: 'f',
    figH: 236,
    front: [],
    back: [],
    tops: [],
    pressed: false
  },

  onInit() {
    this.fill()
    this.onApp = () => {
      const s = this.$app.$def.summary || {}
      if (s.mus && !this.hasBody) {
        this.fill()                                // the muscle map arrived after the page opened
      }
    }
    this.$app.$def.watch(this.onApp)
  },

  onDestroy() {
    this.$app.$def.unwatch(this.onApp)
  },

  fill() {
    const s = this.$app.$def.summary || {}
    this.kindText = s.kind === 'ai' ? 'AI СЕСИЯ' : 'ТРЕНИРОВКА'
    this.durText = hms(s.dur || 0)
    this.kcal = s.kcal > 0 ? String(s.kcal) : '--'
    this.avg = s.avg > 0 ? String(s.avg) : '--'
    this.max = s.max > 0 ? String(s.max) : '--'
    const zt = s.zt || [0, 0, 0, 0, 0]
    const total = zt.reduce((a, b) => a + b, 0)
    this.zones = zt.map((v, i) => ({ w: total > 0 ? Math.max(v, 0.0001) : 1, c: ZONE[i + 1] }))
    const mus = s.mus
    if (mus && mus.length === 10 && Math.max(...mus) > 0) {
      const mx = Math.max(...mus)
      const lv = mus.map((v) => v / mx)
      const d = typeof s.delt === 'number' && s.delt >= 0 ? s.delt / 100 : -1
      const col = lv.map((v) => heat(v, s.sex === 'M' ? STOPS_M : STOPS_F))
      col.push(d >= 0 ? heat(d, s.sex === 'M' ? STOPS_M : STOPS_F)
        : '#' + BODY_GREY.map((x) => ('0' + x.toString(16)).slice(-2)).join(''))
      if (d >= 0) {
        lv.push(d)
      }
      this.sexK = s.sex === 'M' ? 'm' : 'f'
      this.figH = BODY.views[this.sexK + '-front'].h
      this.front = boxes(this.sexK + '-front', col)
      this.back = boxes(this.sexK + '-back', col)
      this.tops = lv.map((v, i) => ({ i, v })).sort((a, b) => b.v - a.v).slice(0, 3)
        .map((t) => ({ n: MUSCLE[t.i], p: Math.round(t.v * 100), c: col[t.i] }))
      this.hasBody = true
    }
  },

  onShow() {
    try {
      this.$app.$def.setVisible(true)
    } catch (e) {}
  },

  onHide() {
    try {
      this.$app.$def.setVisible(false)
    } catch (e) {}
  },

  press() {
    this.pressed = true
  },

  release() {
    this.pressed = false
  },

  close() {
    router.back()
  }
}
</script>

<style>
/* ---- common (scripts/gen-pages.py stamps this into every page) ---- */
.root {
  width: 212px;
  height: 520px;
  background-color: #000000;
}
.screen {
  width: 212px;
  height: 520px;
  flex-direction: column;
  align-items: center;
  padding-top: 46px;
}
.scr {
  width: 212px;
  height: 520px;
}
.col {
  flex-shrink: 0;
  width: 212px;
  flex-direction: column;
}
.in-up {
  animation-name: inUp;
  animation-duration: 260ms;
  animation-timing-function: ease-out;
}
.in-down {
  animation-name: inDown;
  animation-duration: 260ms;
  animation-timing-function: ease-out;
}
/* body under the title: fills the rest of the screen, content centred (no empty bottom half) */
.mid {
  flex-grow: 1;
  width: 212px;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-bottom: 34px;
}
.dots {
  width: 10px;
  height: 520px;
  margin-left: 202px;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}
.pdot {
  width: 6px;
  height: 6px;
  margin-top: 3px;
  margin-bottom: 3px;
  border-radius: 3px;
  background-color: #48484A;
}
.pdot-on {
  height: 18px;
  background-color: #ffffff;
}
.caps {
  flex-shrink: 0;
  height: 30px;
  font-size: 22px;
  font-weight: bold;
  color: #8E8E93;
}
.sub {
  flex-shrink: 0;
  width: 196px;
  text-align: center;
  font-size: 24px;
  color: #AEAEB2;
}
.down {
  transform: scale(0.92);
}
.btn {
  flex-shrink: 0;
  justify-content: center;
  align-items: center;
  transition-property: transform;
  transition-duration: 120ms;
}
.off {
  opacity: 0.3;
}
/* on / off switch: track + knob (one tap target, 150 × 84) */
.switch {
  flex-shrink: 0;
  width: 150px;
  height: 84px;
  padding-left: 8px;
  padding-right: 8px;
  border-radius: 42px;
  flex-direction: row;
  align-items: center;
  justify-content: flex-start;
  background-color: #3A3A3C;
  transition-property: transform;
  transition-duration: 120ms;
}
.switch-on {
  justify-content: flex-end;
}
.knob {
  flex-shrink: 0;
  width: 68px;
  height: 68px;
  border-radius: 34px;
  background-color: #ffffff;
}
