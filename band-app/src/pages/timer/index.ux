<template>
  <stack class="root bg-timer" onswipe="onSwipe">
    <div class="screen">
      <text class="caps" style="color: {{capsColor}}">{{caps}}</text>
      <stack class="ring-box">
        <progress class="ring" type="arc" percent="{{pct}}" style="color: {{ringColor}}"></progress>
        <div class="center">
          <text class="left" style="color: {{leftColor}}">{{leftText}}</text>
          <text class="loop">{{loopText}}</text>
        </div>
      </stack>
      <div class="btn play {{pressed ? 'down' : ''}} {{armed ? '' : 'off'}}" style="background-color: {{run ? '#2C2C2E' : '#FF9F0A'}}"
           ontouchstart="press" ontouchend="release" ontouchcancel="release" onclick="toggle">
        <image class="play-img" src="{{run ? '/common/icons/pause.png' : '/common/icons/play.png'}}"></image>
      </div>
      <text class="sub">{{status}}</text>
    </div>
  </stack>
</template>

<script>
import { AMBER, GREEN, mmss, mods, bind, setPages, swipe } from '../../common/ui.js'

export default {
  private: {
    ids: [],
    idsKey: '',
    idx: 0,
    cur: 'main',
    dots: [],
    anim: '',
    caps: 'ТАЙМЕР',
    capsColor: '#8E8E93',
    pct: 0,
    ringColor: AMBER,
    leftText: '--:--',
    leftColor: '#FFFFFF',
    loopText: '',
    status: '',
    run: false,
    armed: false,
    pressed: false
  },

  onInit() {
    setPages(this, ['main'])
    this.unbind = bind(this)
  },

  onDestroy() {
    this.unbind()
  },

  onSwipe(e) {
    swipe(this, e)
  },

  update() {
    const app = this.$app.$def
    const s = app.state
    if (!s) {
      return
    }
    const tm = mods(s).tm
    this.armed = !!tm.arm
    this.run = !!tm.run
    const left = Math.max(0, (tm.left || 0) - (tm.run ? app.silence() : 0))
    const total = Math.max(1, tm.int || 1)
    this.leftText = tm.arm || tm.int ? mmss(left) : '--:--'
    this.pct = tm.arm ? Math.min(100, Math.max(0, Math.round((1 - left / total) * 100))) : 0
    const last = tm.run && left <= 3
    this.leftColor = last ? '#FF453A' : '#FFFFFF'
    this.ringColor = last ? '#FF453A' : AMBER
    this.loopText = tm.lbl ? tm.lbl : tm.arm ? (tm.loops > 0 ? tm.loop + ' / ' + tm.loops : '#' + (tm.loop || 1)) : ''
    if (!tm.arm) {
      this.caps = 'ТАЙМЕР'
      this.capsColor = '#8E8E93'
      this.status = 'включи го на таблета'
    } else if (tm.run) {
      this.caps = 'АКТИВЕН'
      this.capsColor = GREEN
      this.status = 'вибрира 3-2-1'
    } else if (tm.pau) {
      this.caps = 'ПАУЗА'
      this.capsColor = AMBER
      this.status = 'импулсите текат'
    } else {
      this.caps = 'ЧАКА'
      this.capsColor = AMBER
      this.status = 'тръгва със старта'
    }
  },

  press() {
    this.pressed = true
  },

  release() {
    this.pressed = false
  },

  toggle() {
    if (this.armed) {
      this.$app.$def.command('tm_toggle')
    }
  }
}
</script>

<style>
/* ---- common (scripts/gen-pages.py stamps this into every page) ---- */
.root {
  width: 212px;
  height: 520px;
  background-color: #000000;
}
.screen {
  width: 212px;
  height: 520px;
  flex-direction: column;
  align-items: center;
  padding-top: 46px;
}
.scr {
  width: 212px;
  height: 520px;
}
.col {
  flex-shrink: 0;
  width: 212px;
  flex-direction: column;
}
.in-up {
  animation-name: inUp;
  animation-duration: 260ms;
  animation-timing-function: ease-out;
}
.in-down {
  animation-name: inDown;
  animation-duration: 260ms;
  animation-timing-function: ease-out;
}
.dots {
  width: 16px;
  height: 520px;
  margin-left: 196px;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}
.pdot {
  width: 8px;
  height: 8px;
  margin-top: 4px;
  margin-bottom: 4px;
  border-radius: 4px;
  background-color: #3a3a3c;
}
.pdot-on {
  height: 22px;
  background-color: #ffffff;
}
.caps {
  flex-shrink: 0;
  font-size: 24px;
  font-weight: bold;
  color: #8e8e93;
}
.sub {
  flex-shrink: 0;
  width: 196px;
  text-align: center;
  font-size: 24px;
  color: #aeaeb2;
}
.down {
  transform: scale(0.92);
}
.btn {
  flex-shrink: 0;
  justify-content: center;
  align-items: center;
  transition-property: transform;
  transition-duration: 120ms;
}
.off {
  opacity: 0.3;
}
@keyframes inUp {
  from {
    transform: translateY(90px);
    opacity: 0;
  }
  to {
    transform: translateY(0px);
    opacity: 1;
  }
}
@keyframes inDown {
  from {
    transform: translateY(-90px);
    opacity: 0;
  }
  to {
    transform: translateY(0px);
    opacity: 1;
  }
}
@keyframes breathe {
  from {
    transform: scale(0.86);
    opacity: 0.9;
  }
  to {
    transform: scale(1.12);
    opacity: 0.2;
  }
}
@keyframes beat {
  from {
    transform: scale(1);
  }
  to {
    transform: scale(1.25);
  }
}
/* ---- page ---- */
.bg-timer {
  background-image: url(/common/bg/timer.png);
  background-size: cover;
}
.ring-box {
  width: 180px;
  height: 180px;
  margin-top: 12px;
}
.ring {
  width: 180px;
  height: 180px;
  stroke-width: 18px;
  background-color: #1c1c1e;
  start-angle: 0deg;
  total-angle: 360deg;
  center-x: 90px;
  center-y: 90px;
  radius: 81px;
}
.center {
  width: 180px;
  height: 180px;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}
.left {
  font-size: 58px;
  font-weight: bold;
}
.loop {
  font-size: 26px;
  color: #ff9f0a;
  font-weight: bold;
}
.play {
  width: 112px;
  height: 112px;
  margin-top: 18px;
  border-radius: 56px;
}
.play-img {
  width: 60px;
  height: 60px;
}
.sub {
  margin-top: 10px;
}
</style>
