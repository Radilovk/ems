<template>
  <stack class="root bg-timer" onswipe="onSwipe">
    <div class="screen">
      <text class="caps" style="color: {{capsColor}}">{{caps}}</text>
      <div class="mid">
        <stack class="ring-box">
          <image class="halo" if="{{run}}" src="/common/art/glow-timer.png"></image>
          <progress class="ring" type="arc" percent="{{pct}}" style="color: {{ringColor}}"></progress>
          <div class="center">
            <text class="left" style="color: {{leftColor}}">{{leftText}}</text>
            <text class="loop">{{loopText}}</text>
          </div>
        </stack>
        <div class="btn play {{pressed ? 'down' : ''}} {{armed ? '' : 'off'}}" style="background-color: {{run ? '#222532' : '#FF8A1F'}}"
             ontouchstart="press" ontouchend="release" ontouchcancel="release" onclick="toggle">
          <image class="play-img" src="{{run ? '/common/icons/pause.png' : '/common/icons/play.png'}}"></image>
        </div>
        <text class="sub">{{status}}</text>
      </div>
    </div>
  </stack>
</template>

<script>
import { AMBER, GREEN, mmss, mods, bind, shown, setPages, swipe } from '../../common/ui.js'

export default {
  private: {
    ids: [],
    idsKey: '',
    idx: 0,
    cur: 'main',
    dots: [],
    anim: '',
    caps: 'ТАЙМЕР',
    capsColor: '#8C93AB',
    pct: 0,
    ringColor: AMBER,
    leftText: '--:--',
    leftColor: '#FFFFFF',
    loopText: '',
    status: '',
    run: false,
    armed: false,
    pressed: false
  },

  onInit() {
    setPages(this, ['main'])
    this.unbind = bind(this, 'timer')
  },

  onShow() {
    shown(this, true)
  },

  onHide() {
    shown(this, false)
  },

  onDestroy() {
    this.unbind()
  },

  onSwipe(e) {
    swipe(this, e)
  },

  update() {
    const app = this.$app.$def
    const s = app.state
    if (!s) {
      return
    }
    const tm = mods(s).tm
    this.armed = !!tm.arm
    this.run = !!tm.run
    const left = Math.max(0, (tm.left || 0) - (tm.run ? app.silence() : 0))
    const total = Math.max(1, tm.int || 1)
    this.leftText = tm.arm || tm.int ? mmss(left) : '--:--'
    this.pct = tm.arm ? Math.min(100, Math.max(0, Math.round((1 - left / total) * 100))) : 0
    const last = tm.run && left <= 3
    this.leftColor = last ? '#FF2E63' : '#FFFFFF'
    this.ringColor = last ? '#FF2E63' : AMBER
    this.loopText = tm.lbl ? tm.lbl : tm.arm ? (tm.loops > 0 ? tm.loop + ' / ' + tm.loops : '#' + (tm.loop || 1)) : ''
    if (!tm.arm) {
      this.caps = 'ТАЙМЕР'
      this.capsColor = '#8C93AB'
      this.status = 'включи го на таблета'
    } else if (tm.run) {
      this.caps = 'АКТИВЕН'
      this.capsColor = GREEN
      this.status = 'вибрира 3-2-1'
    } else if (tm.pau) {
      this.caps = 'ПАУЗА'
      this.capsColor = AMBER
      this.status = 'импулсите текат'
    } else {
      this.caps = 'ЧАКА'
      this.capsColor = AMBER
      this.status = 'тръгва със старта'
    }
  },

  press() {
    this.pressed = true
  },

  release() {
    this.pressed = false
  },

  toggle() {
    if (this.armed) {
      this.$app.$def.command('tm_toggle')
    }
  }
}
</script>

<style>
/* ---- common (scripts/gen-pages.py stamps this into every page) ---- */
.root {
  width: 212px;
  height: 520px;
  background-color: #000000;
}
.screen {
  width: 212px;
  height: 520px;
  flex-direction: column;
  align-items: center;
  padding-top: 46px;
}
.scr {
  width: 212px;
  height: 520px;
}
.col {
  flex-shrink: 0;
  width: 212px;
  flex-direction: column;
}
.in-up {
  animation-name: inUp;
  animation-duration: 260ms;
  animation-timing-function: ease-out;
}
.in-down {
  animation-name: inDown;
  animation-duration: 260ms;
  animation-timing-function: ease-out;
}
/* body under the title: fills the rest of the screen, content centred (no empty bottom half) */
.mid {
  flex-grow: 1;
  width: 212px;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-bottom: 34px;
}
.dots {
  width: 10px;
  height: 520px;
  margin-left: 202px;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}
.pdot {
  width: 6px;
  height: 6px;
  margin-top: 3px;
  margin-bottom: 3px;
  border-radius: 3px;
  background-color: #3A3F55;
}
.pdot-on {
  height: 18px;
  background-color: #ffffff;
}
.caps {
  flex-shrink: 0;
  height: 30px;
  font-size: 22px;
  font-weight: bold;
  color: #8C93AB;
}
.sub {
  flex-shrink: 0;
  width: 196px;
  text-align: center;
  font-size: 24px;
  color: #ADB3C7;
}
.down {
  transform: scale(0.92);
}
.btn {
  flex-shrink: 0;
  justify-content: center;
  align-items: center;
  transition-property: transform;
  transition-duration: 120ms;
}
.off {
  opacity: 0.3;
}
/* on / off switch: track + knob (one tap target, 150 × 84) */
.switch {
  flex-shrink: 0;
  width: 150px;
  height: 84px;
  padding-left: 8px;
  padding-right: 8px;
  border-radius: 42px;
  flex-direction: row;
  align-items: center;
  justify-content: flex-start;
  background-color: #2D3142;
  transition-property: transform;
  transition-duration: 120ms;
}
.switch-on {
  justify-content: flex-end;
}
.knob {
  flex-shrink: 0;
  width: 68px;
  height: 68px;
  border-radius: 34px;
  background-color: #ffffff;
}
.state {
  flex-shrink: 0;
  margin-bottom: 18px;
  font-size: 44px;
  font-weight: bold;
}
/* number tiles (2 per row) */
.tiles {
  flex-shrink: 0;
  flex-direction: row;
  margin-top: 8px;
}
.tile {
  flex-shrink: 0;
  width: 88px;
  height: 84px;
