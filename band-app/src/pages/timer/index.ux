  color: #FF8A1F;
}
/* time in heart-rate zones: one bar, a segment per zone */
.zstack {
  flex-shrink: 0;
  width: 184px;
  height: 14px;
  margin-top: 16px;
  border-radius: 7px;
  flex-direction: row;
  background-color: #15171F;
}
.zpart {
  height: 14px;
}
@keyframes inUp {
  from {
    transform: translateY(90px);
    opacity: 0;
  }
  to {
    transform: translateY(0px);
    opacity: 1;
  }
}
@keyframes inDown {
  from {
    transform: translateY(-90px);
    opacity: 0;
  }
  to {
    transform: translateY(0px);
    opacity: 1;
  }
}
/* ---- page ---- */
.bg-timer {
  background-image: url(/common/bg/timer.png);
  background-size: cover;
}
.ring-box {
  width: 180px;
  height: 180px;
}
.ring {
  width: 180px;
  height: 180px;
  stroke-width: 14px;
  background-color: #15171F;
  start-angle: 0deg;
  total-angle: 360deg;
  center-x: 90px;
  center-y: 90px;
  radius: 83px;
}
.center {
  width: 180px;
  height: 180px;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}
.left {
  font-size: 58px;
  font-weight: bold;
}
.loop {
  font-size: 26px;
  color: #FF8A1F;
  font-weight: bold;
}
.halo {
  width: 180px;
  height: 180px;
}
/* colour from CSS (start / pause changes only that), light layer on top */
.play {
  background-image: url(/common/art/shine-112.png);
  background-size: contain;
  width: 112px;
  height: 112px;
  margin-top: 18px;
  border-radius: 56px;
}
.play-img {
  width: 60px;
  height: 60px;
}
.sub {
  margin-top: 12px;
  width: 184px;
  font-size: 22px;
}
</style>
