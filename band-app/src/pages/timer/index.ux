<template>
  <div class="screen">
    <text class="caps" style="color: {{capsColor}}">{{caps}}</text>

    <stack class="ring-box">
      <progress class="ring" type="arc" percent="{{pct}}" style="color: {{ringColor}}"></progress>
      <div class="center">
        <text class="left" style="color: {{leftColor}}">{{leftText}}</text>
        <text class="loop">{{loopText}}</text>
      </div>
    </stack>

    <text class="status">{{status}}</text>

    <div class="play {{pressed ? 'down' : ''}} {{armed ? '' : 'off'}}" style="background-color: {{run ? '#2C2C2E' : '#FF9F0A'}}"
         ontouchstart="press" ontouchend="release" ontouchcancel="release" onclick="toggle">
      <image class="play-img" src="{{run ? '/common/icons/pause.png' : '/common/icons/play.png'}}"></image>
    </div>
    <text class="hint">{{hint}}</text>
  </div>
</template>

<script>
import { AMBER, GREEN, mmss, mods, bind } from '../../common/ui.js'

export default {
  private: {
    caps: 'ТАЙМЕР',
    capsColor: '#8E8E93',
    pct: 0,
    ringColor: AMBER,
    leftText: '--:--',
    leftColor: '#FFFFFF',
    loopText: '',
    status: '',
    run: false,
    armed: false,
    hint: '',
    pressed: false
  },

  onInit() {
    this.unbind = bind(this)
  },

  onDestroy() {
    this.unbind()
  },

  update() {
    const app = this.$app.$def
    const s = app.state
    if (!s) {
      return
    }
    const tm = mods(s).tm
    this.armed = !!tm.arm
    this.run = !!tm.run
    const left = Math.max(0, (tm.left || 0) - (tm.run ? app.silence() : 0))
    const total = Math.max(1, tm.int || 1)
    this.leftText = tm.arm || tm.int ? mmss(left) : '--:--'
    this.pct = tm.arm ? Math.min(100, Math.max(0, Math.round((1 - left / total) * 100))) : 0
    this.leftColor = tm.run && left <= 3 ? '#FF453A' : '#FFFFFF'
    this.ringColor = tm.run && left <= 3 ? '#FF453A' : AMBER
    this.loopText = tm.lbl ? tm.lbl : tm.arm ? (tm.loops > 0 ? 'кръг ' + tm.loop + ' / ' + tm.loops : 'кръг ' + (tm.loop || 1)) : ''
    if (!tm.arm) {
      this.caps = 'ТАЙМЕР'
      this.capsColor = '#8E8E93'
      this.status = 'не е включен'
      this.hint = 'настрой го на таблета'
    } else if (tm.run) {
      this.caps = 'ТАЙМЕР · ТЕЧЕ'
      this.capsColor = GREEN
      this.status = 'вибрира 3-2-1'
      this.hint = 'пауза на таймера'
    } else if (tm.pau) {
      this.caps = 'ТАЙМЕР · ПАУЗА'
      this.capsColor = AMBER
      this.status = 'импулсите текат'
      this.hint = 'продължи таймера'
    } else {
      this.caps = 'ТАЙМЕР · ЧАКА'
      this.capsColor = AMBER
      this.status = 'тръгва със старта'
      this.hint = 'на тренировката'
    }
  },

  press() {
    this.pressed = true
  },

  release() {
    this.pressed = false
  },

  toggle() {
    if (this.armed) {
      this.$app.$def.command('tm_toggle')
    }
  }
}
</script>

<style>
.screen {
  width: 212px;
  height: 520px;
  flex-direction: column;
  align-items: center;
  padding-top: 26px;
  background-color: #000000;
}
.caps {
  font-size: 20px;
  font-weight: bold;
}
.ring-box {
  width: 204px;
  height: 204px;
  margin-top: 10px;
}
.ring {
  width: 204px;
  height: 204px;
  stroke-width: 18px;
  background-color: #1c1c1e;
  start-angle: 0deg;
  total-angle: 360deg;
  center-x: 102px;
  center-y: 102px;
  radius: 92px;
}
.center {
  width: 204px;
  height: 204px;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}
.left {
  font-size: 64px;
  font-weight: bold;
}
.loop {
  font-size: 22px;
  color: #ff9f0a;
  font-weight: bold;
}
.status {
  margin-top: 12px;
  width: 200px;
  text-align: center;
  font-size: 21px;
  color: #aeaeb2;
}
.play {
  width: 104px;
  height: 104px;
  margin-top: 20px;
  border-radius: 52px;
  justify-content: center;
  align-items: center;
  transition-property: transform;
  transition-duration: 120ms;
}
.play-img {
  width: 48px;
  height: 48px;
}
.down {
  transform: scale(0.9);
}
.off {
  opacity: 0.3;
}
.hint {
  margin-top: 8px;
  font-size: 18px;
  color: #8e8e93;
}
</style>
