<template>
  <stack class="root" onswipe="onSwipe">
    <div class="screen">
      <div class="ambient" style="background: linear-gradient(180deg, rgba(255,159,10,0.22) 0%, rgba(0,0,0,0) 100%)"></div>
      <div class="ambient-fade"></div>
      <text class="chip-outline" style="color: {{capsColor}}; border-color: {{capsColor}}">{{caps}}</text>
      <stack class="ring-box timer-ring">
        <div class="ring-glow {{run ? 'breathe' : ''}}" style="width: 204px; height: 204px; background-color: {{ringColor}}"></div>
        <progress class="ring ring-track" type="arc" percent="{{pct}}" style="color: {{ringColor}}"></progress>
        <div class="center">
          <text class="left" style="color: {{leftColor}}">{{leftText}}</text>
          <text class="loop">{{loopText}}</text>
        </div>
      </stack>
      <stack class="play-wrap">
        <div class="glow {{armed && !run ? 'breathe' : ''}}" style="width: 138px; height: 138px; background-color: {{armed ? 'rgba(255,159,10,0.25)' : 'rgba(0,0,0,0)'}}"></div>
        <div class="btn play btn-primary {{pressed ? 'down' : ''}} {{armed ? '' : 'off'}}"
             style="width: 126px; height: 126px; border-radius: 63px; background: linear-gradient(180deg, {{run ? '#2C2C2E' : '#FF9F0A'}} 0%, {{run ? '#1C1C1E' : '#CC7A00'}} 100%)"
             ontouchstart="press" ontouchend="release" ontouchcancel="release" onclick="toggle">
          <div class="btn-shine"></div>
          <image class="play-img" src="{{run ? '/common/icons/pause.png' : '/common/icons/play.png'}}" style="width: 58px; height: 58px"></image>
        </div>
      </stack>
      <text class="sub">{{status}}</text>
    </div>
  </stack>
</template>

<script>
import { AMBER, GREEN, mmss, mods, bind, setPages, swipe } from '../../common/ui.js'

export default {
  private: {
    ids: [],
    idsKey: '',
    idx: 0,
    cur: 'main',
    dots: [],
    anim: '',
    caps: 'ТАЙМЕР',
    capsColor: '#8E8E93',
    pct: 0,
    ringColor: AMBER,
    leftText: '--:--',
    leftColor: '#FFFFFF',
    loopText: '',
    status: '',
    run: false,
    armed: false,
    pressed: false
  },

  onInit() {
    setPages(this, ['main'])
    this.unbind = bind(this)
  },

  onDestroy() {
    this.unbind()
  },

  onSwipe(e) {
    swipe(this, e)
  },

  update() {
    const app = this.$app.$def
    const s = app.state
    if (!s) {
      return
    }
    const tm = mods(s).tm
    this.armed = !!tm.arm
    this.run = !!tm.run
    const left = Math.max(0, (tm.left || 0) - (tm.run ? app.silence() : 0))
    const total = Math.max(1, tm.int || 1)
    this.leftText = tm.arm || tm.int ? mmss(left) : '--:--'
    this.pct = tm.arm ? Math.min(100, Math.max(0, Math.round((1 - left / total) * 100))) : 0
    const last = tm.run && left <= 3
    this.leftColor = last ? '#FF453A' : '#FFFFFF'
    this.ringColor = last ? '#FF453A' : AMBER
    this.loopText = tm.lbl ? tm.lbl : tm.arm ? (tm.loops > 0 ? tm.loop + ' / ' + tm.loops : '#' + (tm.loop || 1)) : ''
    if (!tm.arm) {
      this.caps = 'ТАЙМЕР'
      this.capsColor = '#8E8E93'
      this.status = 'включи го на таблета'
    } else if (tm.run) {
      this.caps = 'ТАЙМЕР · ТЕЧЕ'
      this.capsColor = GREEN
      this.status = 'вибрира 3-2-1'
    } else if (tm.pau) {
      this.caps = 'ТАЙМЕР · ПАУЗА'
      this.capsColor = AMBER
      this.status = 'импулсите текат'
    } else {
      this.caps = 'ТАЙМЕР · ЧАКА'
      this.capsColor = AMBER
      this.status = 'тръгва със старта'
    }
  },

  press() { this.pressed = true },
  release() { this.pressed = false },
  toggle() { if (this.armed) { this.$app.$def.command('tm_toggle') } }
}
</script>

<style>
