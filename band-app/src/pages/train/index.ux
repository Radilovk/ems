<template>
  <!-- Start: one vertical scroll — start / pause, all channels, every working channel with its
       own − / + (hold = 5 steps), end (hold). Swipe right = back. -->
  <stack class="root bg-start">
    <scroll class="scr" scroll-y="true">
      <div class="col" style="height: {{colH}}px">
        <div class="ctl">
          <text class="caps" style="color: {{runColor}}">{{caps}}</text>
          <text class="elapsed">{{elapsed}}</text>
          <text class="meta" style="color: {{zoneColor}}">{{meta}}</text>
          <div class="btn play {{pressed === 'play' ? 'down' : ''}}" style="background-color: {{run ? '#2C2C2E' : '#30D158'}}"
               ontouchstart="press('play')" ontouchend="release" ontouchcancel="release" onclick="toggle">
            <image class="play-img" src="{{run ? '/common/icons/pause.png' : '/common/icons/play.png'}}"></image>
          </div>
          <text class="sub">{{run ? 'пауза' : 'старт'}}</text>
        </div>

        <text class="chcap">{{chCaps}}</text>

        <!-- every row: tap the left half = −, the right half = + (hold = 5 steps) -->
        <stack class="cbox {{run ? '' : 'off'}}">
          <div class="halves">
            <div class="half-minus"></div>
            <div class="half-plus"></div>
          </div>
          <div class="cface cface-all">
            <text class="bigsign">-</text>
            <text class="bigsign">+</text>
          </div>
          <div class="ctouch">
            <div class="chalf" onclick="allMinus"></div>
            <div class="chalf" onclick="allPlus"></div>
          </div>
        </stack>

        <stack for="{{chans}}" class="cbox">
          <div class="cfill" style="width: {{$item.w}}px; background-color: {{$item.fill}}"></div>
          <div class="cface">
            <text class="cname">{{$item.name}}</text>
            <div class="cline">
              <text class="csign">-</text>
              <text class="cval" style="color: {{$item.color}}">{{$item.text}}</text>
              <text class="csign">+</text>
            </div>
          </div>
          <div class="ctouch">
            <div class="chalf" onclick="chMinus($item.i)" onlongpress="chMinus5($item.i)"></div>
            <div class="chalf" onclick="chPlus($item.i)" onlongpress="chPlus5($item.i)"></div>
          </div>
        </stack>

        <div class="stop-item">
          <text class="caps">КРАЙ</text>
          <stack class="stop-box" ontouchstart="holdStart" ontouchend="holdEnd" ontouchcancel="holdEnd">
            <progress class="stop-ring" type="arc" percent="{{holdPct}}" style="color: #FF453A"></progress>
            <div class="stop-core">
              <image class="stop-img" src="/common/icons/stop.png"></image>
            </div>
          </stack>
          <text class="sub">{{holdPct > 0 ? 'дръж…' : 'задръж 1 сек'}}</text>
        </div>
      </div>
    </scroll>
  </stack>
</template>

<script>
import { ZONE, GREEN, AMBER, hms, zoneOf, mods, bind } from '../../common/ui.js'

const HOLD_MS = 1200
/** Channel index (PartStrenthBean.buwei) → name; shown in the tablet's order, legs up to arms. */
const NAMES = ['Гърди', 'Корем', 'Предно бедро', 'Прасец', 'Ръце', 'Трапец', 'Гръб', 'Кръст', 'Седалище', 'Задно бедро']
const ORDER = [3, 2, 9, 8, 1, 7, 6, 5, 0, 4]
const FILL_W = 192

export default {
  private: {
    caps: 'СТАРТ',
    runColor: '#8E8E93',
    run: false,
    elapsed: '0:00',
    meta: '',
    zoneColor: '#AEAEB2',
    pressed: '',
    holdPct: 0,
    busy: false,
    allHint: '',
    chCaps: 'КАНАЛИ',
    chans: [],
    chKey: '',
    colH: 1052
  },

  onInit() {
    this.optim = {}
    this.unbind = bind(this)
  },

  onDestroy() {
    this.unbind()
    this.holdEnd()
  },

  update() {
    const app = this.$app.$def
    const s = app.state
    if (!s) {
      return
    }
    const run = !!mods(s).tr.run
    this.run = run
    this.busy = app.busy()
    this.caps = run ? 'АКТИВЕН' : s.mode === 'manual' ? 'ПАУЗА' : 'ГОТОВ'
    this.runColor = run ? GREEN : s.mode === 'manual' ? AMBER : '#8E8E93'
    this.elapsed = hms((s.el || 0) + (run ? app.silence() : 0))
    const z = s.hr > 0 ? s.z || zoneOf(s.hr, s.lim || 170) : 0
    this.meta = s.hr > 0 ? '♥ ' + s.hr + ' · Z' + z : 'няма пулс'
    this.zoneColor = s.hr > 0 ? ZONE[z] : '#AEAEB2'
    this.allHint = run ? '' : 'първо старт'
    this.buildChannels(s.ch || [])
  },

  /** Working channels in the tablet's order (off ones have no buttons, so they are left out). */
  buildChannels(ch) {
    const out = []
    ORDER.forEach((i) => {
      if (i >= ch.length || ch[i] < 0) {
        return
      }
      let pct = Math.max(0, Math.min(100, ch[i]))
      // a tap shows its value at once; the tablet's answer confirms it (or corrects it)
      const o = this.optim[i]
      if (o) {
        if (o.v === pct || Date.now() - o.at > 1500) {
          delete this.optim[i]
        } else {
          pct = o.v
        }
      }
      out.push({
        i: i,
        name: NAMES[i] || 'Канал ' + (i + 1),
        text: String(pct),
        w: Math.round((FILL_W * pct) / 100),
        fill: pct >= 80 ? '#5C1A16' : pct >= 50 ? '#5A3A0C' : '#17462A',
        color: pct >= 80 ? '#FF453A' : pct >= 50 ? '#FF9F0A' : '#30D158'
      })
    })
    this.chCaps = out.length ? 'КАНАЛИ · ' + out.length : 'няма канали'
    const key = JSON.stringify(out)
    if (key !== this.chKey) {
      this.chKey = key
      this.chans = out
      // the scroll needs the real content height (children never shrink)
      this.colH = 392 + 44 + 86 + out.length * 86 + 400
    }
  },

  step(c, d) {
    const app = this.$app.$def
    const ch = (app.state && app.state.ch) || []
    if (c < ch.length && ch[c] >= 0) {
      const base = this.optim[c] ? this.optim[c].v : ch[c]
      this.optim[c] = { v: Math.max(0, Math.min(100, base + d)), at: Date.now() }
      this.buildChannels(ch)
    }
    app.command(d > 0 ? 'ch_plus' : 'ch_minus', { c: c, d: Math.abs(d) })
  },

  chPlus(c) {
    this.step(c, 1)
  },

  chMinus(c) {
    this.step(c, -1)
  },

  chPlus5(c) {
    this.step(c, 5)
  },

  chMinus5(c) {
    this.step(c, -5)
  },

  press(w) {
    this.pressed = w
  },

  release() {
    this.pressed = ''
  },

  toggle() {
    this.$app.$def.command('train_toggle')
  },

  allPlus() {
    if (this.run) {
      this.$app.$def.command('train_plus')
    }
  },

  allMinus() {
    if (this.run) {
      this.$app.$def.command('train_minus')
    }
  },

  holdStart() {
    this.holdEnd()
    const t0 = Date.now()
    this.holdTimer = setInterval(() => {
      const p = Math.min(100, Math.round(((Date.now() - t0) / HOLD_MS) * 100))
      this.holdPct = p
      if (p >= 100) {
        clearInterval(this.holdTimer)
        this.holdTimer = null
        this.$app.$def.command('train_stop', null, 'long')
        setTimeout(() => {
          this.holdPct = 0
        }, 400)
      }
    }, 40)
  },

  holdEnd() {
    if (this.holdTimer) {
      clearInterval(this.holdTimer)
      this.holdTimer = null
      this.holdPct = 0
    }
  }
}
</script>

<style>
/* ---- common (scripts/gen-pages.py stamps this into every page) ---- */
.root {
  width: 212px;
  height: 520px;
  background-color: #000000;
}
.screen {
  width: 212px;
  height: 520px;
  flex-direction: column;
  align-items: center;
  padding-top: 46px;
}
.scr {
  width: 212px;
  height: 520px;
}
.col {
  flex-shrink: 0;
  width: 212px;
  flex-direction: column;
}
.in-up {
  animation-name: inUp;
  animation-duration: 260ms;
  animation-timing-function: ease-out;
}
.in-down {
  animation-name: inDown;
  animation-duration: 260ms;
  animation-timing-function: ease-out;
}
.dots {
  width: 16px;
  height: 520px;
  margin-left: 196px;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}
.pdot {
  width: 8px;
  height: 8px;
  margin-top: 4px;
  margin-bottom: 4px;
  border-radius: 4px;
  background-color: #3a3a3c;
}
.pdot-on {
  height: 22px;
  background-color: #ffffff;
}
.caps {
  flex-shrink: 0;
  font-size: 24px;
  font-weight: bold;
  color: #8e8e93;
}
.sub {
  flex-shrink: 0;
  width: 196px;
  text-align: center;
  font-size: 24px;
  color: #aeaeb2;
}
.down {
  transform: scale(0.92);
}
.btn {
  flex-shrink: 0;
  justify-content: center;
  align-items: center;
  transition-property: transform;
  transition-duration: 120ms;
}
.off {
  opacity: 0.3;
}
@keyframes inUp {
  from {
    transform: translateY(90px);
    opacity: 0;
  }
  to {
    transform: translateY(0px);
    opacity: 1;
  }
}
@keyframes inDown {
  from {
    transform: translateY(-90px);
    opacity: 0;
  }
  to {
    transform: translateY(0px);
    opacity: 1;
  }
}
@keyframes breathe {
  from {
    transform: scale(0.86);
    opacity: 0.9;
  }
  to {
    transform: scale(1.12);
    opacity: 0.2;
  }
}
@keyframes beat {
  from {
    transform: scale(1);
  }
  to {
    transform: scale(1.25);
  }
}
/* ---- page ---- */
.bg-start {
  flex-shrink: 0;
  background-image: url(/common/bg/start.png);
  background-size: cover;
}
.elapsed {
  flex-shrink: 0;
  margin-top: 16px;
  font-size: 68px;
  font-weight: bold;
  color: #ffffff;
}
.meta {
  flex-shrink: 0;
  font-size: 26px;
  font-weight: bold;
}
.sync {
  flex-shrink: 0;
  margin-top: 10px;
  font-size: 22px;
  color: #ff9f0a;
}
.ctl {
  flex-shrink: 0;
  height: 392px;
  width: 212px;
  flex-direction: column;
  align-items: center;
  padding-top: 42px;
}
.play {
  flex-shrink: 0;
  width: 130px;
  height: 130px;
  margin-top: 14px;
  border-radius: 65px;
}
.play-img {
  flex-shrink: 0;
  width: 60px;
  height: 60px;
}
.chcap {
  flex-shrink: 0;
  height: 44px;
  width: 196px;
  margin-left: 8px;
  margin-top: 10px;
  text-align: center;
  font-size: 24px;
  font-weight: bold;
  color: #8e8e93;
}
.cbox {
  flex-shrink: 0;
  width: 196px;
  height: 76px;
  margin-left: 8px;
  margin-top: 10px;
}
.cfill {
  flex-shrink: 0;
  height: 72px;
  margin-left: 2px;
  margin-top: 2px;
  border-radius: 20px;
  transition-property: width;
  transition-duration: 250ms;
}
.cface {
  flex-shrink: 0;
  width: 196px;
  height: 76px;
  padding-top: 6px;
  flex-direction: column;
  align-items: center;
  border-width: 2px;
  border-color: #48484a;
  border-radius: 22px;
}
.cname {
  flex-shrink: 0;
  width: 180px;
  text-align: center;
  font-size: 22px;
  font-weight: bold;
  color: #ffffff;
  lines: 1;
}
.cline {
  flex-shrink: 0;
  width: 192px;
  flex-direction: row;
  align-items: center;
}
.csign {
  flex-shrink: 0;
  width: 34px;
  text-align: center;
  font-size: 30px;
  color: #8e8e93;
}
.cval {
  flex-shrink: 0;
  width: 124px;
  text-align: center;
  font-size: 30px;
  font-weight: bold;
  lines: 1;
}
.chint {
  font-size: 20px;
  color: #8e8e93;
}
.cface-all {
  flex-direction: row;
  padding-top: 0px;
}
.bigsign {
  flex-shrink: 0;
  width: 96px;
  text-align: center;
  font-size: 52px;
  font-weight: bold;
  color: #ffffff;
}
.halves {
  flex-shrink: 0;
  width: 196px;
  height: 76px;
  flex-direction: row;
}
.half-minus {
  flex-shrink: 0;
  width: 98px;
  height: 76px;
  border-top-left-radius: 22px;
  border-bottom-left-radius: 22px;
  background-color: #17462a;
}
.half-plus {
  flex-shrink: 0;
  width: 98px;
  height: 76px;
  border-top-right-radius: 22px;
  border-bottom-right-radius: 22px;
  background-color: #5c1a16;
}
.ctouch {
  flex-shrink: 0;
  width: 196px;
  height: 76px;
  flex-direction: row;
}
.chalf {
  flex-shrink: 0;
  width: 98px;
  height: 76px;
}
.stop-item {
  flex-shrink: 0;
  height: 400px;
  width: 212px;
  flex-direction: column;
  align-items: center;
  padding-top: 24px;
  padding-bottom: 100px;
}
.stop-box {
  flex-shrink: 0;
  width: 190px;
  height: 190px;
  margin-top: 12px;
  justify-content: center;
  align-items: center;
}
.stop-ring {
  flex-shrink: 0;
  width: 190px;
  height: 190px;
  stroke-width: 14px;
  background-color: #3a0f0d;
  start-angle: 0deg;
  total-angle: 360deg;
  center-x: 95px;
  center-y: 95px;
  radius: 86px;
}
.stop-core {
  flex-shrink: 0;
  width: 140px;
  height: 140px;
  border-radius: 70px;
  background-color: #c62828;
  justify-content: center;
  align-items: center;
}
.stop-img {
  flex-shrink: 0;
  width: 60px;
  height: 60px;
}
</style>
