<template>
  <stack class="root" onswipe="onSwipe">
    <div class="screen {{anim}}" if="{{cur === 'main'}}">
      <div class="ambient" style="background: linear-gradient(180deg, rgba(48,209,88,0.2) 0%, rgba(0,0,0,0) 100%)"></div>
      <div class="ambient-fade"></div>
      <text class="chip-outline" style="color: {{runColor}}; border-color: {{runColor}}">{{caps}}</text>
      <text class="elapsed">{{elapsed}}</text>
      <text class="meta chip" style="background-color: {{zoneColor}}">{{meta}}</text>
      <stack class="play-wrap play-box">
        <div class="glow {{run ? '' : 'breathe'}}" style="width: 156px; height: 156px; background-color: {{run ? 'rgba(0,0,0,0)' : 'rgba(48,209,88,0.28)'}}"></div>
        <div class="btn play btn-primary {{pressed === 'play' ? 'down' : ''}}"
             style="width: 136px; height: 136px; border-radius: 68px; background: linear-gradient(180deg, {{run ? '#2C2C2E' : '#30D158'}} 0%, {{run ? '#1C1C1E' : '#1F9A42'}} 100%)"
             ontouchstart="press('play')" ontouchend="release" ontouchcancel="release" onclick="toggle">
          <div class="btn-shine"></div>
          <image class="play-img" src="{{run ? '/common/icons/pause.png' : '/common/icons/play.png'}}" style="width: 62px; height: 62px"></image>
        </div>
      </stack>
      <text class="sub">{{run ? 'пауза' : 'старт'}}</text>
    </div>

    <div class="screen {{anim}}" if="{{cur === 'power'}}">
      <text class="caps">ГЛАВЕН</text>
      <div class="btn btn-pill btn-pill-accent plus {{run ? '' : 'off'}} {{pressed === 'plus' ? 'down' : ''}}"
           style="margin-top: 28px; height: 120px; background: linear-gradient(180deg, #1f4a2a 0%, #142e1a 100%)"
           ontouchstart="press('plus')" ontouchend="release" ontouchcancel="release" onclick="plus">
        <image class="pill-img" src="/common/icons/plus.png"></image>
      </div>
      <div class="btn btn-pill {{run ? '' : 'off'}} {{pressed === 'minus' ? 'down' : ''}}"
           style="height: 120px"
           ontouchstart="press('minus')" ontouchend="release" ontouchcancel="release" onclick="minus">
        <image class="pill-img" src="/common/icons/minus.png"></image>
      </div>
      <text class="sub">{{run ? 'една стъпка на натиск' : 'първо старт'}}</text>
    </div>

    <div class="screen {{anim}}" if="{{cur === 'stop'}}">
      <text class="caps">КРАЙ</text>
      <stack class="stop-box stop-wrap" ontouchstart="holdStart" ontouchend="holdEnd" ontouchcancel="holdEnd">
        <progress class="stop-ring" type="arc" percent="{{holdPct}}" style="color: #FF453A; width: 188px; height: 188px; center-x: 94px; center-y: 94px; radius: 84px"></progress>
        <div class="stop-core" style="width: 136px; height: 136px; border-radius: 68px; background: linear-gradient(180deg, #ff453a 0%, #c62828 100%)">
          <image class="stop-img" src="/common/icons/stop.png"></image>
        </div>
      </stack>
      <text class="sub">{{holdPct > 0 ? 'дръж…' : 'задръж 1 секунда'}}</text>
    </div>

    <div class="dots">
      <div for="{{dots}}" class="pdot {{$item.on ? 'pdot-on' : ''}}" style="background-color: {{$item.on ? dotAccent : '#3A3A3C'}}"></div>
    </div>
  </stack>
</template>

<script>
import { ZONE, GREEN, AMBER, hms, zoneOf, mods, bind, setPages, swipe } from '../../common/ui.js'

const HOLD_MS = 1200

export default {
  private: {
    ids: [],
    idsKey: '',
    idx: 0,
    cur: 'main',
    dots: [],
    dotAccent: GREEN,
    anim: '',
    caps: 'ТРЕНИРОВКА',
    runColor: '#8E8E93',
    run: false,
    elapsed: '0:00',
    meta: '',
    zoneColor: '#2C2C2E',
    pressed: '',
    holdPct: 0
  },

  onInit() {
    setPages(this, ['main', 'power', 'stop'], GREEN)
    this.unbind = bind(this)
  },

  onDestroy() {
    this.unbind()
    this.holdEnd()
  },

  onSwipe(e) {
    swipe(this, e)
  },

  update() {
    const app = this.$app.$def
    const s = app.state
    if (!s) {
      return
    }
    const run = !!mods(s).tr.run
    this.run = run
    this.caps = run ? 'РЪЧНО · ТЕЧЕ' : s.mode === 'manual' ? 'РЪЧНО · ПАУЗА' : 'РЪЧНО'
    this.runColor = run ? GREEN : s.mode === 'manual' ? AMBER : '#8E8E93'
    this.elapsed = hms((s.el || 0) + (run ? app.silence() : 0))
    const z = s.hr > 0 ? s.z || zoneOf(s.hr, s.lim || 170) : 0
    this.meta = s.hr > 0 ? s.hr + ' · Z' + z : 'няма пулс'
    this.zoneColor = s.hr > 0 ? ZONE[z] : '#2C2C2E'
  },

  press(w) { this.pressed = w },
  release() { this.pressed = '' },
  toggle() { this.$app.$def.command('train_toggle') },
  plus() { if (this.run) { this.$app.$def.command('train_plus') } },
  minus() { if (this.run) { this.$app.$def.command('train_minus') } },

  holdStart() {
    this.holdEnd()
    const t0 = Date.now()
    this.holdTimer = setInterval(() => {
      const p = Math.min(100, Math.round(((Date.now() - t0) / HOLD_MS) * 100))
      this.holdPct = p
      if (p >= 100) {
        clearInterval(this.holdTimer)
        this.holdTimer = null
        this.$app.$def.send({ t: 'cmd', a: 'train_stop' })
        this.$app.$def.buzz('long')
        setTimeout(() => { this.holdPct = 0 }, 400)
      }
    }, 40)
  },

  holdEnd() {
    if (this.holdTimer) {
      clearInterval(this.holdTimer)
      this.holdTimer = null
      this.holdPct = 0
    }
  }
}
</script>

<style>
/* ---- common (scripts/gen-pages.py stamps this into every page) ---- */
/* XEMS Band v4 — shared design system (212 × 520 AMOLED) */
.root {
  width: 212px;
  height: 520px;
  background-color: #000000;
}
