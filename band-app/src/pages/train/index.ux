<template>
  <!-- Start: scroll list + hold-to-slide overlay for per-channel strength. -->
  <stack class="root bg-start">
    <scroll id="trainScr" class="scr" scroll-y="true" scroll-top="{{scrollTop}}" onscroll="onScroll">
      <div class="col" style="height: {{colH}}px">
        <div class="ctl">
          <text class="caps" style="color: {{runColor}}">{{caps}}</text>
          <text class="elapsed">{{elapsed}}</text>
          <div class="kpis">
            <div class="kpi">
              <text class="kpi-num">{{msText}}</text>
              <text class="kpi-lbl">сила</text>
            </div>
            <div class="kpi">
              <text class="kpi-num" style="color: {{zoneColor}}">{{hrText}}</text>
              <text class="kpi-lbl">{{zoneText}}</text>
            </div>
          </div>
          <div class="btn play {{pressed === 'play' ? 'down' : ''}}" style="background-color: {{run ? '#2C2C2E' : '#30D158'}}"
               ontouchstart="press('play')" ontouchend="release" ontouchcancel="release" onclick="toggle">
            <image class="play-img" src="{{run ? '/common/icons/pause.png' : '/common/icons/play.png'}}"></image>
          </div>
        </div>

        <stack class="cbox">
          <image class="cfill all-fill" src="{{allBtnSrc}}"></image>
          <div class="cface cface-all">
            <text class="bigsign">-</text>
            <text class="bigsign">+</text>
          </div>
          <div class="ctouch">
            <div class="chalf" onclick="allMinus"></div>
            <div class="chalf" onclick="allPlus"></div>
          </div>
        </stack>

        <text class="chcap">{{chCaps}}</text>

        <stack for="{{chans}}" class="cbox">
          <div class="cfill" style="width: {{$item.w}}px; background-color: {{$item.fill}}"></div>
          <stack class="cface">
            <div class="cline">
              <text class="csign">-</text>
              <text class="cval" style="color: {{$item.color}}">{{$item.text}}</text>
              <text class="csign">+</text>
            </div>
            <text class="cname">{{$item.name}}</text>
          </stack>
          <div class="ctouch ch-row-touch"
               ontouchstart="chTouchStart($item.i, $item.text, $item.name, $event)"
               ontouchmove="chTouchMove($event)"
               ontouchend="chTouchEnd($event)"
               ontouchcancel="chTouchEnd($event)"></div>
        </stack>

        <div class="stop-item">
          <text class="caps">КРАЙ</text>
          <stack class="stop-box" ontouchstart="holdStart" ontouchend="holdEnd" ontouchcancel="holdEnd">
            <progress class="stop-ring" type="arc" percent="{{holdPct}}" style="color: #FF453A"></progress>
            <div class="stop-core">
              <image class="stop-img" src="/common/icons/stop.png"></image>
            </div>
          </stack>
          <text class="sub">{{holdPct > 0 ? 'дръж…' : 'задръж 1 сек'}}</text>
          <text class="rtt">{{rttText}}</text>
        </div>
      </div>
    </scroll>

    <!-- Hold any channel → vertical slider; scroll position kept underneath. -->
    <div class="slide-screen {{slideAnim}} {{slideDim ? 'slide-dim' : ''}}" if="{{slideOn}}"
         ontouchstart="slideTouch" ontouchmove="slideTouch" ontouchend="slideEnd" ontouchcancel="slideEnd">
      <div class="slide-bg"></div>
      <text class="slide-val" style="color: {{slideColor}}">{{slideVal}}</text>
      <text class="slide-name">{{slideName}}</text>
      <stack class="slide-track">
        <div class="slide-rail"></div>
        <div class="slide-fill" style="height: {{slideFillH}}px; background-color: {{slideFill}}"></div>
        <div class="slide-knob" style="bottom: {{slideKnobB}}px"></div>
      </stack>
      <text class="slide-hint">{{slideHint}}</text>
    </div>
  </stack>
</template>

<script>
import { GREEN, AMBER, RED, hms, zoneOf, zoneColor, mods, bind, shown } from '../../common/ui.js'

const HOLD_MS = 1200
const SLIDE_OPEN_MS = 400
const SLIDE_COMMIT_MS = 500
const SLIDE_CLOSE_MS = 3000
const TAP_MAX_MS = 320
const TAP_MAX_MOVE = 16
const SLIDE_TRACK_H = 300
const SLIDE_TRACK_TOP = 158
const SLIDE_TRACK_W = 56
const NAMES = ['Гърди', 'Корем', 'Предно бедро', 'Прасец', 'Ръце', 'Трапец', 'Гръб', 'Кръст', 'Седалище', 'Задно бедро']
const ORDER = [3, 2, 9, 8, 1, 7, 6, 5, 0, 4]
const FILL_W = 192
const FILL_DIM = ['#17462A', '#5A3A0C', '#5C1A16']

function tier(pct) {
  return pct >= 80 ? 2 : pct >= 50 ? 1 : 0
}

function channelStyle(pct, live) {
  const t = tier(pct)
  const accent = t === 2 ? RED : t === 1 ? AMBER : GREEN
  if (live) {
    return { fill: accent, color: '#FFFFFF' }
  }
  return { fill: FILL_DIM[t], color: accent }
}

function touchY(e) {
  const t = (e.touches && e.touches[0]) || (e.changedTouches && e.changedTouches[0])
  return t ? t.pageY : 0
}

function touchX(e) {
  const t = (e.touches && e.touches[0]) || (e.changedTouches && e.changedTouches[0])
  return t ? t.pageX : 0
}

export default {
  private: {
    caps: 'СТАРТ',
    runColor: '#8E8E93',
    run: false,
    elapsed: '0:00',
    zoneColor: '#AEAEB2',
    pressed: '',
    holdPct: 0,
    msText: '--',
    hrText: '--',
    zoneText: 'пулс',
    rttText: '',
    chCaps: 'КАНАЛИ',
    chans: [],
    chKey: '',
    colH: 1052,
    allBtnSrc: '/common/ui/all-btn-dim.png',
    scrollTop: 0,
    slideOn: false,
    slideIdx: -1,
    slideName: '',
    slideVal: '0',
    slideColor: '#FFFFFF',
    slideFill: GREEN,
    slideFillH: 0,
    slideKnobB: 0,
    slideHint: 'плъзни нагоре / надолу',
    slideAnim: 'slide-in',
    slideDim: false
  },

  onInit() {
    this.optim = {}
    this.optMs = null
    this.savedScroll = 0
    this.unbind = bind(this)
  },

  onShow() {
    shown(this, true)
  },

  onHide() {
    shown(this, false)
    this.holdEnd()
    this.closeSlideNow()
  },

  onDestroy() {
    this.unbind()
    this.holdEnd()
    this.closeSlideNow()
  },

  onScroll(e) {
    if (!this.slideOn) {
      const y = e.scrollY != null ? e.scrollY : (e.detail && e.detail.scrollY) || 0
      this.savedScroll = y
      this.scrollTop = y
    }
  },

  update() {
    const app = this.$app.$def
    const s = app.state
    if (!s) {
      return
    }
    const run = !!mods(s).tr.run
    this.run = run
    this.caps = run ? 'АКТИВЕН' : s.mode === 'manual' ? 'ПАУЗА' : 'ГОТОВ'
    this.runColor = run ? GREEN : s.mode === 'manual' ? AMBER : '#8E8E93'
    this.elapsed = hms((s.el || 0) + (run ? app.silence() : 0))
    const z = s.hr > 0 ? s.z || zoneOf(s.hr, s.lim || 170) : 0
    this.hrText = s.hr > 0 ? String(s.hr) : '--'
    this.zoneText = s.hr > 0 ? 'пулс · Z' + z : 'пулс'
    let ms = s.ms != null ? s.ms : -1
    const o = this.optMs
    if (o) {
      if (o.v === ms || Date.now() - o.at > 1500) {
        this.optMs = null
      } else {
        ms = o.v
      }
    }
    this.msText = ms >= 0 ? String(ms) : '--'
    this.rttText = app.rtt ? 'отговор ' + (app.rtt / 1000).toFixed(1) + ' с' : ''
    this.zoneColor = s.hr > 0 ? zoneColor(z) : '#AEAEB2'
    this.allBtnSrc = run ? '/common/ui/all-btn.png' : '/common/ui/all-btn-dim.png'
    if (this.slideOn) {
      this.slideDim = !run
      if (this.slideDim) {
        this.slideHint = 'пауза · плъзгачът е само за преглед'
      }
    } else {
      this.buildChannels(s.ch || [], run)
    }
  },

  buildChannels(ch, live) {
    if (live === undefined) {
      live = this.run
    }
    const out = []
    ORDER.forEach((i) => {
      if (i >= ch.length || ch[i] < 0) {
        return
      }
      let pct = Math.max(0, Math.min(100, ch[i]))
      const o = this.optim[i]
      if (o) {
        if (o.v === pct || Date.now() - o.at > 1500) {
          delete this.optim[i]
        } else {
          pct = o.v
        }
      }
      const style = channelStyle(pct, live)
      out.push({
        i: i,
        name: NAMES[i] || 'Канал ' + (i + 1),
        text: String(pct),
        w: Math.round((FILL_W * pct) / 100),
        fill: style.fill,
        color: style.color
      })
    })
    this.chCaps = out.length ? 'КАНАЛИ · ' + out.length : 'няма канали'
    const key = (live ? '1' : '0') + JSON.stringify(out)
    if (key === this.chKey) {
      return
    }
    this.chKey = key
    const same = this.chans.length === out.length && this.chans.every((c, k) => c.i === out[k].i)
    if (same) {
      out.forEach((n, k) => {
        const c = this.chans[k]
        if (c.text !== n.text || c.w !== n.w || c.color !== n.color || c.fill !== n.fill) {
          c.text = n.text
          c.w = n.w
          c.color = n.color
          c.fill = n.fill
        }
      })
    } else {
      this.chans = out
      this.colH = 340 + 86 + 44 + out.length * 86 + 400
    }
  },

  yToVal(y) {
    const rel = y - SLIDE_TRACK_TOP
    const t = 1 - rel / SLIDE_TRACK_H
    return Math.max(0, Math.min(100, Math.round(t * 100)))
  },

  updateSlideVisual(v) {
    const style = channelStyle(v, this.run)
    this.slideVal = String(v)
    this.slideColor = style.color
    this.slideFill = style.fill
    this.slideFillH = Math.round((SLIDE_TRACK_H * v) / 100)
    this.slideKnobB = this.slideFillH - 18
    if (this.slideKnobB < 0) {
      this.slideKnobB = 0
    }
  },

  openSlide(i, val, name) {
    if (this.chTouch) {
      this.chTouch.opened = true
    }
    clearTimeout(this.slideCloseTimer)
    this.slideIdx = i
    this.slideName = name
    this.slideDraft = val
    this.slideSent = val
    this.slideTouching = true
    this.slideOn = true
    this.slideAnim = 'slide-in'
    this.slideDim = !this.run
    this.slideTick = Math.floor(val / 10)
    this.scrollTop = this.savedScroll
    this.updateSlideVisual(val)
    this.slideHint = this.slideDim ? 'пауза · плъзгачът е само за преглед' : 'плъзни нагоре / надолу'
    const y = this.chTouch && this.chTouch.y
    if (y) {
      this.setSlideFromY(y)
    }
    this.armSlideCommit()
  },

  setSlideFromY(y) {
    const v = this.yToVal(y)
    if (v === this.slideDraft) {
      return
    }
    const tick = Math.floor(v / 10)
    if (tick !== this.slideTick) {
      this.slideTick = tick
      this.$app.$def.buzz('short')
    }
    this.slideDraft = v
    this.updateSlideVisual(v)
    this.optim[this.slideIdx] = { v: v, at: Date.now() }
    const ch = (this.$app.$def.state && this.$app.$def.state.ch) || []
    this.buildChannels(ch, this.run)
    if (!this.slideDim) {
      this.armSlideCommit()
    }
  },

  armSlideCommit() {
    clearTimeout(this.slideCommitTimer)
    this.slideCommitTimer = setTimeout(() => {
      if (this.slideTouching && this.slideDraft !== this.slideSent) {
        this.commitSlide()
      }
    }, SLIDE_COMMIT_MS)
  },

  commitSlide() {
    if (this.slideIdx < 0 || this.slideDraft === this.slideSent || this.slideDim) {
      return
    }
    this.slideSent = this.slideDraft
    this.slideHint = 'изпратено · ' + this.slideDraft
    this.$app.$def.command('ch_set', { c: this.slideIdx, v: this.slideDraft }, 'none')
  },

  chTouchStart(i, text, name, e) {
    if (this.slideOn) {
      return
    }
    const y = touchY(e)
    const x = touchX(e)
    this.chTouch = {
      i: i,
      name: name,
      val: parseInt(text, 10) || 0,
      startX: x,
      startY: y,
      y: y,
      t0: Date.now(),
      moved: false,
      opened: false
    }
    clearTimeout(this.chOpenTimer)
    this.chOpenTimer = setTimeout(() => {
      if (this.chTouch && this.chTouch.i === i && !this.chTouch.opened) {
        this.openSlide(i, this.chTouch.val, name)
      }
    }, SLIDE_OPEN_MS)
  },

  chTouchMove(e) {
    const touch = this.chTouch
    if (!touch) {
      return
    }
    const y = touchY(e)
    const x = touchX(e)
    touch.y = y
    if (Math.abs(x - touch.startX) > TAP_MAX_MOVE || Math.abs(y - touch.startY) > TAP_MAX_MOVE) {
      touch.moved = true
    }
    if (this.slideOn && this.slideTouching) {
      this.setSlideFromY(y)
    }
  },

  chTouchEnd(e) {
    clearTimeout(this.chOpenTimer)
    const touch = this.chTouch
    if (touch && touch.opened) {
      this.chTouch = null
      this.slideEnd(e)
      return
    }
    this.chTouch = null
    if (!touch) {
      return
    }
    const elapsed = Date.now() - touch.t0
    if (elapsed >= SLIDE_OPEN_MS || touch.opened) {
      return
    }
    if (!touch.moved && elapsed <= TAP_MAX_MS) {
      const x = touchX(e) || touch.x
      if (x < 106) {
        this.chMinus(touch.i)
      } else {
        this.chPlus(touch.i)
      }
    }
  },

  slideTouch(e) {
    if (!this.slideOn) {
      return
    }
    this.slideTouching = true
    this.setSlideFromY(touchY(e))
  },

  slideEnd(e) {
    this.slideTouching = false
    clearTimeout(this.slideCommitTimer)
    clearTimeout(this.chOpenTimer)
    this.chTouch = null
    if (this.slideDraft !== this.slideSent) {
      this.commitSlide()
    }
    this.slideHint = 'затваряне…'
    clearTimeout(this.slideCloseTimer)
    this.slideCloseTimer = setTimeout(() => {
      this.slideOn = false
      this.slideIdx = -1
      this.scrollTop = this.savedScroll
      const ch = (this.$app.$def.state && this.$app.$def.state.ch) || []
      this.buildChannels(ch, this.run)
    }, SLIDE_CLOSE_MS)
  },

  closeSlideNow() {
    clearTimeout(this.slideCloseTimer)
    clearTimeout(this.slideCommitTimer)
    clearTimeout(this.chOpenTimer)
    this.slideOn = false
    this.slideTouching = false
    this.chTouch = null
  },

  step(c, d) {
    const app = this.$app.$def
    const ch = (app.state && app.state.ch) || []
    if (c < ch.length && ch[c] >= 0) {
      const base = this.optim[c] ? this.optim[c].v : ch[c]
      this.optim[c] = { v: Math.max(0, Math.min(100, base + d)), at: Date.now() }
      this.buildChannels(ch)
    }
    app.command(d > 0 ? 'ch_plus' : 'ch_minus', { c: c, d: 1 })
  },

  chPlus(c) {
    this.step(c, 1)
  },

  chMinus(c) {
    this.step(c, -1)
  },

  press(w) {
    this.pressed = w
  },

  release() {
    this.pressed = ''
  },

  toggle() {
    this.$app.$def.command('train_toggle')
  },

  allPlus() {
    this.mainStep(1)
  },

  allMinus() {
    this.mainStep(-1)
  },

  mainStep(d) {
    if (!this.run) {
      return
    }
    const app = this.$app.$def
    const ms = app.state && app.state.ms != null ? app.state.ms : -1
    const base = this.optMs ? this.optMs.v : ms
    if (base >= 0) {
      this.optMs = { v: Math.max(0, Math.min(100, base + d)), at: Date.now() }
      this.msText = String(this.optMs.v)
    }
    app.command(d > 0 ? 'train_plus' : 'train_minus')
  },

  holdStart() {
    this.holdEnd()
    const t0 = Date.now()
    this.holdTimer = setInterval(() => {
      const p = Math.min(100, Math.round(((Date.now() - t0) / HOLD_MS) * 100))
      this.holdPct = p
      if (p >= 100) {
        clearInterval(this.holdTimer)
        this.holdTimer = null
        this.$app.$def.command('train_stop', null, 'long')
        setTimeout(() => {
          this.holdPct = 0
        }, 400)
      }
    }, 40)
  },

  holdEnd() {
    if (this.holdTimer) {
      clearInterval(this.holdTimer)
      this.holdTimer = null
      this.holdPct = 0
    }
  }
}
</script>

<style>
/* ---- common (scripts/gen-pages.py stamps this into every page) ---- */
.root {
  width: 212px;
  height: 520px;
  background-color: #000000;
}
.screen {
  width: 212px;
  height: 520px;
  flex-direction: column;
  align-items: center;
  padding-top: 46px;
}
.scr {
  width: 212px;
  height: 520px;
}
.col {
  flex-shrink: 0;
  width: 212px;
  flex-direction: column;
}
.in-up {
  animation-name: inUp;
  animation-duration: 260ms;
  animation-timing-function: ease-out;
}
.in-down {
  animation-name: inDown;
  animation-duration: 260ms;
  animation-timing-function: ease-out;
}
.dots {
  width: 16px;
  height: 520px;
  margin-left: 196px;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}
.pdot {
  width: 8px;
  height: 8px;
  margin-top: 4px;
  margin-bottom: 4px;
  border-radius: 4px;
  background-color: #3a3a3c;
}
.pdot-on {
  height: 22px;
  background-color: #ffffff;
}
.caps {
  flex-shrink: 0;
  font-size: 24px;
  font-weight: bold;
  color: #8e8e93;
}
.sub {
  flex-shrink: 0;
  width: 196px;
  text-align: center;
  font-size: 24px;
  color: #aeaeb2;
}
.down {
  transform: scale(0.92);
}
.btn {
  flex-shrink: 0;
  justify-content: center;
  align-items: center;
  transition-property: transform;
  transition-duration: 120ms;
}
.off {
  opacity: 0.3;
}
@keyframes inUp {
  from {
    transform: translateY(90px);
    opacity: 0;
  }
  to {
    transform: translateY(0px);
    opacity: 1;
  }
}
@keyframes inDown {
  from {
    transform: translateY(-90px);
    opacity: 0;
  }
  to {
    transform: translateY(0px);
    opacity: 1;
  }
}
@keyframes breathe {
  from {
    transform: scale(0.86);
    opacity: 0.9;
  }
  to {
    transform: scale(1.12);
    opacity: 0.2;
  }
}
@keyframes beat {
  from {
    transform: scale(1);
  }
  to {
    transform: scale(1.25);
  }
}
/* ---- page ---- */
.bg-start {
  flex-shrink: 0;
  background-image: url(/common/bg/start.png);
  background-size: cover;
}
.elapsed {
  flex-shrink: 0;
  margin-top: 4px;
  font-size: 60px;
  font-weight: bold;
  color: #ffffff;
}
.ctl {
  flex-shrink: 0;
  height: 340px;
  width: 212px;
  flex-direction: column;
  align-items: center;
  padding-top: 42px;
}
.play {
  flex-shrink: 0;
  width: 96px;
  height: 96px;
  margin-top: 10px;
  border-radius: 48px;
}
.play-img {
  flex-shrink: 0;
  width: 46px;
  height: 46px;
}
.chcap {
  flex-shrink: 0;
  height: 44px;
  width: 196px;
  margin-left: 8px;
  margin-top: 10px;
  text-align: center;
  font-size: 24px;
  font-weight: bold;
  color: #8e8e93;
}
.cbox {
  flex-shrink: 0;
  width: 196px;
  height: 76px;
  margin-left: 8px;
  margin-top: 10px;
  border-radius: 22px;
  overflow: hidden;
}
.cfill {
  flex-shrink: 0;
  height: 72px;
  margin-left: 2px;
  margin-top: 2px;
  border-radius: 20px;
}
.cface {
  flex-shrink: 0;
  width: 196px;
  height: 76px;
  border-width: 2px;
  border-color: #48484a;
  border-radius: 22px;
  justify-content: center;
  align-items: center;
}
.cname {
  flex-shrink: 0;
  width: 180px;
  text-align: center;
  font-size: 18px;
  font-weight: bold;
  color: #ffffff;
  lines: 1;
  position: absolute;
  top: 4px;
  left: 8px;
}
.cline {
  flex-shrink: 0;
  width: 196px;
  height: 76px;
  flex-direction: row;
  align-items: center;
  justify-content: center;
}
.csign {
  flex-shrink: 0;
  width: 44px;
  text-align: center;
  font-size: 42px;
  font-weight: bold;
  color: #aeaeb2;
}
.cval {
  flex-shrink: 0;
  width: 108px;
  text-align: center;
  font-size: 30px;
  font-weight: bold;
  lines: 1;
}
.all-fill {
  width: 192px;
}
.cface-all {
  flex-direction: row;
  padding-top: 0px;
}
.bigsign {
  flex-shrink: 0;
  width: 96px;
  text-align: center;
  font-size: 52px;
  font-weight: bold;
  color: #ffffff;
}
.kpis {
  flex-shrink: 0;
  flex-direction: row;
  margin-top: 4px;
}
.kpi {
  flex-shrink: 0;
  width: 92px;
  height: 70px;
  margin-left: 4px;
  margin-right: 4px;
  border-radius: 20px;
  background-color: #1c1c1e;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}
.kpi-num {
  flex-shrink: 0;
  font-size: 34px;
  font-weight: bold;
  color: #ffffff;
}
.kpi-lbl {
  flex-shrink: 0;
  font-size: 18px;
  color: #8e8e93;
}
