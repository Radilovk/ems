<template>
  <!-- Start: one scrolling list — status and start / pause, all channels, each channel
       (tap one to open its − / +; hold = 5 steps), end (hold). Swipe right = back. -->
  <stack class="root">
    <image class="bg" src="/common/bg/start.png"></image>
    <list class="lst">
      <list-item type="ctl" class="ctl">
        <text class="caps" style="color: {{runColor}}">{{caps}}</text>
        <text class="elapsed">{{elapsed}}</text>
        <text class="meta" style="color: {{zoneColor}}">{{meta}}</text>
        <div class="btn play {{pressed === 'play' ? 'down' : ''}}" style="background-color: {{run ? '#2C2C2E' : '#30D158'}}"
             ontouchstart="press('play')" ontouchend="release" ontouchcancel="release" onclick="toggle">
          <image class="play-img" src="{{run ? '/common/icons/pause.png' : '/common/icons/play.png'}}"></image>
        </div>
        <text class="sub">{{run ? 'пауза' : 'старт'}}</text>
        <text class="sync" if="{{busy}}">синхронизиране…</text>
      </list-item>

      <list-item type="all" class="row all">
        <text class="row-title">Всички канали</text>
        <div class="pm">
          <div class="btn pm-btn {{pressed === 'aminus' ? 'down' : ''}}" ontouchstart="press('aminus')" ontouchend="release"
               ontouchcancel="release" onclick="allMinus">
            <image class="pm-img" src="/common/icons/minus.png"></image>
          </div>
          <div class="btn pm-btn plus {{pressed === 'aplus' ? 'down' : ''}}" ontouchstart="press('aplus')" ontouchend="release"
               ontouchcancel="release" onclick="allPlus">
            <image class="pm-img" src="/common/icons/plus.png"></image>
          </div>
        </div>
        <text class="row-hint">{{run ? 'главна сила' : 'първо старт'}}</text>
      </list-item>

      <list-item type="chcap" class="chcap">
        <text class="caps">{{chCaps}}</text>
      </list-item>

      <list-item type="ch" for="{{chans}}" class="row {{$item.sel ? 'row-sel' : ''}} {{$item.off ? 'off' : ''}}">
        <div class="ch-head" onclick="pick($item.i)">
          <div class="ch-top">
            <text class="ch-name">{{$item.name}}</text>
            <text class="ch-val" style="color: {{$item.color}}">{{$item.text}}</text>
          </div>
          <div class="bar">
            <div class="bar-fill" style="width: {{$item.w}}px; background-color: {{$item.color}}"></div>
          </div>
        </div>
        <div class="pm" if="{{$item.sel}}">
          <div class="btn pm-btn {{pressed === 'cminus' ? 'down' : ''}}" ontouchstart="press('cminus')" ontouchend="release"
               ontouchcancel="release" onclick="chMinus" onlongpress="chMinus5">
            <image class="pm-img" src="/common/icons/minus.png"></image>
          </div>
          <div class="btn pm-btn plus {{pressed === 'cplus' ? 'down' : ''}}" ontouchstart="press('cplus')" ontouchend="release"
               ontouchcancel="release" onclick="chPlus" onlongpress="chPlus5">
            <image class="pm-img" src="/common/icons/plus.png"></image>
          </div>
        </div>
      </list-item>

      <list-item type="stop" class="stop-item">
        <text class="caps">КРАЙ</text>
        <stack class="stop-box" ontouchstart="holdStart" ontouchend="holdEnd" ontouchcancel="holdEnd">
          <progress class="stop-ring" type="arc" percent="{{holdPct}}" style="color: #FF453A"></progress>
          <div class="stop-core">
            <image class="stop-img" src="/common/icons/stop.png"></image>
          </div>
        </stack>
        <text class="sub">{{holdPct > 0 ? 'дръж…' : 'задръж 1 секунда'}}</text>
      </list-item>
    </list>
  </stack>
</template>

<script>
import { ZONE, GREEN, AMBER, hms, zoneOf, mods, bind } from '../../common/ui.js'

const HOLD_MS = 1200
/** Channel index (PartStrenthBean.buwei) → name; shown in the tablet's order, legs up to arms. */
const NAMES = ['Гърди', 'Корем', 'Предно бедро', 'Прасец', 'Ръце', 'Трапец', 'Гръб', 'Кръст', 'Седалище', 'Задно бедро']
const ORDER = [3, 2, 9, 8, 1, 7, 6, 5, 0, 4]
const BAR_W = 164

export default {
  private: {
    caps: 'ТРЕНИРОВКА',
    runColor: '#8E8E93',
    run: false,
    elapsed: '0:00',
    meta: '',
    zoneColor: '#AEAEB2',
    pressed: '',
    holdPct: 0,
    busy: false,
    chCaps: 'КАНАЛИ',
    chans: [],
    chKey: '',
    sel: -1
  },

  onInit() {
    this.unbind = bind(this)
  },

  onDestroy() {
    this.unbind()
    this.holdEnd()
  },

  update() {
    const app = this.$app.$def
    const s = app.state
    if (!s) {
      return
    }
    const run = !!mods(s).tr.run
    this.run = run
    this.busy = app.busy()
    this.caps = run ? 'ТЕЧЕ' : s.mode === 'manual' ? 'ПАУЗА' : 'ГОТОВ'
    this.runColor = run ? GREEN : s.mode === 'manual' ? AMBER : '#8E8E93'
    this.elapsed = hms((s.el || 0) + (run ? app.silence() : 0))
    const z = s.hr > 0 ? s.z || zoneOf(s.hr, s.lim || 170) : 0
    this.meta = s.hr > 0 ? s.hr + ' уд/мин · Z' + z : 'няма пулс'
    this.zoneColor = s.hr > 0 ? ZONE[z] : '#AEAEB2'
    this.buildChannels(s.ch || [])
  },

  buildChannels(ch) {
    this.chCaps = ch.length ? 'КАНАЛИ' : 'КАНАЛИ · добави клиент'
    const out = []
    ORDER.forEach((i) => {
      if (i >= ch.length) {
        return
      }
      const v = ch[i]
      const off = v < 0
      const pct = off ? 0 : Math.max(0, Math.min(100, v))
      out.push({
        i: i,
        name: NAMES[i],
        text: off ? 'изкл.' : pct + '%',
        w: Math.round((BAR_W * pct) / 100),
        color: off ? '#48484A' : pct >= 80 ? '#FF453A' : pct >= 50 ? '#FF9F0A' : '#30D158',
        off: off,
        sel: !off && i === this.sel
      })
    })
    const key = JSON.stringify(out)
    if (key !== this.chKey) {
      this.chKey = key
      this.chans = out
    }
  },

  pick(i) {
    const s = this.$app.$def.state || {}
    const v = (s.ch || [])[i]
    if (v === undefined || v < 0) {
      return
    }
    this.sel = this.sel === i ? -1 : i
    this.$app.$def.buzz('short')
    this.buildChannels(s.ch || [])
  },

  step(d) {
    if (this.sel >= 0) {
      this.$app.$def.command(d > 0 ? 'ch_plus' : 'ch_minus', { c: this.sel, d: Math.abs(d) })
    }
  },

  chPlus() {
    this.step(1)
  },

  chMinus() {
    this.step(-1)
  },

  chPlus5() {
    this.step(5)
  },

  chMinus5() {
    this.step(-5)
  },

  press(w) {
    this.pressed = w
  },

  release() {
    this.pressed = ''
  },

  toggle() {
    this.$app.$def.command('train_toggle')
  },

  allPlus() {
    if (this.run) {
      this.$app.$def.command('train_plus')
    }
  },

  allMinus() {
    if (this.run) {
      this.$app.$def.command('train_minus')
    }
  },

  holdStart() {
    this.holdEnd()
    const t0 = Date.now()
    this.holdTimer = setInterval(() => {
      const p = Math.min(100, Math.round(((Date.now() - t0) / HOLD_MS) * 100))
      this.holdPct = p
      if (p >= 100) {
        clearInterval(this.holdTimer)
        this.holdTimer = null
        this.$app.$def.command('train_stop', null, 'long')
        setTimeout(() => {
          this.holdPct = 0
        }, 400)
      }
    }, 40)
  },

  holdEnd() {
    if (this.holdTimer) {
      clearInterval(this.holdTimer)
      this.holdTimer = null
      this.holdPct = 0
    }
  }
}
</script>

<style>
/* ---- common (scripts/gen-pages.py stamps this into every page) ---- */
.root {
  width: 212px;
  height: 520px;
  background-color: #000000;
}
.screen {
  width: 212px;
  height: 520px;
  flex-direction: column;
  align-items: center;
  padding-top: 34px;
}
.bg {
  width: 212px;
  height: 520px;
}
.lst {
  width: 212px;
  height: 520px;
}
.in-up {
  animation-name: inUp;
  animation-duration: 260ms;
  animation-timing-function: ease-out;
}
.in-down {
  animation-name: inDown;
  animation-duration: 260ms;
  animation-timing-function: ease-out;
}
.dots {
  width: 16px;
  height: 520px;
  margin-left: 196px;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}
.pdot {
  width: 8px;
  height: 8px;
  margin-top: 4px;
  margin-bottom: 4px;
  border-radius: 4px;
  background-color: #3a3a3c;
}
.pdot-on {
  height: 22px;
  background-color: #ffffff;
}
.caps {
  font-size: 24px;
  font-weight: bold;
  color: #8e8e93;
}
.sub {
  width: 196px;
  text-align: center;
  font-size: 24px;
  color: #aeaeb2;
}
.down {
  transform: scale(0.92);
}
.btn {
  justify-content: center;
  align-items: center;
  transition-property: transform;
  transition-duration: 120ms;
}
.off {
  opacity: 0.3;
}
@keyframes inUp {
  from {
    transform: translateY(90px);
    opacity: 0;
  }
  to {
    transform: translateY(0px);
    opacity: 1;
  }
}
@keyframes inDown {
  from {
    transform: translateY(-90px);
    opacity: 0;
  }
  to {
    transform: translateY(0px);
    opacity: 1;
  }
}
@keyframes breathe {
  from {
    transform: scale(0.86);
    opacity: 0.9;
  }
  to {
    transform: scale(1.12);
    opacity: 0.2;
  }
}
@keyframes beat {
  from {
    transform: scale(1);
  }
  to {
    transform: scale(1.25);
  }
}
/* ---- page ---- */
.ctl {
  width: 212px;
  flex-direction: column;
  align-items: center;
  padding-top: 30px;
  padding-bottom: 10px;
}
.elapsed {
  margin-top: 6px;
  font-size: 64px;
  font-weight: bold;
  color: #ffffff;
}
.meta {
  font-size: 24px;
  font-weight: bold;
}
.play {
  width: 132px;
  height: 132px;
  margin-top: 18px;
  border-radius: 66px;
}
.play-img {
  width: 60px;
  height: 60px;
}
.sync {
  margin-top: 6px;
  font-size: 20px;
  color: #ff9f0a;
}
.row {
  width: 196px;
  margin-left: 8px;
  margin-top: 12px;
  padding: 16px;
  flex-direction: column;
  border-radius: 28px;
  background-color: #16171b;
  border-width: 3px;
  border-color: #26272c;
}
.row-sel {
  background-color: #0e2a17;
  border-color: #30d158;
}
.all {
  align-items: center;
}
.row-title {
  font-size: 26px;
  font-weight: bold;
  color: #ffffff;
}
.row-hint {
  margin-top: 8px;
  font-size: 20px;
  color: #8e8e93;
}
.pm {
  flex-direction: row;
  justify-content: space-between;
  margin-top: 12px;
  width: 160px;
}
.pm-btn {
  width: 74px;
  height: 64px;
  border-radius: 32px;
  background-color: #2c2c2e;
}
.plus {
  background-color: #1f4a2a;
}
.pm-img {
  width: 34px;
  height: 34px;
}
.chcap {
  width: 212px;
  padding-top: 20px;
  justify-content: center;
}
.ch-head {
  flex-direction: column;
  width: 164px;
}
.ch-top {
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  width: 160px;
}
.ch-name {
  font-size: 24px;
  font-weight: bold;
  color: #ffffff;
  lines: 1;
  width: 100px;
  text-overflow: ellipsis;
}
.ch-val {
  font-size: 28px;
  font-weight: bold;
}
.bar {
  margin-top: 10px;
  width: 164px;
  height: 12px;
  border-radius: 6px;
  background-color: #2c2c2e;
}
.bar-fill {
  height: 12px;
  border-radius: 6px;
}
.stop-item {
  width: 212px;
  flex-direction: column;
  align-items: center;
  padding-top: 26px;
  padding-bottom: 70px;
}
.stop-box {
  width: 170px;
  height: 170px;
  margin-top: 12px;
  justify-content: center;
  align-items: center;
}
.stop-ring {
  width: 170px;
  height: 170px;
  stroke-width: 14px;
  background-color: #3a0f0d;
  start-angle: 0deg;
  total-angle: 360deg;
  center-x: 85px;
  center-y: 85px;
  radius: 76px;
}
.stop-core {
  width: 124px;
  height: 124px;
  border-radius: 62px;
  background-color: #c62828;
  justify-content: center;
  align-items: center;
}
.stop-img {
  width: 54px;
  height: 54px;
}
</style>
