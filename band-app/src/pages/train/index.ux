<template>
  <!-- Start: one vertical scroll — start / pause, all channels, every working channel with its
       own − / + (hold = 5 steps), end (hold). Swipe right = back. -->
  <stack class="root bg-start">
    <scroll class="scr" scroll-y="true">
      <div class="col" style="height: {{colH}}px">
        <div class="ctl">
          <text class="caps" style="color: {{runColor}}">{{caps}}</text>
          <text class="elapsed">{{elapsed}}</text>
          <text class="meta" style="color: {{zoneColor}}">{{meta}}</text>
          <div class="btn play {{pressed === 'play' ? 'down' : ''}}" style="background-color: {{run ? '#2C2C2E' : '#30D158'}}"
               ontouchstart="press('play')" ontouchend="release" ontouchcancel="release" onclick="toggle">
            <image class="play-img" src="{{run ? '/common/icons/pause.png' : '/common/icons/play.png'}}"></image>
          </div>
          <text class="sub">{{run ? 'пауза' : 'старт'}}</text>
          <text class="sync" style="opacity: {{busy ? 1 : 0}}">синхронизиране…</text>
        </div>

        <div class="row allrow">
          <text class="row-title">Всички канали</text>
          <div class="pm">
            <div class="btn pm-btn {{run ? '' : 'off'}} {{pressed === 'aminus' ? 'down' : ''}}" ontouchstart="press('aminus')"
                 ontouchend="release" ontouchcancel="release" onclick="allMinus">
              <image class="pm-img" src="/common/icons/minus.png"></image>
            </div>
            <div class="btn pm-btn pm-plus {{run ? '' : 'off'}} {{pressed === 'aplus' ? 'down' : ''}}" ontouchstart="press('aplus')"
                 ontouchend="release" ontouchcancel="release" onclick="allPlus">
              <image class="pm-img" src="/common/icons/plus.png"></image>
            </div>
          </div>
          <text class="row-hint">{{allHint}}</text>
        </div>

        <text class="chcap">{{chCaps}}</text>

        <div for="{{chans}}" class="row chrow">
          <div class="ch-top">
            <text class="ch-name">{{$item.name}}</text>
            <text class="ch-val" style="color: {{$item.color}}">{{$item.text}}</text>
          </div>
          <div class="bar">
            <div class="bar-fill" style="width: {{$item.w}}px; background-color: {{$item.color}}"></div>
          </div>
          <div class="pm">
            <div class="btn pm-btn" onclick="chMinus($item.i)" onlongpress="chMinus5($item.i)">
              <image class="pm-img" src="/common/icons/minus.png"></image>
            </div>
            <div class="btn pm-btn pm-plus" onclick="chPlus($item.i)" onlongpress="chPlus5($item.i)">
              <image class="pm-img" src="/common/icons/plus.png"></image>
            </div>
          </div>
        </div>

        <div class="stop-item">
          <text class="caps">КРАЙ</text>
          <stack class="stop-box" ontouchstart="holdStart" ontouchend="holdEnd" ontouchcancel="holdEnd">
            <progress class="stop-ring" type="arc" percent="{{holdPct}}" style="color: #FF453A"></progress>
            <div class="stop-core">
              <image class="stop-img" src="/common/icons/stop.png"></image>
            </div>
          </stack>
          <text class="sub">{{holdPct > 0 ? 'дръж…' : 'задръж 1 секунда'}}</text>
        </div>
      </div>
    </scroll>
  </stack>
</template>

<script>
import { ZONE, GREEN, AMBER, hms, zoneOf, mods, bind } from '../../common/ui.js'

const HOLD_MS = 1200
/** Channel index (PartStrenthBean.buwei) → name; shown in the tablet's order, legs up to arms. */
const NAMES = ['Гърди', 'Корем', 'Предно бедро', 'Прасец', 'Ръце', 'Трапец', 'Гръб', 'Кръст', 'Седалище', 'Задно бедро']
const ORDER = [3, 2, 9, 8, 1, 7, 6, 5, 0, 4]
const BAR_W = 164

export default {
  private: {
    caps: 'СТАРТ',
    runColor: '#8E8E93',
    run: false,
    elapsed: '0:00',
    meta: '',
    zoneColor: '#AEAEB2',
    pressed: '',
    holdPct: 0,
    busy: false,
    allHint: '',
    chCaps: 'КАНАЛИ',
    chans: [],
    chKey: '',
    colH: 1032
  },

  onInit() {
    this.unbind = bind(this)
  },

  onDestroy() {
    this.unbind()
    this.holdEnd()
  },

  update() {
    const app = this.$app.$def
    const s = app.state
    if (!s) {
      return
    }
    const run = !!mods(s).tr.run
    this.run = run
    this.busy = app.busy()
    this.caps = run ? 'ТЕЧЕ' : s.mode === 'manual' ? 'ПАУЗА' : 'ГОТОВ'
    this.runColor = run ? GREEN : s.mode === 'manual' ? AMBER : '#8E8E93'
    this.elapsed = hms((s.el || 0) + (run ? app.silence() : 0))
    const z = s.hr > 0 ? s.z || zoneOf(s.hr, s.lim || 170) : 0
    this.meta = s.hr > 0 ? s.hr + ' уд/мин · Z' + z : 'няма пулс'
    this.zoneColor = s.hr > 0 ? ZONE[z] : '#AEAEB2'
    this.allHint = run ? 'главна сила' : 'първо старт'
    this.buildChannels(s.ch || [])
  },

  /** Working channels in the tablet's order (off ones have no buttons, so they are left out). */
  buildChannels(ch) {
    const out = []
    ORDER.forEach((i) => {
      if (i >= ch.length || ch[i] < 0) {
        return
      }
      const pct = Math.max(0, Math.min(100, ch[i]))
      out.push({
        i: i,
        name: NAMES[i] || 'Канал ' + (i + 1),
        text: pct + '%',
        w: Math.round((BAR_W * pct) / 100),
        color: pct >= 80 ? '#FF453A' : pct >= 50 ? '#FF9F0A' : '#30D158'
      })
    })
    this.chCaps = out.length ? 'КАНАЛИ · ' + out.length : 'КАНАЛИ · няма включени'
    const key = JSON.stringify(out)
    if (key !== this.chKey) {
      this.chKey = key
      this.chans = out
      // the scroll needs the real content height (children never shrink)
      this.colH = 410 + 208 + 44 + out.length * 228 + 370
    }
  },

  step(c, d) {
    this.$app.$def.command(d > 0 ? 'ch_plus' : 'ch_minus', { c: c, d: Math.abs(d) })
  },

  chPlus(c) {
    this.step(c, 1)
  },

  chMinus(c) {
    this.step(c, -1)
  },

  chPlus5(c) {
    this.step(c, 5)
  },

  chMinus5(c) {
    this.step(c, -5)
  },

  press(w) {
    this.pressed = w
  },

  release() {
    this.pressed = ''
  },

  toggle() {
    this.$app.$def.command('train_toggle')
  },

  allPlus() {
    if (this.run) {
      this.$app.$def.command('train_plus')
    }
  },

  allMinus() {
    if (this.run) {
      this.$app.$def.command('train_minus')
    }
  },

  holdStart() {
    this.holdEnd()
    const t0 = Date.now()
    this.holdTimer = setInterval(() => {
      const p = Math.min(100, Math.round(((Date.now() - t0) / HOLD_MS) * 100))
      this.holdPct = p
      if (p >= 100) {
        clearInterval(this.holdTimer)
        this.holdTimer = null
        this.$app.$def.command('train_stop', null, 'long')
        setTimeout(() => {
          this.holdPct = 0
        }, 400)
      }
    }, 40)
  },

  holdEnd() {
    if (this.holdTimer) {
      clearInterval(this.holdTimer)
      this.holdTimer = null
      this.holdPct = 0
    }
  }
}
</script>

<style>
/* ---- common (scripts/gen-pages.py stamps this into every page) ---- */
.root {
  width: 212px;
  height: 520px;
  background-color: #000000;
}
.screen {
  width: 212px;
  height: 520px;
  flex-direction: column;
  align-items: center;
  padding-top: 34px;
}
.scr {
  width: 212px;
  height: 520px;
}
.col {
  flex-shrink: 0;
  width: 212px;
  flex-direction: column;
}
.in-up {
  animation-name: inUp;
  animation-duration: 260ms;
  animation-timing-function: ease-out;
}
.in-down {
  animation-name: inDown;
  animation-duration: 260ms;
  animation-timing-function: ease-out;
}
.dots {
  width: 16px;
  height: 520px;
  margin-left: 196px;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}
.pdot {
  width: 8px;
  height: 8px;
  margin-top: 4px;
  margin-bottom: 4px;
  border-radius: 4px;
  background-color: #3a3a3c;
}
.pdot-on {
  height: 22px;
  background-color: #ffffff;
}
.caps {
  flex-shrink: 0;
  font-size: 24px;
  font-weight: bold;
  color: #8e8e93;
}
.sub {
  flex-shrink: 0;
  width: 196px;
  text-align: center;
  font-size: 24px;
  color: #aeaeb2;
}
.down {
  transform: scale(0.92);
}
.btn {
  flex-shrink: 0;
  justify-content: center;
  align-items: center;
  transition-property: transform;
  transition-duration: 120ms;
}
.off {
  opacity: 0.3;
}
@keyframes inUp {
  from {
    transform: translateY(90px);
    opacity: 0;
  }
  to {
    transform: translateY(0px);
    opacity: 1;
  }
}
@keyframes inDown {
  from {
    transform: translateY(-90px);
    opacity: 0;
  }
  to {
    transform: translateY(0px);
    opacity: 1;
  }
}
@keyframes breathe {
  from {
    transform: scale(0.86);
    opacity: 0.9;
  }
  to {
    transform: scale(1.12);
    opacity: 0.2;
  }
}
@keyframes beat {
  from {
    transform: scale(1);
  }
  to {
    transform: scale(1.25);
  }
}
/* ---- page ---- */
.bg-start {
  flex-shrink: 0;
  background-image: url(/common/bg/start.png);
  background-size: cover;
}
.elapsed {
  flex-shrink: 0;
  margin-top: 16px;
  font-size: 68px;
  font-weight: bold;
  color: #ffffff;
}
.meta {
  flex-shrink: 0;
  font-size: 26px;
  font-weight: bold;
}
.sync {
  flex-shrink: 0;
  margin-top: 10px;
  font-size: 22px;
  color: #ff9f0a;
}
.ctl {
  flex-shrink: 0;
  height: 410px;
  width: 212px;
  flex-direction: column;
  align-items: center;
  padding-top: 30px;
}
.play {
  flex-shrink: 0;
  width: 130px;
  height: 130px;
  margin-top: 14px;
  border-radius: 65px;
}
.play-img {
  flex-shrink: 0;
  width: 60px;
  height: 60px;
}
.row {
  flex-shrink: 0;
  width: 196px;
  margin-left: 8px;
  margin-top: 12px;
  padding: 14px;
  flex-direction: column;
  align-items: center;
  border-radius: 28px;
  background-color: #16171b;
}
.allrow {
  flex-shrink: 0;
  height: 196px;
}
.chrow {
  flex-shrink: 0;
  height: 216px;
}
.row-title {
  flex-shrink: 0;
  font-size: 28px;
  font-weight: bold;
  color: #ffffff;
}
.row-hint {
  flex-shrink: 0;
  margin-top: 6px;
  font-size: 20px;
  color: #8e8e93;
}
.chcap {
  flex-shrink: 0;
  height: 44px;
  width: 196px;
  margin-left: 8px;
  margin-top: 20px;
  text-align: center;
  font-size: 24px;
  font-weight: bold;
  color: #8e8e93;
}
.ch-top {
  flex-shrink: 0;
  width: 168px;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}
.ch-name {
  flex-shrink: 0;
  width: 110px;
  font-size: 26px;
  font-weight: bold;
  color: #ffffff;
  lines: 2;
}
.ch-val {
  flex-shrink: 0;
  font-size: 30px;
  font-weight: bold;
}
.bar {
  flex-shrink: 0;
  width: 164px;
  height: 12px;
  margin-top: 8px;
  border-radius: 6px;
  background-color: #2c2c2e;
}
.bar-fill {
  flex-shrink: 0;
  height: 12px;
  border-radius: 6px;
}
.pm {
  flex-shrink: 0;
  flex-direction: row;
  margin-top: 12px;
}
.pm-btn {
  flex-shrink: 0;
  width: 80px;
  height: 76px;
  margin-left: 4px;
  margin-right: 4px;
  border-radius: 38px;
  background-color: #2c2c2e;
}
.pm-plus {
  flex-shrink: 0;
  background-color: #1f4a2a;
}
.pm-img {
  flex-shrink: 0;
  width: 40px;
  height: 40px;
}
.stop-item {
  flex-shrink: 0;
  height: 370px;
  width: 212px;
  flex-direction: column;
  align-items: center;
  padding-top: 24px;
  padding-bottom: 70px;
}
.stop-box {
  flex-shrink: 0;
  width: 190px;
  height: 190px;
