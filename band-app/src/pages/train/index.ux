<template>
  <!-- Start: flick up / down through the screens — start / pause, all channels, then one screen
       per working channel (big − / +; hold = 5 steps), end (hold). Swipe right = back. -->
  <stack class="root bg-start" onswipe="onSwipe">
    <!-- start / pause -->
    <div class="screen {{anim}}" if="{{cur === 'main'}}">
      <text class="caps" style="color: {{runColor}}">{{caps}}</text>
      <text class="elapsed">{{elapsed}}</text>
      <text class="meta" style="color: {{zoneColor}}">{{meta}}</text>
      <stack class="play-box">
        <div class="glow {{run ? '' : 'breathe'}}"></div>
        <div class="btn play {{pressed === 'play' ? 'down' : ''}}" style="background-color: {{run ? '#2C2C2E' : '#30D158'}}"
             ontouchstart="press('play')" ontouchend="release" ontouchcancel="release" onclick="toggle">
          <image class="play-img" src="{{run ? '/common/icons/pause.png' : '/common/icons/play.png'}}"></image>
        </div>
      </stack>
      <text class="sub">{{run ? 'пауза' : 'старт'}}</text>
      <text class="sync" if="{{busy}}">синхронизиране…</text>
    </div>

    <!-- all channels -->
    <div class="screen {{anim}}" if="{{cur === 'all'}}">
      <text class="caps">ВСИЧКИ КАНАЛИ</text>
      <div class="btn big-pill plus {{run ? '' : 'off'}} {{pressed === 'aplus' ? 'down' : ''}}"
           ontouchstart="press('aplus')" ontouchend="release" ontouchcancel="release" onclick="allPlus">
        <image class="pill-img" src="/common/icons/plus.png"></image>
      </div>
      <div class="btn big-pill {{run ? '' : 'off'}} {{pressed === 'aminus' ? 'down' : ''}}"
           ontouchstart="press('aminus')" ontouchend="release" ontouchcancel="release" onclick="allMinus">
        <image class="pill-img" src="/common/icons/minus.png"></image>
      </div>
      <text class="sub">{{allHint}}</text>
    </div>

    <!-- one channel -->
    <div class="screen {{anim}}" if="{{chan.on}}">
      <text class="caps">КАНАЛ {{chan.n}}/{{chan.of}}</text>
      <text class="ch-name">{{chan.name}}</text>
      <text class="ch-val" style="color: {{chan.color}}">{{chan.text}}</text>
      <div class="bar">
        <div class="bar-fill" style="width: {{chan.w}}px; background-color: {{chan.color}}"></div>
      </div>
      <div class="pm">
        <div class="btn pm-btn {{pressed === 'cminus' ? 'down' : ''}}" ontouchstart="press('cminus')" ontouchend="release"
             ontouchcancel="release" onclick="chMinus" onlongpress="chMinus5">
          <image class="pm-img" src="/common/icons/minus.png"></image>
        </div>
        <div class="btn pm-btn pm-plus {{pressed === 'cplus' ? 'down' : ''}}" ontouchstart="press('cplus')" ontouchend="release"
             ontouchcancel="release" onclick="chPlus" onlongpress="chPlus5">
          <image class="pm-img" src="/common/icons/plus.png"></image>
        </div>
      </div>
      <text class="sub">задръж = 5 стъпки</text>
    </div>

    <!-- stop (hold) -->
    <div class="screen {{anim}}" if="{{cur === 'stop'}}">
      <text class="caps">КРАЙ</text>
      <stack class="stop-box" ontouchstart="holdStart" ontouchend="holdEnd" ontouchcancel="holdEnd">
        <progress class="stop-ring" type="arc" percent="{{holdPct}}" style="color: #FF453A"></progress>
        <div class="stop-core">
          <image class="stop-img" src="/common/icons/stop.png"></image>
        </div>
      </stack>
      <text class="sub">{{holdPct > 0 ? 'дръж…' : 'задръж 1 секунда'}}</text>
    </div>

    <div class="dots">
      <div for="{{dots}}" class="pdot {{$item.on ? 'pdot-on' : ''}}"></div>
    </div>
  </stack>
</template>

<script>
import { ZONE, GREEN, AMBER, hms, zoneOf, mods, bind, setPages, swipe } from '../../common/ui.js'

const HOLD_MS = 1200
/** Channel index (PartStrenthBean.buwei) → name; shown in the tablet's order, legs up to arms. */
const NAMES = ['Гърди', 'Корем', 'Предно бедро', 'Прасец', 'Ръце', 'Трапец', 'Гръб', 'Кръст', 'Седалище', 'Задно бедро']
const ORDER = [3, 2, 9, 8, 1, 7, 6, 5, 0, 4]
const BAR_W = 180
const NO_CHAN = { on: false, i: -1, n: 0, of: 0, name: '', text: '', w: 0, color: '#48484A' }

export default {
  private: {
    ids: [],
    idsKey: '',
    idx: 0,
    cur: 'main',
    dots: [],
    anim: '',
    caps: 'СТАРТ',
    runColor: '#8E8E93',
    run: false,
    elapsed: '0:00',
    meta: '',
    zoneColor: '#AEAEB2',
    pressed: '',
    holdPct: 0,
    busy: false,
    allHint: '',
    chan: NO_CHAN
  },

  onInit() {
    setPages(this, ['main', 'all', 'stop'])
    this.unbind = bind(this)
  },

  onDestroy() {
    this.unbind()
    this.holdEnd()
  },

  onSwipe(e) {
    swipe(this, e)
    this.showChan()
  },

  update() {
    const app = this.$app.$def
    const s = app.state
    if (!s) {
      return
    }
    const run = !!mods(s).tr.run
    this.run = run
    this.busy = app.busy()
    this.caps = run ? 'ТЕЧЕ' : s.mode === 'manual' ? 'ПАУЗА' : 'ГОТОВ'
    this.runColor = run ? GREEN : s.mode === 'manual' ? AMBER : '#8E8E93'
    this.elapsed = hms((s.el || 0) + (run ? app.silence() : 0))
    const z = s.hr > 0 ? s.z || zoneOf(s.hr, s.lim || 170) : 0
    this.meta = s.hr > 0 ? s.hr + ' уд/мин · Z' + z : 'няма пулс'
    this.zoneColor = s.hr > 0 ? ZONE[z] : '#AEAEB2'
    const ch = s.ch || []
    const on = ORDER.filter((i) => i < ch.length && ch[i] >= 0)
    this.allHint = !run ? 'първо старт' : on.length ? 'надолу · канал по канал' : 'главна сила'
    setPages(this, ['main', 'all'].concat(on.map((i) => 'c' + i), ['stop']))
    this.showChan()
  },

  /** Fills the channel screen when the current screen is one ("c<index>"). */
  showChan() {
    const cur = this.cur || ''
    if (cur.charAt(0) !== 'c') {
      if (this.chan.on) {
        this.chan = NO_CHAN
      }
      return
    }
    const i = parseInt(cur.substring(1), 10)
    const s = this.$app.$def.state || {}
    const v = (s.ch || [])[i]
    const pct = Math.max(0, Math.min(100, v || 0))
    const chans = this.ids.filter((id) => id.charAt(0) === 'c')
    this.chan = {
      on: true,
      i: i,
      n: chans.indexOf(cur) + 1,
      of: chans.length,
      name: NAMES[i] || 'Канал ' + (i + 1),
      text: pct + '%',
      w: Math.round((BAR_W * pct) / 100),
      color: pct >= 80 ? '#FF453A' : pct >= 50 ? '#FF9F0A' : '#30D158'
    }
  },

  step(d) {
    if (this.chan.on) {
      this.$app.$def.command(d > 0 ? 'ch_plus' : 'ch_minus', { c: this.chan.i, d: Math.abs(d) })
    }
  },

  chPlus() {
    this.step(1)
  },

  chMinus() {
    this.step(-1)
  },

  chPlus5() {
    this.step(5)
  },

  chMinus5() {
    this.step(-5)
  },

  press(w) {
    this.pressed = w
  },

  release() {
    this.pressed = ''
  },

  toggle() {
    this.$app.$def.command('train_toggle')
  },

  allPlus() {
    if (this.run) {
      this.$app.$def.command('train_plus')
    }
  },

  allMinus() {
    if (this.run) {
      this.$app.$def.command('train_minus')
    }
  },

  holdStart() {
    this.holdEnd()
    const t0 = Date.now()
    this.holdTimer = setInterval(() => {
      const p = Math.min(100, Math.round(((Date.now() - t0) / HOLD_MS) * 100))
      this.holdPct = p
      if (p >= 100) {
        clearInterval(this.holdTimer)
        this.holdTimer = null
        this.$app.$def.command('train_stop', null, 'long')
        setTimeout(() => {
          this.holdPct = 0
        }, 400)
      }
    }, 40)
  },

  holdEnd() {
    if (this.holdTimer) {
      clearInterval(this.holdTimer)
      this.holdTimer = null
      this.holdPct = 0
    }
  }
}
</script>

<style>
/* ---- common (scripts/gen-pages.py stamps this into every page) ---- */
.root {
  width: 212px;
  height: 520px;
  background-color: #000000;
}
.screen {
  width: 212px;
  height: 520px;
  flex-direction: column;
  align-items: center;
  padding-top: 34px;
}
.in-up {
  animation-name: inUp;
  animation-duration: 260ms;
  animation-timing-function: ease-out;
}
.in-down {
  animation-name: inDown;
  animation-duration: 260ms;
  animation-timing-function: ease-out;
}
.dots {
  width: 16px;
  height: 520px;
  margin-left: 196px;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}
.pdot {
  width: 8px;
  height: 8px;
  margin-top: 4px;
  margin-bottom: 4px;
  border-radius: 4px;
  background-color: #3a3a3c;
}
.pdot-on {
  height: 22px;
  background-color: #ffffff;
}
.caps {
  font-size: 24px;
  font-weight: bold;
  color: #8e8e93;
}
.sub {
  width: 196px;
  text-align: center;
  font-size: 24px;
  color: #aeaeb2;
}
.down {
  transform: scale(0.92);
}
.btn {
  justify-content: center;
  align-items: center;
  transition-property: transform;
  transition-duration: 120ms;
}
.off {
  opacity: 0.3;
}
@keyframes inUp {
  from {
    transform: translateY(90px);
    opacity: 0;
  }
  to {
    transform: translateY(0px);
    opacity: 1;
  }
}
@keyframes inDown {
  from {
    transform: translateY(-90px);
    opacity: 0;
  }
  to {
    transform: translateY(0px);
    opacity: 1;
  }
}
@keyframes breathe {
  from {
    transform: scale(0.86);
    opacity: 0.9;
  }
  to {
    transform: scale(1.12);
    opacity: 0.2;
  }
}
@keyframes beat {
  from {
    transform: scale(1);
  }
  to {
    transform: scale(1.25);
  }
}
/* ---- page ---- */
.bg-start {
  background-image: url(/common/bg/start.png);
  background-size: cover;
}
.elapsed {
  margin-top: 16px;
  font-size: 68px;
  font-weight: bold;
  color: #ffffff;
}
.meta {
  font-size: 26px;
  font-weight: bold;
}
.sync {
  margin-top: 10px;
  font-size: 22px;
  color: #ff9f0a;
}
.play-box {
  width: 170px;
  height: 170px;
  margin-top: 30px;
  justify-content: center;
  align-items: center;
}
.glow {
  width: 164px;
  height: 164px;
  border-radius: 82px;
  background-color: rgba(48, 209, 88, 0.25);
}
.breathe {
  animation-name: breathe;
  animation-duration: 1500ms;
  animation-iteration-count: infinite;
  animation-direction: alternate;
}
.play {
  width: 140px;
  height: 140px;
  border-radius: 70px;
}
.play-img {
  width: 64px;
  height: 64px;
}
.big-pill {
  width: 180px;
  height: 130px;
  margin-top: 16px;
  border-radius: 65px;
  background-color: #2c2c2e;
}
.plus {
  background-color: #1f4a2a;
  margin-top: 30px;
}
.pill-img {
  width: 56px;
  height: 56px;
}
.ch-name {
  margin-top: 18px;
  width: 196px;
  text-align: center;
  font-size: 36px;
  font-weight: bold;
  color: #ffffff;
  lines: 2;
}
.ch-val {
  margin-top: 4px;
  font-size: 72px;
  font-weight: bold;
}
.bar {
  width: 180px;
  height: 14px;
  margin-top: 8px;
  border-radius: 7px;
  background-color: #2c2c2e;
}
.bar-fill {
  height: 14px;
  border-radius: 7px;
}
.pm {
  flex-direction: row;
  margin-top: 30px;
}
.pm-btn {
  width: 92px;
  height: 120px;
  margin-left: 4px;
  margin-right: 4px;
  border-radius: 46px;
  background-color: #2c2c2e;
}
.pm-plus {
  background-color: #1f4a2a;
}
.pm-img {
  width: 50px;
  height: 50px;
}
.stop-box {
  width: 190px;
  height: 190px;
  margin-top: 50px;
  justify-content: center;
  align-items: center;
}
.stop-ring {
  width: 190px;
  height: 190px;
  stroke-width: 14px;
  background-color: #3a0f0d;
  start-angle: 0deg;
  total-angle: 360deg;
  center-x: 95px;
  center-y: 95px;
  radius: 86px;
}
.stop-core {
  width: 140px;
  height: 140px;
  border-radius: 70px;
  background-color: #c62828;
  justify-content: center;
  align-items: center;
}
.stop-img {
  width: 60px;
  height: 60px;
}
</style>
