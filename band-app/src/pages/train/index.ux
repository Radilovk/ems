}
.stop-ring {
  flex-shrink: 0;
  width: 190px;
  height: 190px;
  stroke-width: 14px;
  background-color: #3a0f0d;
  start-angle: 0deg;
  total-angle: 360deg;
  center-x: 95px;
  center-y: 95px;
  radius: 86px;
}
.stop-core {
  flex-shrink: 0;
