<template>
  <!-- Start: scroll list + hold-to-slide overlay for per-channel strength. -->
  <stack class="root bg-start" onswipe="onSwipe">
    <scroll id="trainScr" class="scr" scroll-y="true" onscroll="onScroll">
      <div class="col" style="height: {{colH}}px">
        <div class="train-head">
          <div class="ctl">
            <text class="elapsed">{{elapsed}}</text>
            <div class="kpis">
              <div class="kpi">
                <text class="kpi-num">{{msText}}</text>
                <text class="kpi-lbl">сила</text>
              </div>
              <div class="kpi">
                <text class="kpi-num" style="color: {{zoneColor}}">{{hrText}}</text>
                <text class="kpi-lbl">{{zoneText}}</text>
              </div>
            </div>
            <div class="ctl-rule"></div>
          </div>

          <stack class="tr-play-row">
            <div class="tr-play-glow {{run ? 'tr-play-glow-run' : 'tr-play-glow-idle'}}"></div>
            <div class="tr-play {{run ? 'tr-play-run' : 'tr-play-idle'}} {{pressed === 'play' ? 'tr-play-press' : ''}}"
                 ontouchstart="press('play')" ontouchend="release" ontouchcancel="release" onclick="toggle">
              <image class="tr-play-img" src="{{run ? '/common/icons/pause.png' : '/common/icons/play.png'}}"></image>
            </div>
          </stack>

          <stack class="cbox cbox-main">
            <image class="cfill-main" src="{{allBtnSrc}}"></image>
            <div class="cface cface-all">
              <text class="bigsign">-</text>
              <text class="bigsign">+</text>
            </div>
            <div class="ctouch"
                 ontouchstart="mainTouchStart"
                 ontouchmove="rowTouchMove"
                 ontouchend="rowTouchEnd"
                 ontouchcancel="rowTouchEnd"></div>
          </stack>
        </div>

        <stack for="{{chans}}" class="cbox">
          <div class="cfill" style="width: {{$item.w}}px; background-color: {{run ? $item.fillLive : $item.fillDim}}"></div>
          <div class="cface {{run ? 'cface-live' : ''}}">
            <div class="cline">
              <text class="csign" style="color: {{run ? '#FFFFFF' : $item.signColorDim}}">-</text>
              <div class="cmid">
                <text class="cname">{{$item.name}}</text>
                <text class="cval" style="color: {{run ? '#D1D1D6' : $item.valColorDim}}">{{$item.text}}</text>
              </div>
              <text class="csign" style="color: {{run ? '#FFFFFF' : $item.signColorDim}}">+</text>
            </div>
          </div>
          <div class="ctouch"
               ontouchstart="chTouchStart($item.i, $item.text, $item.name)"
               ontouchmove="rowTouchMove"
               ontouchend="rowTouchEnd"
               ontouchcancel="rowTouchEnd"></div>
        </stack>

        <div class="stop-item">
          <stack class="stop-box" ontouchstart="holdStart" ontouchend="holdEnd" ontouchcancel="holdEnd">
            <progress class="stop-ring" type="arc" percent="{{holdPct}}" style="color: #FF453A"></progress>
            <div class="stop-core">
              <image class="stop-img" src="/common/icons/stop.png"></image>
            </div>
          </stack>
        </div>
      </div>
    </scroll>

    <!-- Hold any channel → vertical slider; scroll position kept underneath. -->
    <div class="slide-screen {{slideAnim}} {{slideDim ? 'slide-dim' : ''}}" if="{{slideOn}}"
         ontouchstart="slideTouch" ontouchmove="slideTouch" ontouchend="slideEnd" ontouchcancel="slideEnd">
      <text class="slide-val" style="color: {{slideColor}}">{{slideVal}}</text>
      <text class="slide-name">{{slideName}}</text>
      <stack class="slide-track">
        <div class="slide-rail"></div>
        <div class="slide-fill" style="height: {{slideFillH}}px; background-color: {{slideFill}}"></div>
        <div class="slide-knob" style="bottom: {{slideKnobB}}px"></div>
      </stack>
    </div>
  </stack>
</template>

<script>
import { GREEN, AMBER, RED, hms, zoneOf, zoneColor, mods, bind, shown, swipe, liveSeconds } from '../../common/ui.js'
import { resetTrainSession } from '../../common/train-touch.js'

const HOLD_MS = 1200
const SLIDE_OPEN_MS = 400
const SLIDE_COMMIT_MS = 500
const SLIDE_CLOSE_MS = 3000
const TAP_MAX_MS = 320
const TAP_MAX_MOVE = 16
const SLIDE_TRACK_H = 418
const SLIDE_TRACK_TOP = 72
const NAMES = ['Гърди', 'Корем', 'Предно бедро', 'Прасец', 'Ръце', 'Трапец', 'Гръб', 'Кръст', 'Глутеус', 'Задно бедро']
const ORDER = [3, 2, 9, 8, 1, 7, 6, 5, 0, 4]
const FILL_W = 192
const FILL_DIM = ['#17462A', '#5A3A0C', '#5C1A16']
const COL_CTL = 212
const PLAY_GAP = 16
const PLAY_SIZE = 152
const COL_PLAY = PLAY_GAP + PLAY_SIZE
const COL_MAIN_GAP = PLAY_GAP + 92 + 22
const COL_ROW = 102
const COL_STOP = 230

function isMainRow(v) {
  return v === 1 || v === '1' || v === true || v === 'true'
}

function channelRenderKey(out) {
  let key = ''
  for (let k = 0; k < out.length; k++) {
    const n = out[k]
    key += '|' + n.i + ':' + n.text + ':' + n.w
  }
  return key
}

function tier(pct) {
  return pct >= 80 ? 2 : pct >= 50 ? 1 : 0
}

function channelPalette(pct) {
  const t = tier(pct)
  const accent = t === 2 ? RED : t === 1 ? AMBER : GREEN
  return {
    fillDim: FILL_DIM[t],
    fillLive: accent,
    valColorDim: accent,
    signColorDim: '#AEAEB2'
  }
}

function touchY(e) {
  const t = (e.touches && e.touches[0]) || (e.changedTouches && e.changedTouches[0])
  return t ? t.pageY : 0
}

function touchX(e) {
  const t = (e.touches && e.touches[0]) || (e.changedTouches && e.changedTouches[0])
  return t ? t.pageX : 0
}

/** Batched strength change — channels use d≤10; main sends one command per step. */
function sendStrengthDelta(app, main, channel, delta) {
  if (!delta) {
    return
  }
  let rem = delta
  while (rem !== 0) {
    const step = rem > 0 ? Math.min(rem, 10) : Math.max(rem, -10)
    if (main) {
      const cmd = step > 0 ? 'train_plus' : 'train_minus'
      for (let n = 0; n < Math.abs(step); n++) {
        app.command(cmd, null, 'none')
      }
    } else {
      app.command(step > 0 ? 'ch_plus' : 'ch_minus', { c: channel, d: Math.abs(step) }, 'none')
    }
    rem -= step
  }
}

export default {
  private: {
    run: false,
    elapsed: '0:00',
    zoneColor: '#AEAEB2',
    pressed: '',
    holdPct: 0,
    msText: '--',
    hrText: '--',
    zoneText: 'пулс',
    chans: [],
    chPre: '',
    chKey: '',
    colH: 900,
    allBtnSrc: '/common/ui/all-btn-dim.png',
    slideOn: false,
    slideIdx: -1,
    slideName: '',
    slideVal: '0',
    slideColor: '#FFFFFF',
    slideFill: GREEN,
    slideFillH: 0,
    slideKnobB: 0,
    slideAnim: 'slide-in',
    slideDim: false,
    slideMain: false
  },

  onInit() {
    this.optim = {}
    this.optMs = null
    this.elClock = { base: 0, at: 0 }
    this.savedScroll = 0
    this._bound = false
  },

  onShow() {
    if (!this._bound) {
      this.unbind = bind(this)
      this._bound = true
    }
    resetTrainSession(this)
    shown(this, true)
  },

  onHide() {
    shown(this, false)
    resetTrainSession(this)
    if (this._bound && this.unbind) {
      this.unbind()
      this._bound = false
    }
  },

  onDestroy() {
    if (this._bound && this.unbind) {
      this.unbind()
      this._bound = false
    }
    resetTrainSession(this)
  },

  onScroll(e) {
    if (!this.slideOn) {
      this.savedScroll = e.scrollY != null ? e.scrollY : (e.detail && e.detail.scrollY) || 0
    }
  },

  onSwipe(e) {
    if (this.slideOn) {
      return
    }
    swipe(this, e)
  },

  captureScroll() {
    try {
      const el = this.$element('trainScr')
      if (el && el.scrollTop != null) {
        this.savedScroll = el.scrollTop
      }
    } catch (err) {
      /* optional on older Vela builds */
    }
  },

  restoreScroll() {
    const y = this.savedScroll || 0
    try {
      const el = this.$element('trainScr')
      if (el && el.scrollTo) {
        el.scrollTo({ top: y })
      }
    } catch (err) {
      /* scrollTo optional on older Vela builds */
    }
  },

  update() {
    const app = this.$app.$def
    const s = app.state
    if (!s) {
      return
    }
    const run = !!mods(s).tr.run
    this.run = run
    this.elapsed = hms(liveSeconds(this.elClock, s.el, run))
    const z = s.hr > 0 ? s.z || zoneOf(s.hr, s.lim || 170) : 0
    this.hrText = s.hr > 0 ? String(s.hr) : '--'
    this.zoneText = s.hr > 0 ? 'пулс · Z' + z : 'пулс'
    let ms = s.ms != null ? s.ms : -1
    const o = this.optMs
    if (o) {
      if (o.v === ms || Date.now() - o.at > 1500) {
        this.optMs = null
      } else {
        ms = o.v
      }
    }
    this.msText = ms >= 0 ? String(ms) : '--'
    this.zoneColor = s.hr > 0 ? zoneColor(z) : '#AEAEB2'
    this.allBtnSrc = run ? '/common/ui/all-btn.png' : '/common/ui/all-btn-dim.png'
    this.slideDim = this.slideOn && !run
    if (this.slideOn) {
      return
    }
    this.buildChannels(s.ch || [])
  },

  buildChannels(ch) {
    const pre = ch.join(',')
    if (!Object.keys(this.optim).length && pre === this.chPre) {
      return
    }
    this.chPre = pre
    const out = []
    ORDER.forEach((i) => {
      if (i >= ch.length) {
        return
      }
      const raw = parseInt(ch[i], 10)
      if (isNaN(raw) || raw < 0) {
        return
      }
      let pct = Math.max(0, Math.min(100, raw))
      const o = this.optim[i]
      if (o) {
        if (o.v === pct || Date.now() - o.at > 1500) {
          delete this.optim[i]
        } else {
          pct = o.v
        }
      }
      const palette = channelPalette(pct)
      out.push({
        i: i,
        name: NAMES[i] || 'Канал ' + (i + 1),
        text: String(pct),
        w: Math.round((FILL_W * pct) / 100),
        fillDim: palette.fillDim,
        fillLive: palette.fillLive,
        valColorDim: palette.valColorDim,
        signColorDim: palette.signColorDim
      })
    })
    const key = channelRenderKey(out)
    if (key === this.chKey) {
      return
    }
    this.chKey = key
    const same = this.chans.length === out.length && this.chans.every((c, k) => c.i === out[k].i)
    if (same) {
      out.forEach((n, k) => {
        const c = this.chans[k]
        if (c.text !== n.text || c.w !== n.w || c.fillDim !== n.fillDim || c.fillLive !== n.fillLive
            || c.valColorDim !== n.valColorDim || c.signColorDim !== n.signColorDim) {
          c.text = n.text
          c.w = n.w
          c.fillDim = n.fillDim
          c.fillLive = n.fillLive
          c.valColorDim = n.valColorDim
          c.signColorDim = n.signColorDim
        }
      })
    } else {
      this.chans = out
      this.colH = COL_CTL + COL_PLAY + COL_MAIN_GAP + out.length * COL_ROW + COL_STOP
    }
  },

  yToVal(y) {
    const rel = y - SLIDE_TRACK_TOP
    const t = 1 - rel / SLIDE_TRACK_H
    return Math.max(0, Math.min(100, Math.round(t * 100)))
  },

  updateSlideVisual(v) {
    const style = channelPalette(v)
    const live = this.run
    this.slideVal = String(v)
    this.slideColor = live ? '#FFFFFF' : style.valColorDim
    this.slideFill = live ? style.fillLive : style.fillDim
    this.slideFillH = Math.round((SLIDE_TRACK_H * v) / 100)
    this.slideKnobB = this.slideFillH - 18
    if (this.slideKnobB < 0) {
      this.slideKnobB = 0
    }
  },

  openSlide(i, val, name, isMain) {
    if (this.rowTouch) {
      this.rowTouch.opened = true
    }
    this.slideMain = !!isMain
    this.slideIdx = isMain ? -1 : i
    this.slideName = name
    this.slideDraft = val
    this.slideSent = val
    this.slideTouching = false
    this.slideArmed = false
    this.slideOn = true
    this.slideAnim = 'slide-in'
    this.slideDim = isMain && !this.run
    this.slideTick = Math.floor(val / 10)
    this.updateSlideVisual(val)
    this.scheduleSlideIdleClose()
  },

  scheduleSlideIdleClose() {
    clearTimeout(this.slideCloseTimer)
    this.slideCloseTimer = setTimeout(() => {
      if (this.slideOn) {
        this.dismissSlide()
      }
    }, SLIDE_CLOSE_MS)
  },

  dismissSlide() {
    const wasMain = this.slideMain
    clearTimeout(this.slideCloseTimer)
    clearTimeout(this.slideCommitTimer)
    clearTimeout(this.rowOpenTimer)
    this.slideOn = false
    this.slideIdx = -1
    this.slideMain = false
    this.slideTouching = false
    this.slideArmed = false
    this.rowTouch = null
    if (!wasMain) {
      const ch = (this.$app.$def.state && this.$app.$def.state.ch) || []
      this.buildChannels(ch)
    }
    this.restoreScroll()
  },

  setSlideFromY(y) {
    const v = this.yToVal(y)
    if (v === this.slideDraft) {
      return
    }
    const tick = Math.floor(v / 10)
    if (tick !== this.slideTick) {
      this.slideTick = tick
      this.$app.$def.buzz('short')
    }
    this.slideDraft = v
    this.updateSlideVisual(v)
    if (this.slideMain) {
      this.optMs = { v: v, at: Date.now() }
      this.msText = String(v)
    } else {
      this.optim[this.slideIdx] = { v: v, at: Date.now() }
    }
    if (!this.slideDim) {
      this.armSlideCommit()
    }
  },

  armSlideCommit() {
    clearTimeout(this.slideCommitTimer)
    this.slideCommitTimer = setTimeout(() => {
      if (this.slideTouching && this.slideDraft !== this.slideSent && !this.slideDim) {
        this.commitSlideDelta(this.slideDraft - this.slideSent)
        this.slideSent = this.slideDraft
      }
    }, SLIDE_COMMIT_MS)
  },

  commitSlideDelta(delta) {
    sendStrengthDelta(this.$app.$def, this.slideMain, this.slideIdx, delta)
  },

  commitSlide() {
    if (this.slideDraft === this.slideSent || this.slideDim) {
      return
    }
    if (!this.slideMain && this.slideIdx < 0) {
      return
    }
    this.commitSlideDelta(this.slideDraft - this.slideSent)
    this.slideSent = this.slideDraft
  },

  mainMsVal() {
    const app = this.$app.$def
    const ms = app.state && app.state.ms != null ? app.state.ms : -1
    if (this.optMs) {
      return this.optMs.v
    }
    return ms >= 0 ? ms : 0
  },

  mainTouchStart(e) {
    this.rowTouchStart(true, -1, '', 'СИЛА', e)
  },

  chTouchStart(i, text, name, e) {
    this.rowTouchStart(false, i, text, name, e)
  },

  rowTouchStart(isMain, i, text, name, e) {
    if (this.slideOn) {
      return
    }
    const main = isMainRow(isMain)
    this.captureScroll()
    const y = touchY(e)
    const x = touchX(e)
    const val = main ? this.mainMsVal() : (parseInt(text, 10) || 0)
    const label = main ? 'СИЛА' : name
    const ch = main ? -1 : (parseInt(i, 10) || 0)
    this.rowTouch = {
      main: main,
      i: ch,
      name: label,
      val: val,
      startX: x,
      startY: y,
      y: y,
      t0: Date.now(),
      moved: false,
      opened: false
    }
    clearTimeout(this.rowOpenTimer)
    this.rowOpenTimer = setTimeout(() => {
      const t = this.rowTouch
      if (t && !t.opened && t.i === ch) {
        this.openSlide(ch, t.val, label, main)
      }
    }, SLIDE_OPEN_MS)
  },

  rowTouchMove(e) {
    const touch = this.rowTouch
    if (!touch) {
      return
    }
    const y = touchY(e)
    const x = touchX(e)
    touch.y = y
    if (Math.abs(x - touch.startX) > TAP_MAX_MOVE || Math.abs(y - touch.startY) > TAP_MAX_MOVE) {
      touch.moved = true
    }
    if (this.slideOn && this.slideArmed) {
      this.setSlideFromY(y)
    }
  },

  rowTouchEnd(e) {
    clearTimeout(this.rowOpenTimer)
    const touch = this.rowTouch
    if (touch && touch.opened) {
      this.rowTouch = null
      this.slideArmed = true
      return
    }
    this.rowTouch = null
    if (!touch) {
      return
    }
    const elapsed = Date.now() - touch.t0
    if (elapsed >= SLIDE_OPEN_MS || touch.opened) {
      return
    }
    if (!touch.moved && elapsed <= TAP_MAX_MS) {
      const x = touchX(e) || touch.x
      const minus = x < 106
      if (touch.main) {
        minus ? this.allMinus() : this.allPlus()
      } else {
        minus ? this.chMinus(touch.i) : this.chPlus(touch.i)
      }
    }
  },

  slideTouch(e) {
    if (!this.slideOn) {
      return
    }
    this.slideArmed = true
    this.slideTouching = true
    clearTimeout(this.slideCloseTimer)
    this.setSlideFromY(touchY(e))
  },

  slideEnd() {
    this.slideTouching = false
    this.slideArmed = true
    clearTimeout(this.slideCommitTimer)
    if (this.slideDraft !== this.slideSent) {
      this.commitSlide()
    }
    this.scheduleSlideIdleClose()
  },

  closeSlideNow() {
    if (this.slideOn) {
      this.dismissSlide()
    }
  },

  step(c, d) {
    const app = this.$app.$def
    const ch = (app.state && app.state.ch) || []
    const ci = parseInt(c, 10) || 0
    if (ci < ch.length && ch[ci] >= 0) {
      const base = this.optim[ci] ? this.optim[ci].v : ch[ci]
      this.optim[ci] = { v: Math.max(0, Math.min(100, base + d)), at: Date.now() }
      this.buildChannels(ch)
    }
    app.command(d > 0 ? 'ch_plus' : 'ch_minus', { c: ci, d: 1 })
  },

  chPlus(c) {
    this.step(c, 1)
  },

  chMinus(c) {
    this.step(c, -1)
  },

  press(w) {
    this.pressed = w
  },

  release() {
    this.pressed = ''
  },

  toggle() {
    this.pressed = ''
    this.$app.$def.command('train_toggle')
  },

  allPlus() {
    this.mainStep(1)
  },

  allMinus() {
    this.mainStep(-1)
  },

  mainStep(d) {
    if (!this.run) {
      return
    }
    const app = this.$app.$def
    const ms = app.state && app.state.ms != null ? app.state.ms : -1
    const base = this.optMs ? this.optMs.v : ms
    if (base >= 0) {
      this.optMs = { v: Math.max(0, Math.min(100, base + d)), at: Date.now() }
      this.msText = String(this.optMs.v)
    }
    app.command(d > 0 ? 'train_plus' : 'train_minus')
  },

  holdStart() {
    this.holdEnd()
    const t0 = Date.now()
    this.holdTimer = setInterval(() => {
      const p = Math.min(100, Math.round(((Date.now() - t0) / HOLD_MS) * 100))
      this.holdPct = p
      if (p >= 100) {
        clearInterval(this.holdTimer)
        this.holdTimer = null
        this.$app.$def.command('train_stop', null, 'long')
        setTimeout(() => {
          this.holdPct = 0
        }, 400)
      }
    }, 40)
  },

  holdEnd() {
    if (this.holdTimer) {
      clearInterval(this.holdTimer)
      this.holdTimer = null
      this.holdPct = 0
    }
  }
}
</script>

<style>
/* ---- common (scripts/gen-pages.py stamps this into every page) ---- */
.root {
  width: 212px;
  height: 520px;
  background-color: #000000;
}
.screen {
  width: 212px;
  height: 520px;
  flex-direction: column;
  align-items: center;
  padding-top: 46px;
}
.scr {
  width: 212px;
  height: 520px;
}
.col {
  flex-shrink: 0;
  width: 212px;
  flex-direction: column;
}
.in-up {
  animation-name: inUp;
  animation-duration: 260ms;
  animation-timing-function: ease-out;
}
.in-down {
  animation-name: inDown;
  animation-duration: 260ms;
  animation-timing-function: ease-out;
}
.dots {
  width: 16px;
  height: 520px;
  margin-left: 196px;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}
.pdot {
  width: 8px;
  height: 8px;
  margin-top: 4px;
  margin-bottom: 4px;
  border-radius: 4px;
  background-color: #3a3a3c;
}
.pdot-on {
  height: 22px;
  background-color: #ffffff;
}
.caps {
  flex-shrink: 0;
  font-size: 24px;
  font-weight: bold;
  color: #8e8e93;
}
.sub {
  flex-shrink: 0;
  width: 196px;
  text-align: center;
  font-size: 24px;
  color: #aeaeb2;
}
.down {
  transform: scale(0.92);
}
.btn {
  flex-shrink: 0;
  justify-content: center;
  align-items: center;
  transition-property: transform;
  transition-duration: 120ms;
}
.off {
  opacity: 0.3;
}
@keyframes inUp {
  from {
    transform: translateY(90px);
    opacity: 0;
  }
  to {
    transform: translateY(0px);
    opacity: 1;
  }
}
@keyframes inDown {
  from {
    transform: translateY(-90px);
    opacity: 0;
  }
  to {
    transform: translateY(0px);
    opacity: 1;
  }
}
@keyframes breathe {
  from {
    transform: scale(0.86);
    opacity: 0.9;
  }
  to {
    transform: scale(1.12);
    opacity: 0.2;
  }
}
@keyframes beat {
  from {
    transform: scale(1);
  }
  to {
    transform: scale(1.25);
  }
}
/* ---- page ---- */
.col {
  align-items: center;
}
.bg-start {
  flex-shrink: 0;
  background-image: url(/common/bg/start.png);
  background-size: cover;
}
.elapsed {
  flex-shrink: 0;
  margin-top: 4px;
  font-size: 60px;
  font-weight: bold;
  color: #ffffff;
