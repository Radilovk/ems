<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.bhaptics.player">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <application android:label="XEMS bHaptics слушател" android:allowBackup="false" android:usesCleartextTraffic="false">
        <activity android:name="com.xems.bhspy.MainActivity" android:exported="true"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service android:name="com.xems.bhspy.SpyService" android:exported="true">
            <intent-filter>
                <action android:name="com.bhaptics.player.BhapticsHapticService" />
            </intent-filter>
        </service>
    </application>
</manifest>
