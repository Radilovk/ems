    .line 904
    const-string v0, "\u0422\u044a\u043f\u0430, \u0434\u044a\u043b\u0431\u043e\u043a\u0430 \u0431\u043e\u043b\u043a\u0430 \u043d\u0430\u0432\u044a\u0442\u0440\u0435 (\u0432 \u043a\u043e\u0441\u0442\u0442\u0430): \u0441\u043f\u0440\u0438 \u043f\u0440\u043e\u0446\u0435\u0434\u0443\u0440\u0430\u0442\u0430. \u0422\u044f \u0438\u0434\u0432\u0430 \u043e\u0442 \u043e\u0431\u0432\u0438\u0432\u043a\u0430\u0442\u0430 \u043d\u0430 \u043a\u043e\u0441\u0442\u0442\u0430 \u0442\u0430\u043c, \u043a\u044a\u0434\u0435\u0442\u043e \u0442\u044a\u043a\u0430\u043d\u0442\u0430 \u0435 \u0442\u044a\u043d\u043a\u0430 \u2014 \u043d\u0435 \u0435 \u0435\u0444\u0435\u043a\u0442\u044a\u0442, \u043a\u043e\u0439\u0442\u043e \u0442\u044a\u0440\u0441\u0438\u043c.\n\n\u041f\u0440\u043e\u0432\u0435\u0440\u0438: \u0434\u0432\u043e\u0439\u043a\u0430\u0442\u0430 \u0435\u043b\u0435\u043a\u0442\u0440\u043e\u0434\u0438 \u0431\u043b\u0438\u0437\u043e \u0435\u0434\u043d\u0430 \u0434\u043e \u0434\u0440\u0443\u0433\u0430 (\u0435\u0434\u0438\u043d \u043f\u0440\u044a\u0441\u0442 \u043c\u0435\u0436\u0434\u0443 \u0442\u044f\u0445); \u0435\u043b\u0435\u043a\u0442\u0440\u043e\u0434\u0438\u0442\u0435 \u043f\u043b\u044a\u0442\u043d\u043e \u0437\u0430\u043b\u0435\u043f\u0435\u043d\u0438, \u0431\u0435\u0437 \u043e\u0442\u043b\u0435\u043f\u0435\u043d\u0438 \u0440\u044a\u0431\u043e\u0432\u0435; \u043a\u043e\u0436\u0430\u0442\u0430 \u043f\u043e\u0447\u0438\u0441\u0442\u0435\u043d\u0430, \u0431\u0435\u0437 \u043a\u0440\u0435\u043c \u0438 \u0433\u0440\u0438\u043c; \u0435\u043b\u0435\u043a\u0442\u0440\u043e\u0434\u0438\u0442\u0435 \u043d\u0435 \u0441\u0430 \u0438\u0437\u0442\u044a\u0440\u043a\u0430\u043d\u0438.\n\n\u0411\u043e\u0434\u0435\u0436 \u043f\u043e\u0434 \u0440\u044a\u0431\u0430 \u043d\u0430 \u0435\u0434\u0438\u043d \u0435\u043b\u0435\u043a\u0442\u0440\u043e\u0434: \u043a\u043e\u043d\u0442\u0430\u043a\u0442\u044a\u0442 \u2014 \u043f\u0440\u0438\u0442\u0438\u0441\u043d\u0438 \u0438\u043b\u0438 \u0441\u043c\u0435\u043d\u0438 \u0435\u043b\u0435\u043a\u0442\u0440\u043e\u0434\u0430.\n\u0418\u0437\u0442\u0440\u044a\u043f\u0432\u0430\u043d\u0435 \u043a\u044a\u043c \u0443\u0441\u0442\u043d\u0430\u0442\u0430, \u0437\u044a\u0431\u0438\u0442\u0435 \u0438\u043b\u0438 \u0441\u043a\u0430\u043b\u043f\u0430: \u0435\u043b\u0435\u043a\u0442\u0440\u043e\u0434\u044a\u0442 \u0435 \u043d\u0430\u0434 \u043d\u0435\u0440\u0432 \u2014 \u043f\u0440\u0435\u043c\u0435\u0441\u0442\u0438 \u0433\u043e \u043f\u043e \u043a\u0430\u0440\u0442\u0438\u043d\u0430\u0442\u0430.\n\n\u0410\u043a\u043e \u0431\u043e\u043b\u043a\u0430\u0442\u0430 \u043e\u0441\u0442\u0430\u0432\u0430 \u0438 \u043f\u0440\u0438 \u043d\u0430\u0439-\u043d\u0438\u0441\u043a\u0430\u0442\u0430 \u0441\u0438\u043b\u0430, \u0442\u0430\u0437\u0438 \u0437\u043e\u043d\u0430 \u043d\u0435 \u0435 \u0437\u0430 \u043a\u043b\u0438\u0435\u043d\u0442\u0430 \u0434\u043d\u0435\u0441."

