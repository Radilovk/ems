<?xml version="1.0" encoding="UTF-8"?>
<!-- The whole XEMS app (xems27.apk → dex2jar) on Robolectric: scenario tests with time, BLE and voice faked -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>xems</groupId>
  <artifactId>app-sim</artifactId>
  <version>1</version>
  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>
  <repositories>
    <repository><id>google</id><url>https://dl.google.com/dl/android/maven2/</url></repository>
  </repositories>
  <dependencies>
    <dependency><groupId>org.robolectric</groupId><artifactId>robolectric</artifactId><version>4.14.1</version><scope>test</scope></dependency>
    <dependency><groupId>android</groupId><artifactId>android</artifactId><version>30</version><scope>system</scope>
      <systemPath>${project.basedir}/../../android-sdk/platforms/android-30/android.jar</systemPath></dependency>
    <dependency><groupId>xems</groupId><artifactId>overlay</artifactId><version>1</version><scope>system</scope>
      <systemPath>${project.basedir}/out/overlay.jar</systemPath></dependency>
    <dependency><groupId>xems</groupId><artifactId>app</artifactId><version>1</version><scope>system</scope>
      <systemPath>${project.basedir}/out/app.jar</systemPath></dependency>
    <!-- the .aar's classes (Maven puts no .aar on the classpath): run.sh unpacks them -->
    <dependency><groupId>androidx.test</groupId><artifactId>monitor-classes</artifactId><version>1.7.2</version>
      <scope>system</scope><systemPath>${project.basedir}/out/aar/monitor-1.7.2.jar</systemPath></dependency>
    <dependency><groupId>junit</groupId><artifactId>junit</artifactId><version>4.13.2</version><scope>test</scope></dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
        <configuration>
          <systemPropertyVariables>
            <sim.out>${sim.out}</sim.out>
          </systemPropertyVariables>
          <trimStackTrace>false</trimStackTrace>
          <forkCount>3</forkCount>
          <reuseForks>false</reuseForks>
          <argLine>-Xmx6g -XX:+IgnoreUnrecognizedVMOptions -Xverify:none -Dxems.sim=true</argLine>
          <redirectTestOutputToFile>true</redirectTestOutputToFile>
          <includes><include>**/Sim*.java</include></includes>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
