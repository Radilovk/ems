<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Required to call Termux's RunCommandService (runtime permission). Termux must also have
         allow-external-apps=true in ~/.termux/termux.properties. -->
    <uses-permission android:name="com.termux.permission.RUN_COMMAND" />

    <!-- Own Wi-Fi address (ConnectivityManager) and the UDP-socket fallback. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Headset on the tablet's USB-C: adb tcpip 5555 straight from the app (UsbAdb). -->
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />

    <!-- Android 11+ package visibility: resolve the Termux service. -->
    <queries>
        <package android:name="com.termux" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Xems">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="sensorLandscape"
            tools:ignore="DiscouragedApi"
            android:windowSoftInputMode="adjustResize|stateHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/usb_quest" />
        </activity>

        <!-- Termux's result for a background run arrives through our own PendingIntent. -->
        <receiver
            android:name=".PatchResultReceiver"
            android:exported="false" />

    </application>

</manifest>
