<?xml version="1.0" encoding="utf-8"?>
<!-- Landscape: inputs on the left, the one action + its result on the right. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:ignore="NestedWeights"
    android:baselineAligned="false"
    android:orientation="horizontal"
    android:padding="24dp">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/text"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/subtitle"
                android:textColor="@color/muted"
                android:textSize="14sp" />

            <TextView style="@style/Xems.Label" android:text="@string/label_quest_ip" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/input_quest_ip"
                    style="@style/Xems.Field"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:importantForAutofill="no"
                    android:digits="0123456789.:"
                    android:hint="@string/hint_quest_ip"
                    android:imeOptions="actionNext"
                    android:inputType="number|numberDecimal" />

                <ImageButton
                    android:id="@+id/btn_find_quest"
                    style="@style/Xems.IconButton"
                    android:contentDescription="@string/action_find"
                    android:src="@android:drawable/ic_menu_search" />
            </LinearLayout>

            <TextView style="@style/Xems.Help" android:text="@string/help_quest_ip" />

            <TextView style="@style/Xems.Label" android:text="@string/label_package" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/input_package"
                    style="@style/Xems.Field"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:importantForAutofill="no"
                    android:hint="@string/hint_package"
                    android:imeOptions="actionNext"
                    android:inputType="textNoSuggestions|textUri" />

                <ImageButton
                    android:id="@+id/btn_pick_game"
                    style="@style/Xems.IconButton"
                    android:contentDescription="@string/action_games"
                    android:src="@android:drawable/ic_menu_sort_by_size" />
            </LinearLayout>

            <TextView style="@style/Xems.Help" android:text="@string/help_package" />

            <TextView style="@style/Xems.Label" android:text="@string/label_tablet_ip" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/input_tablet_ip"
                    style="@style/Xems.Field"
                    android:importantForAutofill="no"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:digits="0123456789."
                    android:hint="@string/hint_tablet_ip"
                    android:imeOptions="actionDone"
                    android:inputType="number|numberDecimal" />

                <ImageButton
                    android:id="@+id/btn_detect_ip"
                    style="@style/Xems.IconButton"
                    android:contentDescription="@string/detect_ip"
                    android:src="@android:drawable/ic_popup_sync" />
            </LinearLayout>

            <TextView
                android:id="@+id/tablet_ip_note"
                style="@style/Xems.Help" />

            <CheckBox
                android:id="@+id/check_show_termux"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/show_in_termux"
                android:textColor="@color/muted"
                android:textSize="13sp" />

            <!-- Rare: one-time setup and a readiness check. The status card also offers them when needed. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_setup"
                    style="@style/Xems.SmallButton"
                    android:text="@string/action_setup" />

                <Button
                    android:id="@+id/btn_check"
                    style="@style/Xems.SmallButton"
                    android:layout_marginStart="8dp"
                    android:text="@string/action_check" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="20dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <Button
            android:id="@+id/btn_execute"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:background="@drawable/bg_go_button"
            android:stateListAnimator="@null"
            android:text="@string/btn_execute"
            android:textAllCaps="false"
            android:textColor="@color/on_accent"
            android:textSize="22sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:layout_weight="1"
            android:animateLayoutChanges="true"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ProgressBar
                    android:id="@+id/status_progress"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="10dp"
                    android:indeterminateTint="@color/amber"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/status_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/text"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/status_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/muted"
                android:textSize="15sp" />

            <Button
                android:id="@+id/status_action"
                style="@style/Xems.SmallButton"
                android:layout_width="wrap_content"
                android:layout_marginTop="12dp"
                android:minWidth="160dp"
                android:textColor="@color/accent"
                android:visibility="gone" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="12dp"
                android:layout_weight="1">

                <TextView
                    android:id="@+id/status_log"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_log"
                    android:fontFamily="monospace"
                    android:padding="12dp"
                    android:textColor="@color/muted"
                    android:textIsSelectable="true"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </ScrollView>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
